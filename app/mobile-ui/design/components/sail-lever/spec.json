{
  "tag": "c-sail-lever",
  "props": {
    "mode": {"type": "enum", "options": ["steps", "continuous"], "default": "steps"},
    "value": {"type": "int"},
    "height": {"type": "int", "default": @{size.leverHeight}},
    "active": {"type": "bool", "default": false},
    "dir": {"type": "enum", "options": ["", "up", "down"], "default": ""},
    "label": {"type": "text", "default": ""},
    "floating": {"type": "bool", "default": false},
    "fixed": {"type": "bool", "default": false},
    "mirrored": {"type": "bool", "default": false, "class": false},
    "restInset": {"type": "int", "default": 0},
    "atX": {"type": "number", "default": 0},
    "atY": {"type": "number", "default": 0}
  },
  "behaviors": ["lever"],
  "constants": {
    "width": @{size.leverWidth},
    "height": @{size.leverHeight},
    "minHeight": 112,
    "markHide": 75,
    "knob": @{size.leverKnob},
    "steps": [{"icon": "sail-furled"}, {"icon": "sail-half"}, {"icon": "sail-full"}]
  }
}
