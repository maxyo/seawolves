<c-panel tone="parchment" aged="1" seed="{{seed}}" gap="{{ or(gap, spec.gap[mode == 'speech' ? 'speech' : 'replies']) }}">
<div class="dp-head"><div class="dp-speaker">{{speaker}}</div><div class="dp-flourish"></div></div>
<div class="dp-body"><ui-pages class="dp-text{{ next ? ' with-next' : '' }}" text="{{text}}" page="{{page}}" mode="{{mode}}"/><div class="dp-replies" data-reserve="1"><t-for each="replies" as="r"><div class="dp-cell{{ len(replies) == 1 ? ' whole' : r_i % 2 ? ' right' : ' left' }}"><c-list-row id="{{ or(r.id, key + '-reply-' + r_i) }}" surface="parchment" lines="{{spec.replyLines}}" icon="{{opt(r.icon)}}" title="{{r.title}}" tip="{{r.title}}" hold="1" meta="{{opt(r.meta)}}" meta-tone="{{opt(r.metaTone)}}" pressed="{{ r.pressed ? 1 : 0 }}"/></div></t-for></div><t-if test="next"><div class="dp-next"><c-button id="{{key}}-next" class="dp-next-button" variant="ghost" surface="parchment" label="{{ tr('dialogue.next') + ' ›' }}"/></div></t-if></div>
</c-panel>
