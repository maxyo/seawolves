/* C-Setting: one settings row. The whole row is the touch target. */
c-setting { display: block; width: 100%; color: @{color.text}; }
c-setting.disabled { opacity: 0.5; }
c-setting .set-row { display: block; box-sizing: border-box; width: 100%; min-height: @{spec.minHeight}dp; padding: 6dp 0; }
c-setting.line .set-row { border-bottom: 1dp @{color.brassLine/.14}; }
c-setting.pressed .set-row, c-setting .set-row.pressed { background-color: @{color.brassGlow/.16}; shadow: @{color.brassLine/.3} 0 0 0 1dp inset; }
c-setting.disabled .set-row.pressed { background-color: transparent; shadow: none; }

c-setting .set-label { flex: 0 1 auto; min-width: 0; font-size: @{spec.labelFont}dp; }
c-setting .set-hint { font-size: @{spec.hintFont}dp; color: @{color.textMuted}; }
c-setting .set-hint.under { margin-top: 2dp; }
c-setting .set-grow { flex: 1 1 0; }

/* slider row */
c-setting .set-head { width: 100%; display: flex; flex-direction: row; align-items: center; gap: 6dp; font-size: @{spec.labelFont}dp; }
c-setting .set-display { flex: 0 0 auto; margin-left: 6dp; white-space: nowrap; color: @{color.textSelected}; }
c-setting .set-ctl { width: 100%; margin-top: 6dp; display: flex; flex-direction: row; align-items: center; gap: 8dp; }
c-setting .set-step { flex: 0 0 auto; width: @{spec.stepButton}dp; height: @{spec.stepButton}dp; margin: -8dp 0; text-align: center; font-size: 26dp; line-height: @{spec.stepButton}dp;
    color: @{color.brass}; font-effect: shadow(0dp 1dp @{color.black}); border-radius: 22dp; }
c-setting .set-step.pressed { color: @{color.textSelected}; decorator: radial-gradient(circle farthest-corner at center, @{color.brass/.26}, @{color.brass/0} 70%); }
c-setting .set-slide { position: relative; flex: 1 1 0; height: @{spec.thumb}dp; }
c-setting .set-hit { position: absolute; left: 0; right: 0; top: -32dp; bottom: -8dp; }
c-setting .set-track { position: absolute; left: 0; right: 0; top: 12dp; height: 4dp; background-color: @{color.black/.5}; }
c-setting .set-fill { position: absolute; left: 0; top: 12dp; height: 4dp; background-color: @{color.brassLine}; }
c-setting .set-at { position: absolute; top: 0; width: 0; height: 0; }
c-setting .set-thumb { position: absolute; left: -14dp; top: 0; box-sizing: border-box; width: @{spec.thumb}dp; height: @{spec.thumb}dp; border-radius: 14dp; border: 1dp @{color.brassRim};
    decorator: radial-gradient(circle farthest-corner at 40% 35%, @{color.brassTop}, @{color.brassLow}); shadow: @{color.black/.6} 0 1dp 3dp 0; }

/* inline row: [check / radio] label + hint [toggle | segment | children]
   Label / control split: the label keeps at least labelMin dp; a control that does not fit
   beside it moves under it, right-aligned (wrap), instead of squeezing the label into a
   column of words. */
c-setting .set-main { width: 100%; min-height: 40dp; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 12dp; row-gap: 6dp; }
c-setting.control-segment.stack .set-main { min-height: 0; }
c-setting .set-texts { flex: 1 1 @{spec.labelMin}dp; min-width: 0; display: flex; flex-direction: column; }
c-setting .set-title { display: flex; flex-direction: row; align-items: center; gap: 6dp; }
c-setting .set-slot { flex: 0 0 auto; margin-left: auto; display: flex; flex-direction: row; align-items: center; gap: 8dp; }

c-setting .set-toggle { position: relative; flex: 0 0 auto; margin-left: auto; box-sizing: border-box; width: @{spec.toggleWidth}dp; height: @{spec.toggleHeight}dp; border-radius: 15dp;
    border: 1dp @{color.toggleTrackOffEdge}; background-color: @{color.black/.45}; }
c-setting .set-toggle.on { background-color: @{color.brassGlow/.6}; }
c-setting .set-knob { position: absolute; top: 2dp; left: 2dp; width: 24dp; height: 24dp; border-radius: 12dp; background-color: @{color.toggleKnobOff}; shadow: @{color.black/.5} 0 1dp 2dp 0; }
c-setting .set-toggle.on .set-knob { left: 24dp; background-color: @{color.brassTop}; }

c-setting .set-box { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; justify-content: center; box-sizing: border-box; width: @{spec.box}dp; height: @{spec.box}dp; border: 1dp @{color.brassLine}; }
c-setting.control-radio .set-box { border-radius: 12dp; }
c-setting.control-check .set-box.on { background-color: @{color.brassLine}; }
c-setting.control-check .set-mark { width: 11dp; height: 5dp; border-left: 2dp @{color.onBrass}; border-bottom: 2dp @{color.onBrass}; transform: rotate(-45deg) translate(1dp, -1dp); }
c-setting.control-radio .set-mark { width: 12dp; height: 12dp; border-radius: 6dp; background-color: @{color.brass}; }

/* a segment wrapped under its label may be narrower than its cells want: they shrink, their names wrap to two lines and step down (ui-clamp min-size) instead of spilling out of the column */
c-setting .set-segment { flex: 0 1 auto; min-width: 0; max-width: 100%; margin-left: auto; display: flex; flex-direction: row; box-sizing: border-box; border: 1dp @{color.brassLine/.45}; }
c-setting .set-segment.wide { width: 100%; margin-top: 6dp; }
c-setting .set-cell { flex: 0 1 auto; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; height: @{spec.segmentHeight}dp; min-width: @{spec.segmentMinWidth}dp;
    padding: 0 12dp; text-align: center; font-size: @{spec.labelFont}dp; color: @{color.textSecond}; }
c-setting .set-cell-label { line-height: 1.12; }
c-setting .set-cell.next { border-left: 1dp @{color.brassLine/.45}; }
/* A full-width segment shares its width: cells shrink below their minimum rather than spill
   out of the column; their names wrap and step down. */
c-setting.stretch .set-cell, c-setting .set-segment.wide .set-cell { flex: 1 1 0; min-width: 0; padding: 0 4dp; overflow: hidden; }
c-setting.stretch .set-segment { flex: 1 1 0; }
c-setting .set-cell.selected { background-color: @{color.brassGlow/.28}; color: @{color.textSelected}; shadow: @{color.brass} 0 -2dp 0 0 inset; }
c-setting .set-cell.pressed { background-color: @{color.brassGlow/.16}; color: @{color.text}; }
/* one option unavailable (its own reason on a tap): dimmed like a disabled row */
c-setting .set-cell.off { color: @{color.glyphDisabled}; }

/* control "button": the row's own action (its label names what, `display` the verb), a quiet brass-lined button */
c-setting .set-button { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    min-width: 112dp; height: @{spec.segmentHeight}dp; padding: 0 16dp; border: 1dp @{color.brassLine/.7}; border-radius: 3dp;
    color: @{color.brass}; font-size: @{spec.labelFont}dp; }
c-setting .set-button.pressed { background-color: @{color.brassGlow/.16}; }
/* press and hold to confirm (for destructive actions) */
c-setting .set-button { position: relative; }
/* hold to confirm, as c-button: a fill sweeps across the button; released early it shakes (no caption) */
c-setting .set-button-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: @{color.flash/.4}; pointer-events: none; }
c-setting .set-button.done { background-color: @{color.holdDone}; }
/* released before the fill reached the end: nothing happens, the button shakes (the runtime's class "shake") */
c-setting .set-button.shake { animation: 0.36s cubic-in-out 2 ui-refused; border-color: @{color.dangerLine}; } /* as c-button.shake */
/* the restart mark: long press says what it means */
c-setting .set-restart { display: flex; align-items: center; justify-content: center; width: 28dp; height: 28dp; }
/* four or more options in a row: one smaller label size for all of them, so no cell shrinks alone */
c-setting .set-segment.many .set-cell-label { font-size: @{type.caption}dp; }
