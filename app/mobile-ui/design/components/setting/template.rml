<t-if test="control == 'slider'">
<div class="set-row">
<div class="set-head"><div class="set-label">{{label}}</div><t-if test="restart"><div class="set-restart" data-action="" data-tip="{{ tr('settings.restart_needed') }}"><c-icon icon="reload" size="20" tone="brass"/></div></t-if><div class="set-grow"></div><div class="set-display">{{ or(display, clamp(value, 0, 100) + '%') }}</div></div>
<t-if test="hint"><div class="set-hint under">{{hint}}</div></t-if>
<div class="set-ctl">
<t-if test="steps"><div class="set-step" data-action="change" data-step="-{{spec.sliderStep}}" data-disabled?="{{ disabled }}" data-reason="{{reason}}">−</div></t-if>
<div class="set-slide" data-range="value"><div class="set-hit"></div><div class="set-track"></div><div class="set-fill" style="width: {{ clamp(value, 0, 100) }}%;"></div><div class="set-at" data-range-knob="" style="left: {{ clamp(value, 0, 100) }}%;"><div class="set-thumb"></div></div></div>
<t-if test="steps"><div class="set-step" data-action="change" data-step="{{spec.sliderStep}}" data-disabled?="{{ disabled }}" data-reason="{{reason}}">+</div></t-if>
</div>
</div>
<t-else/>
<div class="set-row" data-action?="{{ in(control, 'toggle', 'check') || control == 'radio' ? 'change' : '' }}" data-toggle?="{{ in(control, 'toggle', 'check') ? 'on' : '' }}" data-set?="{{ !in(control, 'toggle', 'check') && control == 'radio' }}" data-prop?="{{ !in(control, 'toggle', 'check') && control == 'radio' ? 'on' : '' }}" data-disabled?="{{ disabled }}" data-reason="{{reason}}">
<div class="set-main">
<t-if test="in(control, 'check', 'radio')"><div class="set-box{{ on ? ' on' : '' }}"><t-if test="on"><div class="set-mark"></div></t-if></div></t-if>
<t-if test="label || hint || restart"><div class="set-texts"><div class="set-title"><div class="set-label">{{label}}</div><t-if test="restart"><div class="set-restart" data-action="" data-tip="{{ tr('settings.restart_needed') }}"><c-icon icon="reload" size="20" tone="brass"/></div></t-if></div><t-if test="hint"><div class="set-hint">{{hint}}</div></t-if></div></t-if>
<t-if test="control == 'toggle'"><div class="set-toggle{{ on ? ' on' : '' }}"><div class="set-knob"></div></div></t-if>
<t-if test="control == 'button' && display"><div class="set-button" data-action="click" data-hold="" data-disabled?="{{ disabled }}" data-reason="{{reason}}"><div class="set-button-fill" data-hold-fill="1"></div><div class="set-button-label">{{display}}</div></div></t-if>
<t-if test="control == 'segment' && !stack"><div class="set-segment{{ len(options) >= 4 ? ' many' : '' }}"><t-for each="options" as="o"><div class="set-cell{{ o_i == selected ? ' selected' : '' }}{{ o_i ? ' next' : '' }}{{ is_object(o) && opt(o.disabled) ? ' off' : '' }}" data-action="change" data-set="{{o_i}}" data-prop="selected" data-disabled?="{{ (disabled || (is_object(o) && opt(o.disabled))) }}" data-reason="{{ is_object(o) && opt(o.reason) ? o.reason : reason }}"><ui-clamp class="set-cell-label" lines="2" min-size="@{type.min}" text="{{ is_object(o) ? (opt(o.key) ? tr(o.key) : o.label) : o }}"/></div></t-for></div></t-if>
<t-if test="children"><div class="set-slot" slot="1"></div></t-if>
</div>
<t-if test="control == 'segment' && stack"><div class="set-segment wide{{ len(options) >= 4 ? ' many' : '' }}"><t-for each="options" as="o"><div class="set-cell{{ o_i == selected ? ' selected' : '' }}{{ o_i ? ' next' : '' }}{{ is_object(o) && opt(o.disabled) ? ' off' : '' }}" data-action="change" data-set="{{o_i}}" data-prop="selected" data-disabled?="{{ (disabled || (is_object(o) && opt(o.disabled))) }}" data-reason="{{ is_object(o) && opt(o.reason) ? o.reason : reason }}"><ui-clamp class="set-cell-label" lines="2" min-size="@{type.min}" text="{{ is_object(o) ? (opt(o.key) ? tr(o.key) : o.label) : o }}"/></div></t-for></div></t-if>
</div>
</t-if>
