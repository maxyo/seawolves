/* C-HeroCard: identity rail of the hero section (wood panel, 156 dp): portrait, name, rank,
   health and energy bars, free points, state lines; the children sit at the bottom. */
c-hero-card {
    position: relative; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden;
    width: 100%; height: 100%; gap: @{space.sm}dp; padding: 8dp 2dp 12dp 2dp;
    color: @{color.text}; background-color: @{color.wood};
    box-shadow: @{color.black/.45} 0 0 0 1dp inset, @{color.woodLight/.04} 0 1dp 0 0;
}
c-hero-card > .hc-pic { display: flex; flex-direction: row; justify-content: center; }
c-hero-card > .hc-body { display: flex; flex-direction: column; gap: @{space.sm}dp; padding: 0 8dp; }
c-hero-card > .hc-body > .hc-names { text-align: center; line-height: 1.25; }
c-hero-card > .hc-body > .hc-names > .hc-title { font-size: @{type.name}dp; font-weight: bold; }
c-hero-card > .hc-body > .hc-names > .hc-sub { font-size: @{type.caption}dp; color: @{color.textSecond}; }
c-hero-card > .hc-body > .hc-lines { font-size: @{type.caption}dp; line-height: 1.45; color: @{color.textSecond}; }
c-hero-card > .hc-body > .hc-lines > .hc-line > .hc-v { color: @{color.text}; }
c-hero-card > .hc-body > .hc-lines > .hc-line > .hc-v.tone-ok { color: @{color.ok}; }
c-hero-card > .hc-body > .hc-lines > .hc-line > .hc-v.tone-danger { color: @{color.danger}; }
c-hero-card > .hc-body > .hc-lines > .hc-line > .hc-v.tone-gold { color: @{color.brass}; }
c-hero-card > .hc-fill { flex: 1 1 0; }
c-hero-card > .hc-slot { flex: 0 0 auto; display: flex; flex-direction: column; gap: @{space.sm}dp; padding: 0 8dp; }
