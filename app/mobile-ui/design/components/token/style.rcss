/* C-Token: flat enamel, brass bezel. Only for "portrait" objects (hero, ship, nation, item). */
c-token { display: inline-block; flex: 0 0 auto; line-height: 0; vertical-align: middle; }
c-token .tk-face { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1.5dp @{color.bezel}; background-color: @{color.enamelTeal}; }
c-token .tk-face.enamel-red { background-color: @{color.enamelRed}; }
c-token .tk-face.enamel-iron { background-color: @{color.enamelIron}; }
c-token .tk-face.enamel-parchment { background-color: @{color.enamelParchment}; }
c-token.disabled { filter: grayscale(0.7) brightness(0.75); }
c-token.selected .tk-face { shadow: @{color.wood} 0 0 0 3dp, @{color.brass} 0 0 0 5dp; }
c-token.current .tk-face { shadow: @{color.wood} 0 0 0 3dp, @{color.brassLine/.55} 0 0 0 4dp; }
c-token.selected.current .tk-face { shadow: @{color.wood} 0 0 0 3dp, @{color.brass} 0 0 0 5dp; }
