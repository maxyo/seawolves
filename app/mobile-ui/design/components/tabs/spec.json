{
  "tag": "c-tabs",
  "props": {
    "look": {"type": "enum", "options": ["bar", "segment", "rail", "icons"], "default": "bar"},
    "compact": {"type": "bool", "default": false},
    "stretch": {"type": "bool", "default": false},
    "surface": {"type": "enum", "options": ["wood", "parchment"], "default": "wood"},
    "items": {"type": "json", "default": []}
  },
  "classes": {
    "single": "len(items) < 2"
  },
  "behaviors": ["press"],
  "constants": {
    "pressRoot": false,
    "height": {"bar": @{size.tabBar}, "segment": @{size.touchMin}, "rail": @{size.touch}, "icons": @{size.touch}},
    "iconsWidth": @{size.tabIcons},
    "compactWidth": 128,
    "icon": {"text": 20, "icons": 24},
    "font": {"label": @{type.body}, "count": @{type.caption}},
    "badge": 18
  }
}
