{
  "tag": "c-tabs",
  "props": {
    "look": {"type": "enum", "options": ["bar", "segment", "rail"], "default": "bar"},
    "compact": {"type": "bool", "default": false},
    "stretch": {"type": "bool", "default": false},
    "surface": {"type": "enum", "options": ["wood", "parchment"], "default": "wood"},
    "items": {"type": "json", "default": [], "shape": [{"id": "text", "label": "text", "selected": "bool", "badge": "text", "disabled": "bool", "reason": "text"}]}
  },
  "classes": {
    "single": "len(items) < 2"
  },
  "behaviors": ["press"],
  "constants": {
    "pressRoot": false,
    "height": {"bar": @{size.tabBar}, "segment": @{size.touchMin}, "rail": @{size.touch}},
    "compactWidth": 128,
    "font": {"label": @{type.body}, "count": @{type.caption}},
    "badge": 18
  }
}
