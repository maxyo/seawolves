<t-if test="len(items) > 1"><t-for each="items" as="t"><div class="tabs-tab{{ t.selected ? ' sel' : '' }}{{ opt(t.disabled) ? ' off' : '' }}{{ t_i ? '' : ' first' }}" data-action="select" data-select="items" data-index="{{t_i}}" data-value="{{ or(t.id, t_i) }}" data-reason="{{opt(t.reason)}}" data-disabled?="{{ opt(t.disabled) }}"><t-if test="look == 'segment'"><div class="tabs-hit"></div></t-if><div class="tabs-label"><span class="tabs-lt">{{t.label}}</span></div><t-if test="opt(t.badge)"><div class="tabs-badge">{{opt(t.badge)}}</div></t-if></div></t-for></t-if>
