<t-if test="len(items) > 1"><t-for each="items" as="t"><t-if test="opt(t.divider)"><div class="tabs-divider"></div><t-else/><div class="tabs-tab{{ t.selected ? ' sel' : '' }}{{ opt(t.disabled) ? ' off' : '' }}{{ t_i ? '' : ' first' }}" data-action="select" data-select="items" data-index="{{t_i}}" data-value="{{ or(t.id, t_i) }}" data-reason="{{opt(t.reason)}}"{{{ opt(t.disabled) ? ' data-disabled="1"' : '' }}}><t-if test="look == 'segment'"><div class="tabs-hit"></div></t-if><t-if test="opt(t.icon)"><div class="tabs-ico"><c-icon icon="{{opt(t.icon)}}" size="{{ look == 'icons' ? spec.icon.icons : spec.icon.text }}" tone="{{ surface == 'parchment' ? 'ink' : t.selected ? 'duo' : 'brass' }}"/><t-if test="opt(t.badge) && look == 'icons'"><div class="tabs-badge abs">{{opt(t.badge)}}</div></t-if></div></t-if><t-if test="look != 'icons'"><div class="tabs-label"><span class="tabs-lt">{{t.label}}</span></div><t-if test="opt(t.count) && opt(t.count) != 0"><div class="tabs-count">{{opt(t.count)}}</div></t-if><t-if test="opt(t.badge)"><div class="tabs-badge">{{opt(t.badge)}}</div></t-if></t-if></div></t-if></t-for></t-if>
