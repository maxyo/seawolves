<div class="face"><t-if test="look == 'ribbon'"><div class="tail"></div><div class="stitch left"></div><div class="stitch right"></div></t-if><div class="glyph"><c-icon icon="{{icon}}" size="{{ or(spec.glyph[look], spec.glyph.bare) }}" tone="{{ surface == 'parchment' && in(look, 'bare', 'engraved') ? (danger ? 'wax' : pressed && !disabled ? 'inkDeep' : 'ink') : danger ? 'danger' : disabled ? 'dim' : look == 'ribbon' ? 'gold' : 'brass' }}"/></div></div>
