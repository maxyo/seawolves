{
  "tag": "c-compass",
  "props": {
    "date": {"type": "text", "default": ""},
    "time": {"type": "text", "default": ""},
    "course": {"type": "number", "default": 0},
    "windFrom": {"type": "number", "default": 0},
    "wind": {"type": "number", "default": 0},
    "sky": {"type": "enum", "options": ["none", "sun", "moon"], "default": "none"},
    "skyAt": {"type": "number", "default": 0},
    "moon": {"type": "int", "default": 4},
    "weather": {"type": "enum", "options": ["none", "storm", "tornado"], "default": "none"},
    "days": {"type": "text", "default": ""},
