<t-if test="kind == 'emblem'"><div class="gi-box" style="width: {{ size ? size : spec.size.emblem }}dp; height: {{ round((size ? size : spec.size.emblem) * spec.emblemAspect) }}dp;"><div class="gi-cloth"></div><div class="gi-hem"></div><div class="gi-sil"><div class="gi-mark" style="left: {{ (size ? size : spec.size.emblem) * 0.3125 }}dp; top: {{ (size ? size : spec.size.emblem) * 0.33 }}dp; width: {{ (size ? size : spec.size.emblem) * 0.375 }}dp; height: {{ (size ? size : spec.size.emblem) * 0.375 }}dp;"></div><div class="gi-dot" style="left: {{ (size ? size : spec.size.emblem) * 0.4219 }}dp; top: {{ (size ? size : spec.size.emblem) * 0.4395 }}dp; width: {{ (size ? size : spec.size.emblem) * 0.1562 }}dp; height: {{ (size ? size : spec.size.emblem) * 0.1562 }}dp; border-radius: {{ (size ? size : spec.size.emblem) * 0.0781 }}dp;"></div></div><ui-game-image texture="{{texture}}" cell="{{cell}}" uv="{{uv}}"/></div><t-else/><div class="gi-box" style="width: {{ size ? size : spec.size[kind] }}dp; height: {{ size ? size : spec.size[kind] }}dp;{{ round && kind != 'emblem' ? ' border-radius: ' + (size ? size : spec.size[kind]) / 2 + 'dp;' : '' }}"><div class="gi-hatch"></div><t-if test="kind == 'item'"><div class="gi-inline"></div><div class="gi-sil item"><c-icon icon="{{icon}}" size="{{ round((size ? size : spec.size.item) * spec.iconRatio) }}" tone="ink"/></div><t-else/><div class="gi-sil"><div class="gi-head" style="left: {{ (size ? size : spec.size.portrait) * 0.3281 }}dp; top: {{ (size ? size : spec.size.portrait) * 0.2188 }}dp; width: {{ (size ? size : spec.size.portrait) * 0.3438 }}dp; height: {{ (size ? size : spec.size.portrait) * 0.3438 }}dp; border-radius: {{ (size ? size : spec.size.portrait) * 0.1719 }}dp;"></div><div class="gi-bust" style="left: {{ (size ? size : spec.size.portrait) * 0.1562 }}dp; top: {{ (size ? size : spec.size.portrait) * 0.6094 }}dp; width: {{ (size ? size : spec.size.portrait) * 0.6875 }}dp; height: {{ (size ? size : spec.size.portrait) * 0.3906 }}dp; border-top-left-radius: {{ (size ? size : spec.size.portrait) * 0.3438 }}dp; border-top-right-radius: {{ (size ? size : spec.size.portrait) * 0.3438 }}dp;"></div></div></t-if><ui-game-image texture="{{texture}}" cell="{{cell}}" uv="{{uv}}"/></div></t-if>
