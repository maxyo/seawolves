<div class="frame" style="margin: {{safe.top}}dp 0 {{safe.bottom}}dp 0;">
<t-if test="header"><c-header style="padding-left: {{ safe.left + (!close && back ? spec.headerPadBack : spec.headerPadLeft) }}dp; padding-right: {{ safe.right + (close ? spec.headerPadClose : spec.headerPadRight) }}dp;" key="{{key}}" title="{{ or(title, tr('common.screen')) }}" subtitle="{{subtitle}}" show-subtitle="{{ showSubtitle ? 1 : 0 }}" back="{{ back ? 1 : 0 }}" close="{{ close ? 1 : 0 }}" back-disabled="{{ backDisabled ? 1 : 0 }}" script="{{ script ? 1 : 0 }}" sections="{{sections}}" subject="{{ json(subject) }}" tabs="{{ sections != '' && len(tabs) > 1 ? '[]' : json(tabs) }}" stats="{{ json(stats) }}" actions="{{ json(actions) }}"/></t-if>
<t-if test="sections != '' && len(tabs) > 1"><div class="tabs-row" style="padding-left: {{ safe.left + spec.padSide }}dp; padding-right: {{ safe.right + spec.padSide }}dp;"><div class="tabs-strip"><c-tabs id="{{key}}-tabs" look="bar" items="{{ json(tabs) }}"/></div><div class="main" slot="1"></div></div><t-else/><div class="main" slot="1" style="{{ layout == 'free' ? '' : 'padding-left: ' + (safe.left + spec.padSide) + 'dp; padding-right: ' + (safe.right + spec.padSide) + 'dp;' }}"></div></t-if>
</div>
<t-if test="subject && opt(subject.open)"><c-dialog id="{{key}}-subjects" key="{{key}}-subjects" variant="center" tone="parchment" width="{{spec.subjectsWidth}}" title="{{subject.title}}" closable="1"><div class="subjects"><t-for each="subject.rows" as="r"><c-list-row id="{{key}}-subject-{{r_i}}" image="{{ json(r.image) }}" icon="{{r.icon}}" title="{{r.label}}" meta="{{r.meta}}" selected="{{ r.selected ? 1 : 0 }}" surface="parchment" style="width: 100%"/></t-for></div></c-dialog></t-if>
