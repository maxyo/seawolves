<t-if test="!close && back"><c-icon-button id="{{key}}-back" icon="back" label="{{ tr('common.back') }}" look="ribbon" disabled="{{ backDisabled ? 1 : 0 }}"/></t-if>
<div class="titles{{ len(tabs) == 0 && !sections ? ' grow' : '' }}"><ui-clamp class="title{{ script ? ' script' : '' }}" lines="2" min-size="{{ script ? spec.font.scriptMin : @{type.min} }}" text="{{title}}"/><t-if test="subtitle && showSubtitle"><div class="subtitle">{{subtitle}}</div></t-if></div>
<t-if test="sections"><div class="sections"><t-for each="spec.sections" as="x"><div class="section{{ x.key == sections ? ' selected' : '' }}" data-action="section" data-value="{{x.key}}" data-label="{{ tr(x.labelKey) }}"><c-icon icon="{{x.icon}}" size="24" tone="{{ x.key == sections ? 'duo' : 'brass' }}"/></div></t-for></div></t-if>
<t-if test="len(tabs) > 0"><div class="tabs"><t-for each="tabs" as="t"><div class="tab{{ t.selected ? ' selected' : '' }}{{ opt(t.disabled) ? ' disabled' : '' }}" data-action="tab" data-select="tabs" data-index="{{t_i}}" data-disabled?="{{ opt(t.disabled) }}" data-reason="{{opt(t.reason)}}"><div class="tab-label">{{t.label}}</div><t-if test="str(opt(t.count)) != ''"><div class="count">{{opt(t.count)}}</div></t-if><t-if test="str(opt(t.badge)) != '' && opt(t.badge) != false"><div class="badge">{{opt(t.badge)}}</div></t-if></div></t-for></div></t-if>
<t-if test="len(tabs) > 0 || sections"><div class="spacer"></div></t-if>
<t-if test="children"><div class="slot" slot="1"></div></t-if>
<t-if test="subject"><div class="subject"><t-if test="subject.prev != false || subject.next != false"><div class="arrow{{ subject.prev == false ? ' off' : '' }}" data-action="subject-prev" data-disabled?="{{ subject.prev == false }}"><c-icon icon="chevron-left" size="22" tone="brass"/></div></t-if><div class="who" data-action="subject-list" data-disabled?="{{ subject.list == false }}"><div class="who-text{{ subject.sub ? ' with-sub' : '' }}"><ui-clamp class="who-label" lines="2" natural="1" min-size="@{type.min}" text="{{subject.label}}"/><t-if test="subject.sub"><div class="who-sub">{{subject.sub}}</div></t-if></div><t-if test="subject.list != false"><c-icon class="who-more" icon="chevron-down" size="18" tone="brass"/></t-if></div><t-if test="subject.prev != false || subject.next != false"><div class="arrow{{ subject.next == false ? ' off' : '' }}" data-action="subject-next" data-disabled?="{{ subject.next == false }}"><c-icon icon="chevron-right" size="22" tone="brass"/></div></t-if></div></t-if>
<t-for each="stats" as="s"><div rmlui-layout-boundary="" class="stat{{ opt(s.label) ? '' : ' big' }}"><t-if test="opt(s.label)"><div class="stat-label">{{opt(s.label)}}</div></t-if><div class="stat-row"><t-if test="opt(s.icon)"><c-icon icon="{{opt(s.icon)}}" size="20" tone="brass"/></t-if><div class="stat-value{{ opt(s.tone) ? ' tone-' + opt(s.tone) : '' }}">{{s.value}}</div><t-if test="str(opt(s.preview)) != ''"><div class="stat-preview pv-{{ opt(s.previewTone) ? opt(s.previewTone) : (opt(s.preview) * 1 == s.value * 1 ? 'neutral' : (opt(s.preview) * 1 > s.value * 1 ? 'ok' : 'danger')) }}"><c-icon class="stat-arrow" icon="back" size="12" tone="brass"/><div rmlui-layout-boundary="">{{opt(s.preview)}}</div></div></t-if></div></div></t-for>
<t-for each="actions" as="a"><c-icon-button id="{{ or(a.id, key + '-action-' + a_i) }}" icon="{{a.icon}}" label="{{a.label}}" look="engraved"/></t-for>
<t-if test="close"><c-icon-button id="{{key}}-close" icon="close" label="{{ tr('common.close') }}" look="engraved"/></t-if>
