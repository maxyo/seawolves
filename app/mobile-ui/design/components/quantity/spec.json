{
  "tag": "c-quantity",
  "props": {
    "value": {"type": "int", "default": 0},
    "min": {"type": "int", "default": 0},
    "max": {"type": "int", "default": 100},
    "unit": {"type": "text", "default": ""},
    "label": {"type": "text", "default": ""},
    "zones": {"type": "bool", "default": false, "class": false},
    "origin": {"type": "int", "default": 0},
    "lessLabel": {"type": "text", "default": ""},
    "moreLabel": {"type": "text", "default": ""},
    "summary": {"type": "text", "default": ""},
    "width": {"type": "int", "default": 0},
    "surface": {"type": "enum", "options": ["wood", "parchment", "glass"], "default": "wood"},
    "all": {"type": "bool", "default": false, "class": false},
    "allLabel": {"type": "text", "default": "", "defaultKey": "common.all"},
    "steps": {"type": "json", "default": [1, 10, 100]},
    "dense": {"type": "bool", "default": false, "class": false},
    "stack": {"type": "bool", "default": false, "class": false},
    "pressed": {"type": "enum", "options": ["", "-100", "-10", "-1", "+1", "+10", "+100"], "default": "", "class": false},
    "active": {"type": "bool", "default": false, "class": false},
    "disabled": {"type": "bool", "default": false},
    "reason": {"type": "text", "default": ""},
    "floor": {"type": "json", "default": null, "doc": "the lowest value the amount may take inside min…max (what is already done, e.g. a hull at 50 % of 0…100): a mark on the rail; the knob and the steps stop there"},
    "ceiling": {"type": "json", "default": null, "doc": "the highest value the amount may take inside min…max (what the purse or the materials allow): the rail past it is dimmed and marked; the knob, the steps and «Все» stop there, a push past it says moreReason"},
    "marks": {"type": "json", "default": [], "doc": "[{at, label}]: thresholds on the scale (the least crew each ship sails with): a notch under the track at `at`, its short label below"},
    "moreReason": {"type": "text", "default": "", "doc": "why the amount cannot go further up (no money, no room): a tap on a «+» step or the right «Все» at the limit says it"}
  },
  "classes": {
    "stack": "stack || (width > 0 && width < spec.stackBelow)",
    "dense": "dense || stack || (width > 0 && width < spec.stackBelow)",
    "active": "active && !disabled",
    "signed": "min < 0 && max > 0 && !zones",
    "zoned": "zones && origin >= min && origin <= max(min + 1, max)"
  },
  "behaviors": ["press", "range"],
  "constants": {
    "layoutBoundary": true,
    "pressRoot": false,
    "height": @{size.quantityStep},
    "step": @{size.quantityStep},
    "stepDense": @{size.quantityStep},
    "knob": 20,
    "knobActive": 24,
    "stackBelow": 400,
    "numberFont": @{type.name},
    "digit": 10,
    "captionSlot": 72,
    "captionFont": @{type.caption},
    "glyphFont": @{type.name},
    "glyphFontDense": @{type.body},
    "allFont": @{type.body}
  }
}
