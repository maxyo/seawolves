<div class="wrap" data-live-shape="(clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? 'L' : '') + (value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? 'H' : '') + (clamp(value, min, max(min + 1, max)) == origin ? 'O' : '')"<t-if test="width > 0"> style="width: {{width}}dp;"</t-if>>
<t-if test="all && zones && origin >= min && origin <= max(min + 1, max) && origin > min"><div class="all less{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' dim' : '' }}" data-action="change" data-set="{{ max(min, or(floor, min)) }}"{{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : '' }}">{{ or(allLabel, tr('common.all')) }}</div></t-if>
<div class="grp minus{{ zones && origin >= min && origin <= max(min + 1, max) ? ' less' : '' }}">
<t-if test="len(steps) > 2"><div class="step{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' dim' : pressed == '-' + steps[2] ? ' pressed' : '' }}" data-action="change" data-step="-{{steps[2]}}"{{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : '' }}">−−−</div></t-if>
<t-if test="len(steps) > 1"><div class="step{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' dim' : pressed == '-' + steps[1] ? ' pressed' : '' }}" data-action="change" data-step="-{{steps[1]}}"{{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : '' }}">−−</div></t-if>
<div class="step{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' dim' : pressed == '-' + steps[0] ? ' pressed' : '' }}" data-action="change" data-step="-{{steps[0]}}"{{{ disabled || clamp(value, min, max(min + 1, max)) <= max(min, or(floor, min)) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : '' }}">−</div>
</div>
<div class="mid">
<div class="drag" data-range="value" data-inset="{{ stack || (width > 0 && width < spec.stackBelow) ? 12 : 10 }}"><div class="rail">
<div class="track"></div>
<t-if test="zones && origin >= min && origin <= max(min + 1, max)"><div class="zone less" style="left: 0%; width: {{ (origin - min) / (max(min + 1, max) - min) * 100 }}%;"></div><div class="zone more" style="left: {{ (origin - min) / (max(min + 1, max) - min) * 100 }}%; width: {{ 100 - (origin - min) / (max(min + 1, max) - min) * 100 }}%;"></div></t-if>
<t-if test="zones && origin >= min && origin <= max(min + 1, max)"><div data-live-class="more: clamp(value, min, max(min + 1, max)) >= origin; less: clamp(value, min, max(min + 1, max)) < origin" data-live-style="'left: ' + min((origin - min) / (max(min + 1, max) - min) * 100, (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100) + '%; width: ' + abs((clamp(value, min, max(min + 1, max)) - origin) / (max(min + 1, max) - min) * 100) + '%;'" class="fill zoned{{ clamp(value, min, max(min + 1, max)) >= origin ? ' more' : ' less' }}" style="left: {{ min((origin - min) / (max(min + 1, max) - min) * 100, (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100) }}%; width: {{ abs((clamp(value, min, max(min + 1, max)) - origin) / (max(min + 1, max) - min) * 100) }}%;"></div><div class="zero" style="left: {{ (origin - min) / (max(min + 1, max) - min) * 100 }}%;"></div><t-else/><div data-live-class="pos: value >= 0" data-live-style="'left: ' + min(min < 0 && max > 0 ? (0 - min) / (max(min + 1, max) - min) * 100 : 0, (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100) + '%; width: ' + abs((clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100 - (min < 0 && max > 0 ? (0 - min) / (max(min + 1, max) - min) * 100 : 0)) + '%;'" class="fill{{ value >= 0 ? ' pos' : '' }}" style="left: {{ min(min < 0 && max > 0 ? (0 - min) / (max(min + 1, max) - min) * 100 : 0, (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100) }}%; width: {{ abs((clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100 - (min < 0 && max > 0 ? (0 - min) / (max(min + 1, max) - min) * 100 : 0)) }}%;"></div></t-if>
<t-if test="min < 0 && max > 0"><div class="zero" style="left: {{ (0 - min) / (max(min + 1, max) - min) * 100 }}%;"></div></t-if>
<t-if test="floor != null && floor > min"><div class="bound" style="left: {{ (floor - min) / (max(min + 1, max) - min) * 100 }}%;"></div></t-if><t-if test="ceiling != null && ceiling < max(min + 1, max)"><div class="beyond" style="left: {{ (ceiling - min) / (max(min + 1, max) - min) * 100 }}%; right: 0;"></div><div class="bound limit" style="left: {{ (ceiling - min) / (max(min + 1, max) - min) * 100 }}%;"></div></t-if>
<t-for each="marks" as="m"><t-if test="m.at >= min && m.at <= max(min + 1, max)"><div class="mark" style="left: {{ (m.at - min) / (max(min + 1, max) - min) * 100 }}%;"><div class="mark-notch"></div><div class="mark-label">{{m.label}}</div></div></t-if></t-for>
<div class="at" data-range-knob="" data-live-style="'left: ' + (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100 + '%;'" style="left: {{ (clamp(value, min, max(min + 1, max)) - min) / (max(min + 1, max) - min) * 100 }}%;"><div class="knob"></div></div>
</div></div>
<div class="line">
<t-if test="zones && origin >= min && origin <= max(min + 1, max) && clamp(value, min, max(min + 1, max)) != origin"><div data-live-class="more: clamp(value, min, max(min + 1, max)) > origin; less: clamp(value, min, max(min + 1, max)) <= origin" data-live-text="clamp(value, min, max(min + 1, max)) > origin ? moreLabel : lessLabel" class="cap op{{ clamp(value, min, max(min + 1, max)) > origin ? ' more' : ' less' }}">{{ clamp(value, min, max(min + 1, max)) > origin ? moreLabel : lessLabel }}</div><div data-live-class="more: clamp(value, min, max(min + 1, max)) > origin; less: clamp(value, min, max(min + 1, max)) <= origin" data-live-text="num(abs(clamp(value, min, max(min + 1, max)) - origin))" class="num slot{{ clamp(value, min, max(min + 1, max)) > origin ? ' more' : ' less' }}" style="min-width: {{ len(num(max(min + 1, max))) * spec.digit }}dp;">{{ num(abs(clamp(value, min, max(min + 1, max)) - origin)) }}</div><t-else/><t-if test="label"><div class="cap">{{label}}</div></t-if>
<div data-live-class="pos: min < 0 && max > 0 && clamp(value, min, max) > 0; neg: min < 0 && max > 0 && clamp(value, min, max) < 0" data-live-text="(clamp(value, min, max(min + 1, max)) < 0 ? '−' : min < 0 && max > 0 && value > 0 ? '+' : '') + num(abs(clamp(value, min, max(min + 1, max))))" class="num{{ zones ? ' slot' : '' }}{{ min < 0 && max > 0 ? (clamp(value, min, max) > 0 ? ' pos' : clamp(value, min, max) < 0 ? ' neg' : '') : '' }}"{{{ zones ? ' style="min-width: ' + len(num(max(min + 1, max))) * spec.digit + 'dp;"' : '' }}}>{{ (clamp(value, min, max(min + 1, max)) < 0 ? '−' : min < 0 && max > 0 && value > 0 ? '+' : '') + num(abs(clamp(value, min, max(min + 1, max)))) }}</div>
</t-if>
<t-if test="unit"><div class="cap unit">{{unit}}</div></t-if>
<div class="gap"></div>
<t-if test="summary != '-'"><ui-clamp class="cap sum" lines="1" min-size="@{type.min}" text="{{ summary ? summary : tr('common.of') + ' ' + num(max) }}"/></t-if>
</div>
</div>
<t-if test="all && (stack || (width > 0 && width < spec.stackBelow))"><div class="all{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' dim' : '' }}" data-action="change" data-set="{{ min(max(min + 1, max), or(ceiling, max(min + 1, max))) }}"{{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : moreReason }}">{{ or(allLabel, tr('common.all')) }}</div></t-if>
<div class="grp plus{{ zones && origin >= min && origin <= max(min + 1, max) ? ' more' : '' }}">
<div class="step{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' dim' : pressed == '+' + steps[0] ? ' pressed' : '' }}" data-action="change" data-step="{{steps[0]}}"{{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : moreReason }}">+</div>
<t-if test="len(steps) > 1"><div class="step{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' dim' : pressed == '+' + steps[1] ? ' pressed' : '' }}" data-action="change" data-step="{{steps[1]}}"{{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : moreReason }}">++</div></t-if>
<t-if test="len(steps) > 2"><div class="step{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' dim' : pressed == '+' + steps[2] ? ' pressed' : '' }}" data-action="change" data-step="{{steps[2]}}"{{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : moreReason }}">+++</div></t-if>
</div>
<t-if test="all && !(stack || (width > 0 && width < spec.stackBelow))"><div class="all{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' dim' : '' }}" data-action="change" data-set="{{ min(max(min + 1, max), or(ceiling, max(min + 1, max))) }}"{{{ disabled || value >= min(max(min + 1, max), or(ceiling, max(min + 1, max))) ? ' data-disabled="1"' : '' }}} data-reason="{{ disabled ? reason : moreReason }}">{{ or(allLabel, tr('common.all')) }}</div></t-if>
</div>
