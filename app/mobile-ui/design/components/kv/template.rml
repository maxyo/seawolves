<t-for each="items" as="i"><div class="pair{{ cols == 2 ? (i_i % 2 == 0 ? ' left' : ' right') : '' }}"><div class="k">{{i.k}}</div><div class="v{{ opt(i.tone) ? ' tone-' + opt(i.tone) : '' }}">{{i.v}}<t-if test="opt(i.d)"><span class="d{{ opt(i.dTone) ? ' tone-' + i.dTone : '' }}"> {{opt(i.d)}}</span></t-if></div></div></t-for>
