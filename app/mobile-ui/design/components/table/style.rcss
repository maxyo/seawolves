/* C-Table: list / table. Columns are flex cells ("1fr" grows, "72px" is fixed, "auto" takes its content's width).
   Rows are the pressable parts; the ‹ › arrows are their own targets. */
c-table { display: flex; flex-direction: column; box-sizing: border-box; width: 100%; height: 100%; min-height: 0; color: @{color.text}; font-size: @{spec.font.cell}dp; }

c-table .tb-path { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; min-height: @{spec.pathMin}dp; padding: 0 @{spec.padH}dp;
    font-size: @{spec.font.sub}dp; color: @{color.textSecond}; border-bottom: 1dp @{color.brassLine/.35}; }
c-table .tb-head { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; gap: @{spec.gap}dp; min-height: @{spec.headMin}dp;
    padding: 4dp @{spec.padH}dp; font-size: @{spec.font.head}dp; color: @{color.textMuted}; border-bottom: 1dp @{color.brassLine/.35}; }
c-table .tb-hc { box-sizing: border-box; white-space: pre-line; line-height: 1.15; overflow: hidden; text-align: left; }
c-table .tb-hc.al-right { text-align: right; }
c-table .tb-hc.al-center { text-align: center; }
c-table.caps .tb-hc { text-transform: uppercase; letter-spacing: 0.03em; }

c-table .tb-wrap { position: relative; flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; }
c-table .tb-body { position: relative; flex: 1 1 0; min-height: 0; overflow-x: hidden; overflow-y: auto; }

c-table .tb-row { position: relative; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; gap: @{spec.gap}dp; padding: 0 @{spec.padH}dp;
    min-height: @{spec.rowMin}dp; border-bottom: 1dp @{color.brassLine/.14}; }
c-table .tb-row.last { border-bottom-width: 0; }
c-table .tb-row.dis { background-color: @{color.black/.22}; }
c-table .tb-row.pressed { background-color: @{color.brassGlow/.3}; }
c-table .tb-row.sel { border-bottom-width: 1dp; background-color: @{color.wood}; decorator: linear-gradient(@{color.brassGlow/.18}, @{color.brassGlow/.18}); shadow: @{color.brass} 3dp 0 0 0 inset; }

c-table .tb-cell { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; box-sizing: border-box; gap: 10dp; min-width: 0; }
c-table .tb-cell.al-right { justify-content: flex-end; text-align: right; }
c-table .tb-cell.al-center { justify-content: center; }
c-table .tb-lead { position: relative; display: flex; flex: 0 0 auto; }
c-table .tb-badge { position: absolute; right: -6dp; bottom: -5dp; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    width: 18dp; height: 18dp; border-radius: 9dp; border: 1dp @{color.ringEnd/.8}; background-color: @{color.badgeCheck}; }
c-table .tb-badge.b-lock { background-color: @{color.badgeLock}; }
c-table .tb-badge.b-bolt { background-color: @{color.badgeBolt}; }
c-table .tb-badge.b-seal { background-color: @{color.badgeSeal}; }

c-table .tb-cbody { display: flex; flex-direction: column; flex: 0 1 auto; min-width: 0; overflow: hidden; line-height: 1.2; }
c-table .tb-cbody.grow { flex: 1 1 0; }
c-table .tb-t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: @{color.text}; }
c-table .tb-t.bold { font-weight: bold; }
/* a clamped cell wraps and steps down by itself (ui-clamp min-size): no nowrap ellipsis on it */
c-table .tb-t.tb-clamp { white-space: normal; text-overflow: clip; }
c-table .tb-delta { font-weight: bold; }
c-table .tb-sub { font-size: @{spec.font.sub}dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: @{color.textMuted}; }
c-table .tb-sub.reason { font-style: italic; color: @{color.textReason}; }
c-table .tb-t.tone-gold, c-table .tb-delta.tone-gold { color: @{color.brass}; }
c-table .tb-t.tone-dim, c-table .tb-delta.tone-dim, c-table .tb-t.tone-muted, c-table .tb-delta.tone-muted { color: @{color.textMuted}; }
c-table .tb-t.tone-danger, c-table .tb-delta.tone-danger { color: @{color.danger}; }
c-table .tb-t.tone-ok, c-table .tb-delta.tone-ok { color: @{color.ok}; }
c-table .tb-t.tone-hi, c-table .tb-delta.tone-hi { color: @{color.textSelected}; }

c-table .tb-arrows { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; gap: 4dp; }
c-table .tb-arrow { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: @{spec.arrow}dp; height: @{spec.arrow}dp; }
c-table .tb-arrow.off { opacity: 0.5; }
c-table .tb-arrow.pressed { background-color: @{color.brassGlow/.3}; }
c-table .tb-aval { min-width: 40dp; text-align: center; overflow: visible; }

c-table .tb-tag { flex: 0 0 auto; box-sizing: border-box; padding: 1dp 6dp; font-size: @{spec.font.tag}dp; line-height: 1.3; white-space: nowrap;
    color: @{color.brass}; border: 1dp @{color.brassLine/.5}; background-color: @{color.black/.25}; }
c-table .tb-tag.tag-export, c-table .tb-tag.tag-fit { color: @{color.ok}; border-color: @{color.okDeep/.6}; }
c-table .tb-tag.tag-fit { background-color: transparent; }
c-table .tb-tag.tag-import { color: @{color.tagImport}; border-color: @{color.skyDeep/.6}; }
c-table .tb-tag.tag-contraband { color: @{color.danger}; border-color: @{color.dangerFill/.7}; }
c-table .tb-tag.tag-contract, c-table .tb-tag.tag-demand { color: @{color.brass}; border-color: @{color.brass/.6}; }
c-table .tb-tag.tag-custom.tone-gold { color: @{color.brass}; }
c-table .tb-tag.tag-custom.tone-dim, c-table .tb-tag.tag-custom.tone-muted { color: @{color.textMuted}; }
c-table .tb-tag.tag-custom.tone-danger { color: @{color.danger}; }
c-table .tb-tag.tag-custom.tone-ok { color: @{color.ok}; }
c-table .tb-tag.tag-custom.tone-hi { color: @{color.textSelected}; }


c-table .tb-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; gap: 10dp; height: 100%; min-height: 120dp; padding: 16dp;
    text-align: center; color: @{color.textSecond}; }

/* scroll affordances */
c-table .tb-fade { position: absolute; left: 0; right: 0; bottom: 0; height: @{spec.fade.plain}dp; display: flex; flex-direction: row; align-items: flex-end; justify-content: center; box-sizing: border-box;
    padding-bottom: 2dp; pointer-events: none; z-index: 2; decorator: linear-gradient(@{color.wood/0}, @{color.wood/.95}); }
c-table .tb-fade.more { height: @{spec.fade.more}dp; }
c-table .tb-more-label { padding: 2dp 10dp; font-size: @{spec.font.sub}dp; border-radius: 10dp; color: @{color.text}; background-color: @{color.toastPill/.922}; }
c-table .tb-track { position: absolute; right: 1dp; top: 2dp; bottom: 2dp; width: 3dp; background-color: @{color.brassLine/.14}; pointer-events: none; }
c-table .tb-thumb { width: 100%; background-color: @{color.brass/.75}; }

c-table .tb-primary { flex: 0 0 auto; box-sizing: border-box; padding: 8dp 12dp; border-top: 1dp @{color.brassLine/.35}; background-color: @{color.black/.18}; }

/* parchment: ink text, sepia rules */
c-table.surface-parchment { color: @{color.ink}; }
c-table.surface-parchment .tb-path { color: @{color.inkMuted}; border-bottom-color: @{color.inkMuted/.5}; }
c-table.surface-parchment .tb-head { color: @{color.inkMuted}; border-bottom-color: @{color.inkMuted/.5}; }
c-table.surface-parchment .tb-row { border-bottom-color: @{color.inkMuted/.3}; }
c-table.surface-parchment .tb-row.dis { background-color: @{color.inkMuted/.06}; }
c-table.surface-parchment .tb-row.pressed { background-color: @{color.inkMuted/.2}; }
c-table.surface-parchment .tb-row.sel { background-color: transparent; decorator: linear-gradient(@{color.paperShade/.16}, @{color.paperShade/.16}); shadow: @{color.inkRule} 3dp 0 0 0 inset; }
c-table.surface-parchment .tb-t { color: @{color.ink}; }
c-table.surface-parchment .tb-sub { color: @{color.inkMuted}; }
c-table.surface-parchment .tb-sub.reason { color: @{color.inkMuted}; }
c-table.surface-parchment .tb-t.tone-gold, c-table.surface-parchment .tb-delta.tone-gold { color: @{color.inkLink}; }
c-table.surface-parchment .tb-t.tone-dim, c-table.surface-parchment .tb-delta.tone-dim, c-table.surface-parchment .tb-t.tone-muted, c-table.surface-parchment .tb-delta.tone-muted { color: @{color.inkMuted}; }
c-table.surface-parchment .tb-t.tone-danger, c-table.surface-parchment .tb-delta.tone-danger { color: @{color.wax}; }
c-table.surface-parchment .tb-t.tone-ok, c-table.surface-parchment .tb-delta.tone-ok { color: @{color.leaf}; }
c-table.surface-parchment .tb-t.tone-hi, c-table.surface-parchment .tb-delta.tone-hi { color: @{color.ink}; }
c-table.surface-parchment .tb-arrow.pressed { background-color: @{color.inkMuted/.2}; }
c-table.surface-parchment .tb-tag { color: @{color.ink}; border-color: @{color.inkMuted/.55}; background-color: @{color.paperLight/.45}; border-radius: 2dp; }
c-table.surface-parchment .tb-tag.tag-export, c-table.surface-parchment .tb-tag.tag-fit { color: @{color.leaf}; border-color: @{color.leaf/.65}; }
c-table.surface-parchment .tb-tag.tag-import { color: @{color.tagImportInk}; border-color: @{color.tagImportInk/.6}; }
c-table.surface-parchment .tb-tag.tag-contraband { color: @{color.wax}; border-color: @{color.wax/.65}; }
c-table.surface-parchment .tb-tag.tag-contract, c-table.surface-parchment .tb-tag.tag-demand { color: @{color.inkMuted}; border-color: @{color.inkMuted/.6}; }
c-table.surface-parchment .tb-tag.tag-custom.tone-gold { color: @{color.inkLink}; }
c-table.surface-parchment .tb-tag.tag-custom.tone-dim, c-table.surface-parchment .tb-tag.tag-custom.tone-muted { color: @{color.inkMuted}; }
c-table.surface-parchment .tb-tag.tag-custom.tone-danger { color: @{color.wax}; }
c-table.surface-parchment .tb-tag.tag-custom.tone-ok { color: @{color.leaf}; }
c-table.surface-parchment .tb-tag.tag-custom.tone-hi { color: @{color.ink}; }
c-table.surface-parchment .tb-empty { color: @{color.inkMuted}; }
c-table.surface-parchment .tb-fade { decorator: linear-gradient(@{color.paperBottom/0}, @{color.paperBottom/.95}); }
c-table.surface-parchment .tb-more-label { color: @{color.ink}; background-color: @{color.paperBottom/.95}; }
c-table.surface-parchment .tb-primary { border-top-color: @{color.inkMuted/.5}; background-color: @{color.inkMuted/.08}; }

/* arrows: Noto Serif has no U+2192 / U+2193, so the arrow is drawn (shaft + head) */
c-table .tb-arr { display: inline-block; position: relative; width: 13dp; height: 9dp; margin: 0 5dp 0 5dp; }
c-table .tb-arr.down { transform: rotate(90deg); margin: 0 0 0 5dp; }
c-table .tb-arr .tb-sh { display: block; position: absolute; left: 0; top: 3.75dp; width: 12dp; height: 1.5dp; background-color: @{color.text}; }
c-table .tb-arr .tb-hd { display: block; position: absolute; left: 5.5dp; top: 1.5dp; box-sizing: border-box; width: 6dp; height: 6dp; border-top: 1.5dp @{color.text}; border-right: 1.5dp @{color.text}; transform: rotate(45deg); }
c-table .tb-delta.tone-gold .tb-arr .tb-sh { background-color: @{color.brass}; }
c-table .tb-delta.tone-gold .tb-arr .tb-hd { border-color: @{color.brass}; }
c-table .tb-delta.tone-dim .tb-arr .tb-sh { background-color: @{color.textMuted}; }
c-table .tb-delta.tone-dim .tb-arr .tb-hd { border-color: @{color.textMuted}; }
c-table .tb-delta.tone-muted .tb-arr .tb-sh { background-color: @{color.textMuted}; }
c-table .tb-delta.tone-muted .tb-arr .tb-hd { border-color: @{color.textMuted}; }
c-table .tb-delta.tone-danger .tb-arr .tb-sh { background-color: @{color.danger}; }
c-table .tb-delta.tone-danger .tb-arr .tb-hd { border-color: @{color.danger}; }
c-table .tb-delta.tone-ok .tb-arr .tb-sh { background-color: @{color.ok}; }
c-table .tb-delta.tone-ok .tb-arr .tb-hd { border-color: @{color.ok}; }
c-table .tb-delta.tone-hi .tb-arr .tb-sh { background-color: @{color.textSelected}; }
c-table .tb-delta.tone-hi .tb-arr .tb-hd { border-color: @{color.textSelected}; }
c-table.surface-parchment .tb-arr .tb-sh { background-color: @{color.ink}; }
c-table.surface-parchment .tb-arr .tb-hd { border-color: @{color.ink}; }
c-table.surface-parchment .tb-delta.tone-gold .tb-arr .tb-sh { background-color: @{color.inkLink}; }
c-table.surface-parchment .tb-delta.tone-gold .tb-arr .tb-hd { border-color: @{color.inkLink}; }
c-table.surface-parchment .tb-delta.tone-dim .tb-arr .tb-sh { background-color: @{color.inkMuted}; }
c-table.surface-parchment .tb-delta.tone-dim .tb-arr .tb-hd { border-color: @{color.inkMuted}; }
c-table.surface-parchment .tb-delta.tone-muted .tb-arr .tb-sh { background-color: @{color.inkMuted}; }
c-table.surface-parchment .tb-delta.tone-muted .tb-arr .tb-hd { border-color: @{color.inkMuted}; }
c-table.surface-parchment .tb-delta.tone-danger .tb-arr .tb-sh { background-color: @{color.wax}; }
c-table.surface-parchment .tb-delta.tone-danger .tb-arr .tb-hd { border-color: @{color.wax}; }
c-table.surface-parchment .tb-delta.tone-ok .tb-arr .tb-sh { background-color: @{color.leaf}; }
c-table.surface-parchment .tb-delta.tone-ok .tb-arr .tb-hd { border-color: @{color.leaf}; }
c-table.surface-parchment .tb-delta.tone-hi .tb-arr .tb-sh { background-color: @{color.ink}; }
c-table.surface-parchment .tb-delta.tone-hi .tb-arr .tb-hd { border-color: @{color.ink}; }
c-table .tb-t.tb-clamp { white-space: normal; line-height: 1.3; }
