<t-if test="preset == 'picker' && path"><div class="tb-path"><div class="tb-path-text">{{path}}</div></div></t-if>
<t-if test="head"><div class="tb-head"><t-for each="columns" as="h"><div class="tb-hc al-{{ or(h.align, 'left') }}" style="{{ h.w == 'auto' ? 'flex: 0 0 auto;' : str(int(h.w)) + 'px' == str(h.w) ? 'flex: 0 0 auto; width: ' + int(h.w) + 'dp;' : 'flex: ' + max(1, int(h.w)) + ' 1 0; min-width: 0;' }}">{{h.label}}</div></t-for></div></t-if>
<div class="tb-wrap"><div class="tb-body">
<t-if test="len(rows) == 0 && empty"><div class="tb-empty"><c-icon icon="{{emptyIcon}}" size="{{spec.icon.empty}}" tone="{{ surface == 'parchment' ? 'ink' : 'brass' }}"/><div>{{empty}}</div></div></t-if>
<t-for each="rows" as="r"><div class="tb-row{{ opt(r.selected) && interactive ? ' sel' : '' }}{{ opt(r.disabled) ? ' dis' : '' }}{{ r_last ? ' last' : '' }}" style="min-height: {{ interactive ? max(spec.rowMin, rowHeight) : rowHeight ? rowHeight : spec.rowRead }}dp;"{{{ interactive ? ' data-action="row"' + (selectable ? ' data-select="rows"' : '') + ' data-index="' + r_i + '" data-value="' + r_i + '"' : '' }}}{{{ interactive && opt(r.disabled) ? ' data-disabled="1"' : '' }}} data-reason="{{opt(r.reason)}}"><t-for each="r.cells" as="c"><div class="tb-cell al-{{ or(columns[c_i].align, 'left') }}" style="{{ columns[c_i].w == 'auto' ? 'flex: 0 0 auto;' : str(int(columns[c_i].w)) + 'px' == str(columns[c_i].w) ? 'flex: 0 0 auto; width: ' + int(columns[c_i].w) + 'dp;' : 'flex: ' + max(1, int(columns[c_i].w)) + ' 1 0; min-width: 0;' }}">
<t-if test="opt(c.flag) || image_kind(opt(c.image), opt(c.icon))"><div class="tb-lead"><t-if test="opt(c.flag)"><c-icon icon="nation-{{opt(c.flag)}}" size="{{ or(c.iconSize, spec.icon.only) }}" tone="color"/><t-else/><c-row-image image="{{ json(opt(c.image)) }}" icon="{{opt(c.icon)}}" size="{{ image_kind(opt(c.image), opt(c.icon)) == 'token' ? or(c.tokenSize, min(spec.tokenMax, (interactive ? max(spec.rowMin, rowHeight) : rowHeight ? rowHeight : spec.rowRead) - 8)) : or(c.imageSize, spec.image) }}" icon-size="{{ or(c.iconSize, opt(c.iconOnly) ? spec.icon.only : spec.icon.cell) }}" tone="{{ or(c.iconTone, opt(r.disabled) ? 'dim' : surface == 'parchment' ? 'ink' : 'duo') }}" label="{{opt(c.text)}}" surface="{{surface}}" disabled="{{ opt(r.disabled) ? 1 : 0 }}"/></t-if><t-if test="opt(c.badge) && (opt(c.flag) || image_kind(opt(c.image), opt(c.icon)))"><div class="tb-badge b-{{opt(c.badge)}}"><c-icon icon="{{ pick(c.badge, 'lock', 'lock', 'bolt', 'energy', 'seal', 'scroll', 'check') }}" size="{{spec.icon.badge}}" tone="{{ pick(c.badge, 'lock', 'paper', 'bolt', 'gold', 'seal', 'danger', 'green') }}"/></div></t-if></div></t-if>
<t-if test="opt(c.arrows)"><div class="tb-arrows"><div class="tb-arrow{{ c.noLeft ? ' off' : '' }}" data-action="dec" data-value="{{r_i}}"{{{ c.noLeft ? ' data-disabled="1"' : '' }}}><c-icon icon="chevron-left" size="{{spec.icon.arrow}}" tone="{{ c.noLeft ? 'dim' : surface == 'parchment' ? 'ink' : 'brass' }}"/></div><div class="tb-aval tb-t {{ opt(c.tone) ? 'tone-' + opt(c.tone) : opt(r.disabled) ? 'tone-dim' : opt(r.selected) && interactive && c_i == 0 ? 'tone-hi' : '' }}{{ opt(c.bold) ? ' bold' : '' }}">{{opt(c.text)}}</div><div class="tb-arrow{{ opt(c.noRight) ? ' off' : '' }}" data-action="inc" data-value="{{r_i}}"{{{ opt(c.noRight) ? ' data-disabled="1"' : '' }}}><c-icon icon="chevron-right" size="{{spec.icon.arrow}}" tone="{{ opt(c.noRight) ? 'dim' : surface == 'parchment' ? 'ink' : 'brass' }}"/></div></div><t-else/><t-if test="!(opt(c.flag) || opt(c.iconOnly))"><div class="tb-cbody{{ opt(c.tag) || opt(c.lines) > 0 || (c_i == 0 && opt(r.fit)) ? ' grow' : '' }}"><t-if test="opt(c.lines) > 0"><ui-clamp min-size="@{type.min}" class="tb-t tb-clamp{{ opt(c.tone) ? ' tone-' + opt(c.tone) : opt(r.disabled) ? ' tone-dim' : '' }}{{ opt(c.bold) ? ' bold' : '' }}" lines="{{opt(c.lines)}}" text="{{opt(c.text)}}"/><t-else/><t-if test="has(c, 'bar')"><c-bar value="{{c.bar}}" kind="{{ or(c.barKind, 'xp') }}" label="" text="{{opt(c.text)}}" style="width: 100%"/><t-else/><div class="tb-t {{ opt(c.tone) ? 'tone-' + opt(c.tone) : opt(r.disabled) || (zeroDash && !opt(c.delta) && (is_object(c) ? opt(c.text) : c) == '0') ? 'tone-dim' : opt(r.selected) && interactive && c_i == 0 ? 'tone-hi' : '' }}{{ opt(c.bold) ? ' bold' : '' }}">{{ zeroDash && !opt(c.delta) && (is_object(c) ? opt(c.text) : c) == '0' ? '—' : opt(c.delta) && has(opt(c.delta), 'from') ? opt(c.delta.from) : is_object(c) ? opt(c.text) : c }}<t-if test="opt(c.delta)"><span class="tb-delta tone-{{ opt(c.delta.tone) ? opt(c.delta.tone) : (opt(c.delta.to) - (has(opt(c.delta), 'from') ? opt(c.delta.from) : opt(c.text))) > 0 ? 'ok' : (opt(c.delta.to) - (has(opt(c.delta), 'from') ? opt(c.delta.from) : opt(c.text))) < 0 ? 'danger' : 'hi' }}"><span class="tb-arr"><span class="tb-sh"></span><span class="tb-hd"></span></span>{{opt(c.delta.to)}}</span></t-if></div></t-if></t-if><t-if test="c_i == 0 && opt(r.disabled) && opt(r.reason) && (showReason || opt(r.showReason))"><div class="tb-sub reason">{{opt(r.reason)}}</div><t-else/><t-if test="opt(c.sub)"><div class="tb-sub">{{opt(c.sub)}}</div></t-if></t-if></div></t-if></t-if>
<t-if test="opt(c.tag)"><div class="tb-tag {{ is_object(opt(c.tag)) ? 'tag-custom tone-' + opt(c.tag.tone) : 'tag-' + opt(c.tag) }}">{{ is_object(opt(c.tag)) ? opt(c.tag.text) : pick(opt(c.tag), 'export', tr('trade.export'), 'import', tr('trade.import'), 'contraband', tr('trade.contraband_goods'), 'contract', tr('table.contract'), 'demand', tr('trade.demand'), opt(c.tag)) }}</div></t-if>
<t-if test="c_i == 0 && opt(r.fit)"><div class="tb-tag tag-fit">{{ tr('table.fit') }}</div></t-if>
</div></t-for></div></t-for>
</div><t-if test="fade || more > 0"><div class="tb-fade{{ more > 0 ? ' more' : '' }}"><t-if test="more > 0"><div class="tb-more-label">{{ tr('table.more') }} {{more}}<span class="tb-arr down"><span class="tb-sh"></span><span class="tb-hd"></span></span></div></t-if></div></t-if><t-if test="more > 0"><div class="tb-track"><div class="tb-thumb" style="height: {{ max(12, round(100 * max(1, len(rows)) / (max(1, len(rows)) + more))) }}%;"></div></div></t-if></div>
<t-if test="preset == 'picker' && primary"><div class="tb-primary"><c-button variant="primary" label="{{primary.label}}" sub="{{opt(primary.sub)}}" disabled="{{ primary.disabled ? 1 : 0 }}" reason="{{opt(primary.reason)}}" style="width: 100%"/></div></t-if>
