<div class="mm-line top"><t-if test="place"><ui-clamp class="mm-place" lines="1" natural="1" min-size="@{type.min}" text="{{place}}"/></t-if><t-if test="readout && speed"><div class="mm-speed" aria-label="{{ tr('spy.speed') + ': ' + speed + ' ' + tr('common.knots_short') }}"><t-if test="place"><div aria-hidden="true"> · </div></t-if><div class="mm-speed-icon" aria-hidden="true"><c-icon icon="speed" size="16" tone="paper"/></div><div class="mm-speed-value">{{speed}}</div></div></t-if></div>
<div class="mm-disc" data-action="zoom"><t-if test="!native"><div class="mm-own" style="transform: rotate({{ or(heading, 0) }}deg);"></div><t-for each="markers" as="m"><div class="mm-dot tone-{{ in(m.tone, 'enemy', 'ally') ? m.tone : 'neutral' }}" style="left: {{ m.x - spec.dot / 2 }}dp; top: {{ m.y - spec.dot / 2 }}dp;"></div></t-for></t-if></div>
<t-if test="readout && date"><div class="mm-line bottom">{{date}}</div></t-if>
