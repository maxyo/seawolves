<div class="ntc-outer"<t-if test="place == 'hud'"> style="top: {{ or(offset, spec.offsetHud) }}dp; left: {{ or(safeLeft, or(spec.safe[scene], spec.safe.land)[0]) }}dp; right: {{ or(safeRight, or(spec.safe[scene], spec.safe.land)[1]) }}dp;"</t-if>>
<t-if test="variant == 'log'">
<t-for each="lines" as="l"><t-if test="l_i < spec.maxLogLines || l.leaving"><div class="ntc-pill line tone-{{ or(l.tone, 'info') }}{{ l.leaving ? ' leaving' : '' }}{{ l.open ? ' opens' : '' }}" data-key="{{ or(l.key, l_i) }}" data-toast="{{ or(l.key, l_i) }}"<t-if test="l.open"> data-open="1"</t-if> style="opacity: {{ l.leaving ? 0 : 1 - l_i * 0.18 }};"><c-icon icon="{{ or(l.icon, pick(l.tone, 'warn', 'warning', 'danger', 'warning', 'ok', 'check', 'info')) }}" size="16" tone="{{ pick(l.tone, 'warn', 'brass', 'danger', 'danger', 'ok', 'green', 'duo') }}"/><div class="ntc-text"><ui-clamp lines="{{ place == 'hud' ? 2 : 1 }}" natural="1" min-size="@{type.min}" text="{{ is_object(l) ? l.text : l }}"/></div><t-if test="l.open"><div class="ntc-open">›</div></t-if></div></t-if></t-for>
<t-else/>
<div class="{{ in(variant, 'toast', 'hint') || place == 'hud' ? 'ntc-pill' : 'ntc-body' }}"<t-if test="variant == 'toast'"> data-toast="toast"</t-if>>
<c-icon icon="{{ or(icon, pick(tone, 'warn', 'warning', 'danger', 'warning', 'ok', 'check', 'info')) }}" size="{{ variant == 'inline' || compact || place == 'hud' ? 16 : 20 }}" tone="{{ surface == 'parchment' && in(variant, 'box', 'inline') && place != 'hud' ? pick(tone, 'danger', 'wax', 'ok', 'leaf', 'ink') : pick(tone, 'warn', 'brass', 'danger', 'danger', 'ok', 'green', 'duo') }}"/>
<div class="ntc-text"><t-if test="lead"><b>{{lead}} </b></t-if>{{text}}</div>
<t-if test="action && !in(variant, 'toast', 'hint') && place != 'hud'"><c-button class="ntc-action" label="{{action}}" variant="secondary" size="sm" surface="{{ surface == 'parchment' && in(variant, 'box', 'inline') ? 'parchment' : 'wood' }}"/></t-if>
<t-if test="children"><div class="ntc-slot" slot="1"></div></t-if>
</div>
</t-if>
</div>
