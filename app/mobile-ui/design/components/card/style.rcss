/* C-Card: a flat inner card of a panel, one step lighter, no frame. Size it from the
   document (width / height on the tag). */
c-card {
    position: relative; display: flex; flex-direction: column; box-sizing: border-box;
    color: @{color.text}; background-color: @{color.woodLight/.05};
}
c-card > .inner { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }

c-card.tone-plain { background-color: transparent; }
c-card.tone-danger { background-color: @{color.wax/.22}; shadow: @{color.wax} 3dp 0 0 0 inset; }
c-card.surface-parchment { color: @{color.ink}; background-color: @{color.inkMuted/.10}; }
c-card.surface-parchment.tone-plain { background-color: transparent; }
/* a small document lying on wood */
c-card.tone-parchment {
    color: @{color.ink}; background-color: transparent;
    decorator: radial-gradient(ellipse farthest-corner at 20% 10%, @{color.paperLight/.4}, @{color.paperLight/0} 60%), linear-gradient(@{color.paperTop}, @{color.paperBottom});
    shadow: @{color.paperShade/.28} 0 0 14dp 0 inset;
}

c-card.disabled { color: @{color.textMuted}; background-color: @{color.black/.28}; decorator: none; }
c-card.paper.disabled { color: @{color.inkDisabled}; background-color: @{color.inkMuted/.06}; }

c-card.selected { background-color: @{color.brassGlow/.16}; decorator: none; shadow: @{color.brass} @{spec.selectedBar}dp 0 0 0 inset; }
c-card.paper.selected { background-color: @{color.paperShade/.16}; shadow: @{color.inkRule} @{spec.selectedBar}dp 0 0 0 inset; }
c-card.tone-parchment.selected { shadow: @{color.paperShade/.28} 0 0 14dp 0 inset, @{color.inkRule} @{spec.selectedBar}dp 0 0 0 inset; }

/* dashed = an empty slot only. RCSS borders are solid, so the dashes are four strips. */
c-card.dashed { background-color: transparent; decorator: none; }
c-card > .dash { position: absolute; }
c-card > .dash.top, c-card > .dash.bottom { left: 0; right: 0; height: 1dp; decorator: repeating-linear-gradient(90deg, @{color.brassLine/.45} 0dp, @{color.brassLine/.45} 3dp, @{color.black/0} 3dp, @{color.black/0} 6dp); }
c-card > .dash.left, c-card > .dash.right { top: 0; bottom: 0; width: 1dp; decorator: repeating-linear-gradient(180deg, @{color.brassLine/.45} 0dp, @{color.brassLine/.45} 3dp, @{color.black/0} 3dp, @{color.black/0} 6dp); }
c-card > .dash.top { top: 0; }
c-card > .dash.bottom { bottom: 0; }
c-card > .dash.left { left: 0; }
c-card > .dash.right { right: 0; }
c-card.paper > .dash.top, c-card.paper > .dash.bottom { decorator: repeating-linear-gradient(90deg, @{color.inkMuted/.55} 0dp, @{color.inkMuted/.55} 3dp, @{color.black/0} 3dp, @{color.black/0} 6dp); }
c-card.paper > .dash.left, c-card.paper > .dash.right { decorator: repeating-linear-gradient(180deg, @{color.inkMuted/.55} 0dp, @{color.inkMuted/.55} 3dp, @{color.black/0} 3dp, @{color.black/0} 6dp); }
