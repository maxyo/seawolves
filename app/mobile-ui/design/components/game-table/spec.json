{
  "tag": "c-game-table",
  "props": {
    "opponent": {"type": "text", "default": ""},
    "portrait": {"type": "text", "default": ""},
    "line": {"type": "text", "default": ""},
    "bank": {"type": "text", "default": ""},
    "bankTone": {"type": "enum", "options": ["gold", "win", "loss"], "default": "gold"},
    "bankX": {"type": "text", "default": "46%"},
    "bankY": {"type": "text", "default": "44%"},
    "coins": {"type": "enum", "options": ["silver", "gold", "none"], "default": "silver"}
  },
  "constants": {
    "portrait": @{size.tokenSm},
    "stacks": [[0, 4, 8, 12], [0, 4, 8], [0, 4]]
  }
}
