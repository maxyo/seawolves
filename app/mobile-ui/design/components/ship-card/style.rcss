/* C-ShipCard: identity rail of the ship section (wood panel). Object header with the ✎
   rename quill (id <key>-rename), captain line, hull → crew → sails bars (an omitted bar is
   not drawn, never reordered), then the children at the bottom. */
c-ship-card {
    position: relative; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden;
    width: 100%; height: 100%; gap: @{space.md}dp; padding: @{space.panelPadV}dp @{space.panelPadH}dp;
    color: @{color.text}; background-color: @{color.wood};
    box-shadow: @{color.black/.45} 0 0 0 1dp inset, @{color.woodLight/.04} 0 1dp 0 0;
}
c-ship-card > .sc-captain { font-size: @{type.caption}dp; color: @{color.textSecond}; }
c-ship-card > .sc-bars { display: flex; flex-direction: column; gap: 12dp; margin-top: 4dp; }
c-ship-card > .sc-fill { flex: 1 1 0; }
c-ship-card > .sc-slot { flex: 0 0 auto; display: flex; flex-direction: column; gap: @{space.sm}dp; }
