{
  "tag": "c-ship-card",
  "props": {
    "title": {"type": "text", "default": ""},
    "sub": {"type": "text", "default": ""},
    "captain": {"type": "text", "default": ""},
    "rename": {"type": "bool", "default": true, "class": false},
    "hull": {"type": "json", "default": null, "shape": {"$null": {"text": "text", "value": "int"}}},
    "crew": {"type": "json", "default": null, "shape": {"$null": {"mark": "int", "text": "text", "value": "int"}}},
    "sails": {"type": "json", "default": null, "shape": {"$null": {"text": "text", "value": "int"}}},
    "image": {"type": "json", "default": null, "shape": {"$of": "c-object-header.image"}},
    "icon": {"type": "text", "default": "ship-lugger"},
    "renameLabel": {"type": "text", "default": "", "defaultKey": "ship.rename"},
    "labelWidth": {"type": "int", "default": 90},
    "key": {"type": "text", "default": "ship"}
  },
  "constants": {
    "bars": [
      {"prop": "hull", "labelKey": "ship.hull", "kind": "health"},
      {"prop": "crew", "labelKey": "ship.crew", "kind": "crew"},
      {"prop": "sails", "labelKey": "ship.sails", "kind": "sails"}
    ]
  }
}
