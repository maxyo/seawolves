<t-if test="rename"><c-object-header image="{{ is_object(image) ? json(image) : {kind: 'token', enamel: 'teal', icon: icon} }}" title="{{title}}" sub="{{sub}}" place="name"><c-icon-button id="{{key}}-rename" icon="quill" label="{{ or(renameLabel, tr('ship.rename')) }}" look="bare"/></c-object-header><t-else/><c-object-header image="{{ is_object(image) ? json(image) : {kind: 'token', enamel: 'teal', icon: icon} }}" title="{{title}}" sub="{{sub}}"/></t-if>
<t-if test="captain"><div class="sc-captain">{{captain}}</div></t-if>
<div class="sc-bars"><t-for each="spec.bars" as="b"><t-if test="is_object(pick(b.prop, 'hull', hull, 'crew', crew, 'sails', sails))"><c-bar label="{{ or(pick(b.prop, 'hull', hull, 'crew', crew, 'sails', sails).label, tr(b.labelKey)) }}" label-width="{{labelWidth}}" value="{{ or(pick(b.prop, 'hull', hull, 'crew', crew, 'sails', sails).value, 100) }}" mark="{{ opt(pick(b.prop, 'hull', hull, 'crew', crew, 'sails', sails).mark) }}" text="{{ pick(b.prop, 'hull', hull, 'crew', crew, 'sails', sails).text }}" kind="{{b.kind}}"/></t-if></t-for></div>
<div class="sc-fill"></div>
<t-if test="children"><div class="sc-slot" slot="1"></div></t-if>
