<t-if test="image_kind(image, icon)"><div class="lr-lead"><t-if test="cooldown > 0"><t-if test="image_kind(image, icon) == 'token'"><div class="lr-cd over" style="decorator: linear-gradient(0deg, @{color.steel/.38} 0%, @{color.steel/.38} {{ 100 - cooldown }}%, @{color.steel/.102} {{ 100 - cooldown }}%, @{color.steel/.102} 100%);"></div><t-else/><div class="lr-cd round" style="border-radius: {{ (image_kind(image, icon) == 'icon' ? (layout == 'tile' ? spec.icon.tile : spec.icon.row) : (layout == 'tile' ? spec.token.tile : spec.token.row)) / 2 + 6 }}dp; decorator: linear-gradient(0deg, @{color.steel/.42} 0%, @{color.steel/.42} {{ 100 - cooldown }}%, @{color.steel/.102} {{ 100 - cooldown }}%, @{color.steel/.102} 100%);"></div></t-if></t-if><c-row-image class="lr-pic" image="{{ json(image) }}" icon="{{icon}}" size="{{ layout == 'tile' ? spec.token.tile : spec.token.row }}" icon-size="{{ layout == 'tile' ? spec.icon.tile : spec.icon.row }}" tone="{{ surface == 'parchment' ? 'ink' : disabled ? 'dim' : selected ? 'duo' : 'brass' }}" label="{{title}}" surface="{{surface}}" disabled="{{ disabled ? 1 : 0 }}"/></div></t-if>
<t-if test="index != ''"><div class="lr-index">{{index}}</div></t-if>
<div class="lr-text"><t-if test="lines > 0 || wrap"><ui-clamp class="lr-title" min-size="@{type.min}" lines="{{ lines > 0 ? lines : spec.wrapLines }}" text="{{title}}"/><t-else/><div class="lr-title">{{title}}</div></t-if><t-if test="disabled && showReason && reason"><div class="lr-meta reason">{{reason}}</div><t-else/><t-if test="meta && layout != 'tile'"><div class="lr-meta{{ metaTone ? ' tone-' + metaTone : '' }}">{{meta}}</div></t-if></t-if></div>
<t-if test="layout != 'tile'"><t-if test="progress > 0"><div class="lr-progress"><div class="lr-pct">{{ round(clamp(progress, 0, 100)) }}%</div><div class="lr-track"><div class="lr-fill" style="width: {{ clamp(progress, 0, 100) }}%;"></div></div></div></t-if><t-if test="value"><div class="lr-value{{ valueTone ? ' tone-' + valueTone : '' }}">{{value}}</div></t-if></t-if>
<t-if test="children"><div class="lr-slot" slot="1"></div></t-if>
<t-if test="action || busy"><div class="lr-act" data-action="action" data-value="{{action}}"><t-if test="busy"><div class="lr-spinner"></div><t-else/><c-icon icon="{{action}}" size="{{spec.icon.action}}" tone="{{ surface == 'parchment' ? 'ink' : 'brass' }}"/></t-if></div></t-if>
<t-if test="layout != 'tile'"><t-if test="menu"><div class="lr-act menu" data-action="menu"><c-icon icon="more" size="{{spec.icon.menu}}" tone="{{ surface == 'parchment' ? 'ink' : 'brass' }}"/></div></t-if><t-if test="chevron"><c-icon icon="chevron-right" size="{{spec.icon.chevron}}" tone="{{ surface == 'parchment' ? 'ink' : 'brass' }}"/></t-if></t-if>
