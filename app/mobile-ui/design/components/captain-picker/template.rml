<t-if test="len(candidates) > 0 || empty"><div class="cp-list"><t-for each="candidates" as="o"><c-list-row id="{{o.id}}" image="{{ json(o.image) }}" icon="hero" title="{{o.title}}" selected="{{ o.selected ? 1 : 0 }}" disabled="{{ o.disabled ? 1 : 0 }}" reason="{{o.reason}}" style="width: 100%"/></t-for><t-if test="empty"><div class="cp-empty">{{empty}}</div></t-if></div></t-if>
<t-if test="name || len(actions) > 0"><div class="cp-side"><t-if test="name"><div class="cp-detail"><div class="cp-name">{{name}}</div><t-if test="len(skills) > 0"><div class="cp-skills"><t-for each="skills" as="s"><div class="cp-skill"><c-icon icon="{{s.icon}}" size="{{spec.skillIcon}}" tone="brass"/><div class="cp-skill-text"><div class="cp-skill-k">{{s.k}}</div><div class="cp-skill-v{{ s.tone ? ' tone-' + s.tone : '' }}">{{s.v}}</div></div></div></t-for></div></t-if><t-if test="len(facts) > 0"><c-kv items="{{ json(facts) }}" style="width: 100%"/></t-if></div></t-if><t-if test="len(actions) > 0"><div class="cp-actions"><t-for each="actions" as="a"><c-button id="{{a.id}}" label="{{a.label}}" variant="{{ or(a.variant, 'secondary') }}" disabled="{{ opt(a.disabled) ? 1 : 0 }}" reason="{{opt(a.reason)}}"/></t-for></div></t-if></div></t-if>
