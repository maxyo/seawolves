/* C-CaptainPicker: the candidates and the selected one's facts side by side. It shrinks with its dialog's body
   (c-dialog keeps the title and the actions on the screen; overflow hidden lets RmlUi shrink it below its content):
   each column scrolls on its own. */
c-captain-picker { display: flex; flex-direction: row; gap: @{space.lg}dp; box-sizing: border-box; width: 100%; flex: 0 1 auto; min-height: 0; overflow: hidden; }
c-captain-picker > .cp-list { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; overflow-y: auto; }
c-captain-picker > .cp-list > .cp-empty { font-size: @{type.body}dp; color: @{color.textMuted}; padding: @{space.sm}dp 0; }
c-captain-picker > .cp-side { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: @{space.sm}dp; overflow: hidden; }
c-captain-picker > .cp-list + .cp-side { padding-left: @{space.lg}dp; border-left: 1dp @{color.brassLine/.14}; }
c-captain-picker .cp-detail { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; gap: @{space.sm}dp; overflow-y: auto; }
c-captain-picker .cp-actions { flex: 0 0 auto; margin-top: auto; display: flex; flex-direction: row; justify-content: flex-end; gap: @{space.sm}dp; }
c-captain-picker .cp-detail > .cp-name { flex: 0 0 auto; font-size: @{type.body}dp; font-weight: bold; color: @{color.textSecond}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
c-captain-picker .cp-skills { flex: 0 0 auto; display: flex; flex-direction: row; flex-wrap: wrap; width: 100%; }
c-captain-picker .cp-skill { flex: 0 0 auto; box-sizing: border-box; width: 50%; height: 34dp; display: flex; flex-direction: row; align-items: center; gap: @{space.sm}dp; padding: 0 6dp 0 2dp; border-bottom: 1dp @{color.brassLine/.14}; }
c-captain-picker .cp-skill-text { flex: 1 1 0; min-width: 0; }
c-captain-picker .cp-skill-k { font-size: @{type.min}dp; line-height: 14dp; color: @{color.textMuted}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
c-captain-picker .cp-skill-v { font-size: @{type.body}dp; line-height: 17dp; font-weight: bold; color: @{color.text}; white-space: nowrap; }
c-captain-picker .cp-skill-v.tone-ok { color: @{color.ok}; }
c-captain-picker .cp-skill-v.tone-danger { color: @{color.danger}; }
