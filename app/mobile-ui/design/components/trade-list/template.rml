<div class="tl-main">
<div class="tl-head" data-columns-head=""><t-if test="len(filters) > 1"><div class="tl-chips"><t-for each="filters" as="f"><div class="tl-chip{{ f.selected ? ' sel' : '' }}{{ opt(f.disabled) ? ' off' : '' }}" data-action="filter" data-value="{{ or(f.id, f_i) }}" data-disabled?="{{ opt(f.disabled) }}" data-reason="{{opt(f.reason)}}">{{f.label}}</div></t-for></div><t-else/><div class="tl-h0"></div><div class="tl-hname" data-action="" data-tip="{{label}}"><t-if test="label"><c-icon icon="{{labelIcon}}" size="18" tone="brass"/></t-if></div></t-if><t-for each="cols" as="h"><div class="tl-hcol{{ opt(h.sort) ? ' sorted' : '' }}" data-col="{{h_i}}" data-tip="{{h.label}}" data-action="{{ opt(h.sortable) ? 'sort' : '' }}" data-value?="{{ opt(h.sortable) ? str(h_i) : '' }}"><t-if test="h.icon"><c-icon class="tl-hicon" icon="{{h.icon}}" size="16" tone="{{ or(h.iconTone, 'brass') }}"/></t-if><div class="tl-hrow"><t-if test="!h.icon"><div>{{h.label}}</div></t-if><t-if test="opt(h.sort)"><c-icon icon="{{ opt(h.sort) == 'asc' ? 'chevron-up' : 'chevron-down' }}" size="10" tone="brass"/></t-if></div></div></t-for><t-if test="quick"><div class="tl-hq"></div></t-if></div>
<div class="tl-wrap"><div class="tl-list" data-columns-body="">
<t-for each="rows" as="r" key="or(r.id, r_i)"><div rmlui-layout-boundary="" data-reveal?="{{ opt(r.q) && !dock ? str(or(r.id, r_i)) : '' }}" class="tl-item{{ opt(r.selected) ? ' sel' : '' }}{{ opt(r.disabled) ? ' dis' : '' }}{{ r_last ? ' last' : '' }}"><div class="tl-row"><div class="tl-line" data-action?="{{ rowTap ? 'row' : '' }}" data-value="{{ or(r.id, r_i) }}" data-disabled?="{{ opt(r.disabled) }}" data-reason="{{opt(r.reason)}}">
<div class="tl-pic"><c-row-image image="{{ json(r.image) }}" icon="{{ r.image ? '' : 'chest' }}" size="{{ dense ? spec.pictureDense : spec.picture }}" icon-size="{{ dense ? 22 : spec.icon }}" tone="{{ opt(r.disabled) ? 'dim' : 'brass' }}" label="{{r.name}}" disabled="{{ opt(r.disabled) ? 1 : 0 }}"/></div>
<div class="tl-who"><div class="tl-name{{ opt(r.disabled) ? ' dim' : '' }}">{{r.name}}</div><t-if test="opt(r.meta)"><div class="tl-meta{{ opt(r.metaTone) ? ' tone-' + opt(r.metaTone) : '' }}">{{opt(r.meta)}}</div></t-if></div>
<t-for each="r.cells" as="c"><div class="tl-cell{{ opt(c.bold) ? ' bold' : '' }}{{ !(is_object(c) ? c.text : c) || in(is_object(c) ? c.text : c, '0', '—', '-') || opt(c.tone) == 'dim' ? ' tone-dim' : opt(c.tone) ? ' tone-' + opt(c.tone) : '' }}" data-col="{{c_i}}"><div class="tl-num">{{ !(is_object(c) ? c.text : c) || in(is_object(c) ? c.text : c, '0', '—', '-') ? '—' : str(int(is_object(c) ? c.text : c)) != str(is_object(c) ? c.text : c) ? (is_object(c) ? c.text : c) : ((is_object(c) ? c.text : c) < 0 ? '−' : '') + (abs(is_object(c) ? c.text : c) >= 1000 && abs(is_object(c) ? c.text : c) < 10000 ? int(abs(is_object(c) ? c.text : c) / 1000) + ' ' + (abs(is_object(c) ? c.text : c) % 1000 < 10 ? '00' : abs(is_object(c) ? c.text : c) % 1000 < 100 ? '0' : '') + abs(is_object(c) ? c.text : c) % 1000 : num(abs(is_object(c) ? c.text : c))) }}</div><t-if test="opt(c.sub)"><div class="tl-sub">{{opt(c.sub)}}</div></t-if></div></t-for>
</div><t-if test="quick"><t-if test="r.quick"><div class="tl-quick" data-action="quick" data-value="{{ or(r.id, r_i) }}"><c-icon icon="{{quick}}" size="22" tone="brass"/></div><t-else/><div class="tl-hq"></div></t-if></t-if></div><t-if test="opt(r.q) && !dock"><div class="tl-expand"><c-quantity min?="{{ has(r.q, 'min') ? '' : '0' }}" all?="{{ !has(r.q, 'all') }}" surface?="{{ has(r.q, 'surface') ? '' : 'wood' }}" props="{{ json(r.q) }}" style="width: 100%"/></div></t-if></div></t-for>
</div></div>
</div>
<t-if test="dock"><div rmlui-layout-boundary="" class="tl-dock"><t-if test="deal"><div class="tl-deal"><t-for each="rows" as="r"><t-if test="opt(r.selected)">
<c-object-header image="{{ json(r.image) }}" icon="{{ r.image ? '' : 'chest' }}" title="{{r.name}}" sub="{{ or(r.sub, opt(r.meta)) }}" size="40" title-size="@{type.name}" style="width: 100%"/><t-if test="has(r, 'facts') && len(r.facts) > 0"><div class="tl-facts"><t-for each="r.facts" as="f"><div class="tl-fact{{ opt(f.tone) ? ' tone-' + opt(f.tone) : '' }}"><t-if test="opt(f.icon)"><c-icon icon="{{opt(f.icon)}}" size="18" tone="{{ or(f.iconTone, 'brass') }}"/></t-if><div>{{f.v}}</div></div></t-for></div></t-if>
<t-if test="opt(r.text)"><div class="tl-text" data-action="info" data-value="{{ or(r.id, r_i) }}"><ui-clamp lines="3" min-size="@{type.min}" text="{{opt(r.text)}}"/></div></t-if>
</t-if></t-for><div class="tl-sep"></div>
<c-quantity props="{{ json(deal) }}" style="width: 100%"/>
</div><t-else/><t-for each="rows" as="r"><t-if test="opt(r.q)"><div class="tl-deal">
<c-object-header image="{{ json(r.image) }}" icon="{{ r.image ? '' : 'chest' }}" title="{{r.name}}" sub="{{ or(r.sub, opt(r.meta)) }}" size="40" title-size="@{type.name}" style="width: 100%"/><t-if test="has(r, 'facts') && len(r.facts) > 0"><div class="tl-facts"><t-for each="r.facts" as="f"><div class="tl-fact{{ opt(f.tone) ? ' tone-' + opt(f.tone) : '' }}"><t-if test="opt(f.icon)"><c-icon icon="{{opt(f.icon)}}" size="18" tone="{{ or(f.iconTone, 'brass') }}"/></t-if><div>{{f.v}}</div></div></t-for></div></t-if>
<t-if test="opt(r.text)"><div class="tl-text" data-action="info" data-value="{{ or(r.id, r_i) }}"><ui-clamp lines="3" min-size="@{type.min}" text="{{opt(r.text)}}"/></div></t-if>
<div class="tl-sep"></div>
<c-quantity min?="{{ has(r.q, 'min') ? '' : '0' }}" all?="{{ !has(r.q, 'all') }}" surface?="{{ has(r.q, 'surface') ? '' : 'wood' }}" stack?="{{ !has(r.q, 'stack') }}" props="{{ json(r.q) }}" style="width: 100%"/>
</div><t-else/><t-if test="opt(r.selected)"><div class="tl-deal idle"><c-object-header image="{{ json(r.image) }}" icon="{{ r.image ? '' : 'chest' }}" title="{{r.name}}" sub="{{ or(r.sub, opt(r.meta)) }}" size="40" title-size="@{type.name}" style="width: 100%"/><t-if test="has(r, 'facts') && len(r.facts) > 0"><div class="tl-facts"><t-for each="r.facts" as="f"><div class="tl-fact{{ opt(f.tone) ? ' tone-' + opt(f.tone) : '' }}"><t-if test="opt(f.icon)"><c-icon icon="{{opt(f.icon)}}" size="18" tone="{{ or(f.iconTone, 'brass') }}"/></t-if><div>{{f.v}}</div></div></t-for></div></t-if></div></t-if></t-if></t-for></t-if><div class="tl-slot" slot="1"></div></div></t-if>
