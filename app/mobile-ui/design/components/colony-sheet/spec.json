{
  "tag": "c-colony-sheet",
  "props": {
    "title": {"type": "text", "default": ""},
    "nation": {"type": "text", "default": ""},
    "sub": {"type": "text", "default": ""},
    "tabs": {"type": "json", "default": [], "shape": {"$of": "c-tabs.items"}},
    "siege": {"type": "text", "default": ""},
    "exports": {"type": "json", "default": [], "shape": [{"icon": "text", "label": "text"}]},
    "imports": {"type": "json", "default": [], "shape": [{"icon": "text", "label": "text"}]},
    "facts": {"type": "json", "default": [], "shape": {"$of": "c-kv.items"}},
    "expanded": {"type": "bool", "default": false, "class": false},
    "date": {"type": "text", "default": ""},
    "custom": {"type": "bool", "default": false},
    "key": {"type": "text", "default": "colony"}
  },
  "behaviors": ["press"],
  "constants": {
    "pressRoot": false,
    "headMin": 56,
    "token": @{size.tokenSm},
    "goodsIcon": 18,
    "font": {"title": @{type.title}, "sub": @{type.caption}, "body": @{type.body}, "small": @{type.caption}}
  }
}
