<div class="mv-port" data-panzoom="1"><div class="mv-plane" data-plane="1"><ui-game-image texture="{{texture}}" uv="{{uv}}"/><t-for each="markers" as="m"><div class="mv-marker" style="left: {{ m.x * 100 / base[0] }}%; top: {{ m.y * 100 / base[1] }}%; width: {{ m.w * spec.markerScale }}dp; height: {{ m.h * spec.markerScale }}dp; margin-left: {{ -m.w * spec.markerScale / 2 }}dp; margin-top: {{ -m.h * spec.markerScale / 2 }}dp;"><ui-game-image texture="{{m.texture}}" uv="{{ m.uv }}"/></div></t-for></div><t-if test="zoom"><div class="mv-zoom"><div class="mv-zbtn" data-zoom="in"><c-icon icon="plus" size="{{spec.zoomGlyph}}" tone="brass"/></div><div class="mv-rule"></div><div class="mv-zbtn" data-zoom="out"><c-icon icon="minus" size="{{spec.zoomGlyph}}" tone="brass"/></div></div></t-if></div>
