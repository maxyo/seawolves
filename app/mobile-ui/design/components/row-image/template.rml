<t-if test="image_kind(image, icon) == 'token'"><c-token icon="{{ or(image.icon, icon) }}" enamel="{{ or(image.enamel, 'teal') }}" size="{{size}}" round="{{ round ? 1 : 0 }}" disabled="{{ disabled ? 1 : 0 }}"/><t-else/><t-if test="in(image_kind(image, icon), 'item', 'portrait', 'emblem')"><c-game-image kind="{{ image_kind(image, icon) }}" texture="{{image.texture}}" icon="{{ or(image.icon, or(icon, 'chest')) }}" size="{{size}}" label="{{label}}" surface="{{surface}}" round="{{ round ? 1 : 0 }}" selected="{{ selected ? 1 : 0 }}" disabled="{{ disabled ? 1 : 0 }}"/><t-else/><t-if test="image_kind(image, icon) == 'icon'"><c-icon icon="{{ or(is_object(image) ? image.icon : '', icon) }}" size="{{iconSize}}" tone="{{tone}}"/></t-if></t-if></t-if>
