<div class="scrim{{ scrim ? ' on' : '' }}" data-action="dismiss"></div>
<div class="outer" style="flex-basis: {{ width ? width : spec.width[variant] }}dp;"><t-if test="aged && tone == 'parchment'"><ui-paper seed="{{seed}}"/></t-if><div class="box">
<t-if test="step"><div class="step"><t-for each="spec.steps[step]" as="d"><div class="dot{{ d ? ' on' : '' }}"></div></t-for><div class="step-text">{{step}}</div></div></t-if>
<div class="head"><t-if test="icon"><c-icon icon="{{icon}}" size="{{spec.iconSize}}" tone="{{ preset == 'danger' ? 'danger' : starts(icon, 'nation-') ? 'color' : tone == 'parchment' ? 'ink' : 'brass' }}"/></t-if><div class="titles"><div class="title">{{ subject ? title + ' «' + subject + '»?' : title }}</div><t-if test="subtitle"><div class="subtitle">{{subtitle}}</div></t-if></div><t-if test="closable"><c-icon-button id="{{key}}-close" icon="close" label="{{ tr('common.close') }}" look="bare" surface="{{tone}}"/></t-if></div>
<t-if test="consequence"><div class="consequence">{{consequence}}</div></t-if>
<t-if test="text"><div class="text">{{text}}</div></t-if>
<t-if test="children"><div class="body" slot="1"></div></t-if>
<t-if test="len(actions) > 0"><div class="actions"><t-for each="actions" as="a"><c-button id="{{ or(a.id, key + '-action-' + a_i) }}" label="{{a.label}}" variant="{{ or(a.variant, 'secondary') }}" icon="{{opt(a.icon)}}" disabled="{{ opt(a.disabled) ? 1 : 0 }}" reason="{{opt(a.reason)}}" sub="{{opt(a.sub)}}" hold="{{ opt(a.hold) ? 1 : 0 }}" busy="{{ opt(a.busy) ? 1 : 0 }}" hold-progress="{{ or(a.holdProgress, 0) }}" size="{{ or(a.size, 'md') }}" surface="{{ or(a.surface, tone) }}"/></t-for></div><t-else/><t-if test="preset"><div class="actions"><c-button id="{{key}}-cancel" label="{{ or(cancel, tr('common.cancel')) }}" variant="quiet" surface="{{tone}}"/><c-button id="{{key}}-confirm" label="{{ or(confirm, tr('common.yes')) }}" variant="{{ preset == 'danger' ? 'danger' : 'primary' }}" surface="{{tone}}"/></div></t-if></t-if>
</div><t-if test="edge || framed"><div class="edge-line"></div></t-if></div>
