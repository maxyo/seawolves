<div class="box" data-action?="{{ expandable ? 'expand' : '' }}" data-toggle?="{{ expandable ? 'expanded' : '' }}" style="padding: {{ or(pad, spec.pad[variant]) }}dp {{ or(pad, spec.pad[variant]) + 2 }}dp;">
<t-if test="title || expandable"><div class="head"><t-if test="title"><div class="title">{{title}}</div></t-if><t-if test="expandable"><c-icon icon="{{ expanded ? 'chevron-up' : 'chevron-down' }}" size="16" tone="brass"/></t-if></div></t-if>
<t-if test="variant == 'location'"><div class="location">{{text}}</div></t-if>
<t-if test="variant == 'officers' || variant == 'fleet'"><div class="list" style="{{ direction == 'row' ? 'max-width: ' + maxWidth + 'dp; gap: ' + spec.gap + 'dp ' + spec.gap + 'dp;' : (maxHeight > 0 ? 'max-height: ' + maxHeight + 'dp;' : 'flex: 1 1 0; min-height: 0;') + ' gap: ' + spec.gap + 'dp ' + spec.gap + 'dp;' }}"><t-for each="variant == 'fleet' ? ships : officers" as="o"><t-if test="!max || max > o_i"><div class="item member {{ variant == 'fleet' ? 'ship' : 'person' }}" data-action?="{{ opt(o.tap) ? (variant == 'fleet' ? 'ship' : 'member') : '' }}" data-value?="{{ opt(o.tap) ? str(o_i) : '' }}" style="width: {{ variant == 'fleet' ? spec.shipToken : spec.portrait }}dp; height: {{ variant == 'fleet' ? spec.shipToken : spec.portrait }}dp;"><div class="pic" style="left: {{ len(o.bars) * (spec.arc + spec.arcGap) }}dp; top: {{ len(o.bars) * (spec.arc + spec.arcGap) }}dp;"><c-game-image kind="{{ variant == 'fleet' ? 'item' : 'portrait' }}" icon="ship" round="1" texture="{{ or(o.texture, '') }}" uv="{{ or(o.uv, '') }}" label="{{ or(o.name, '') }}" size="{{ (variant == 'fleet' ? spec.shipToken : spec.portrait) - 2 * len(o.bars) * (spec.arc + spec.arcGap) }}"/></div><t-for each="o.bars" as="b"><ui-ring class="arc kind-{{ b.kind == 'health' && clamp(or(b.value, 0), 0, 100) < (variant == 'fleet' ? spec.shipDanger : spec.officerDanger) ? 'danger' : b.kind }}" shape="circle" value="{{ clamp(or(b.value, 0), 0, 100) }}" thickness="{{spec.arc}}" style="left: {{ b_i * (spec.arc + spec.arcGap) }}dp; top: {{ b_i * (spec.arc + spec.arcGap) }}dp; width: {{ (variant == 'fleet' ? spec.shipToken : spec.portrait) - 2 * b_i * (spec.arc + spec.arcGap) }}dp; height: {{ (variant == 'fleet' ? spec.shipToken : spec.portrait) - 2 * b_i * (spec.arc + spec.arcGap) }}dp;"/></t-for></div></t-if></t-for></div></t-if>
<t-if test="variant == 'boarding'"><div class="duel"><div class="side ours"><t-if test="oursCount != null"><div class="count">{{oursCount}}</div></t-if><div class="track"><div class="fill" style="width: {{ clamp(ours, 0, 100) }}%;"></div></div></div><c-icon icon="swords" size="18" tone="brass"/><div class="side theirs"><div class="track"><div class="fill" style="width: {{ clamp(theirs, 0, 100) }}%;"></div></div><t-if test="theirsCount != null"><div class="count">{{theirsCount}}</div></t-if></div></div></t-if>
<t-if test="children"><div class="slot" slot="1"></div></t-if>
<t-if test="len(states) > 0"><div class="states"><t-for each="states" as="s"><c-hud-button state="1" size="{{ clamp(stateSize, 24, 28) }}" icon="{{ s.icon }}" fill="{{ s.fill }}" fill-tone="{{ s.fillTone }}" label="{{ s.label }}"/></t-for></div></t-if>
</div>
