/* C-HudPlate: a HUD group over the scene, bare by default — no background, no
   frame; text stands on the scene with a dark shadow. `plate` restores the flat translucent
   plate with a 3 dp tone edge (expanded info panels only). Size and place it from the document. */
c-hud-plate { display: block; box-sizing: border-box; pointer-events: none; }
/* a plate only shows: a touch on it belongs to what lies under it (the move zone, the game),
   except on its own buttons */
c-hud-plate > .box[data-action] { pointer-events: auto; }
c-hud-plate > .box { display: flex; flex-direction: column; align-items: stretch; gap: 4dp; box-sizing: border-box; width: 100%; height: 100%;
    border-radius: @{radius.sm}dp; line-height: 1.3; color: @{color.text};
    font-effect: outline(1dp @{color.black}), glow(3dp @{color.black/.8}), shadow(0dp 1dp @{color.black}); }
c-hud-plate.tone-danger > .box { color: @{color.danger}; }
c-hud-plate.tone-gold > .box { color: @{color.brass}; }
c-hud-plate.align-right > .box { align-items: flex-end; text-align: right; }
c-hud-plate.align-center > .box { align-items: center; text-align: center; }

c-hud-plate.plate > .box { color: @{color.text}; background-color: @{color.hudPlate/.55}; font-effect: shadow(0dp 1dp @{color.black/.8}); }
c-hud-plate.plate.tone-danger > .box { shadow: @{color.dangerFill} 3dp 0 0 0 inset; }
c-hud-plate.plate.tone-gold > .box { shadow: @{color.brass} 3dp 0 0 0 inset; }

c-hud-plate .head { display: flex; flex-direction: row; align-items: center; gap: 6dp; }
c-hud-plate .title { flex: 1 1 auto; font-size: @{type.caption}dp; color: @{color.textSecond}; }
c-hud-plate .location { font-size: @{type.body}dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
c-hud-plate .slot { display: flex; flex-direction: column; align-items: stretch; gap: 4dp; }
c-hud-plate.align-right .slot { align-items: flex-end; }
c-hud-plate.align-center .slot { align-items: center; }

/* officers (the land party: hero first) / fleet (the squadron, flagship first): a column on the
   left that wraps into further columns below max-height, or a row. Each member is its round game
   picture (a face portrait, or the ship's picture of the battle interface's icon atlas) in a thin
   dark brass bezel, ringed by one thin arc per bar (outermost first: hull or health, then crew,
   then sails or energy), each on a dark track, 1 dp apart and 1 dp off the bezel: no plate, no
   numbers. The cream crew ring never borders the brass. */
c-hud-plate .list { display: flex; flex-direction: column; flex-wrap: wrap; align-content: flex-start; align-items: flex-start; }
c-hud-plate.direction-row .list { flex-direction: row; }
/* a right-aligned plate (the mirrored layout, «Под левую руку») keeps its members against the right edge: a row
   from the right, further columns towards the middle */
c-hud-plate.align-right .list { align-items: flex-end; align-content: flex-end; flex-wrap: wrap-reverse; }
c-hud-plate.align-right.direction-row .list { flex-direction: row-reverse; flex-wrap: wrap; }
c-hud-plate .item { display: block; position: relative; flex: 0 0 auto; }
c-hud-plate .item[data-action] { pointer-events: auto; }
/* a faint dark disc under the rings: the 1 dp gaps between them and the bezel read as one
   dark mount over a map name or a bright coast, not as doubled outlines with the scene between */
c-hud-plate .item { border-radius: @{radius.pill}dp; background-color: @{color.black/.3}; }
c-hud-plate .item .pic { position: absolute; }
c-hud-plate .item c-game-image .gi-box { border-radius: @{radius.pill}dp; border: 1dp @{color.brassEdge/.7}; shadow: @{color.black/.5} 0 1dp 4dp 0; }
/* a ship icon of the atlas carries its own square grey frame: the round mask shows the middle */
c-hud-plate .item.ship ui-game-image { left: -9%; top: -9%; right: -9%; bottom: -9%; }
c-hud-plate .item ui-ring.arc { position: absolute; ring-track: @{color.black/.55}; }
c-hud-plate .item ui-ring.kind-health { ring-fill: @{color.barHealthTop}; ring-fill-end: @{color.barHealthLow}; }
c-hud-plate .item ui-ring.kind-danger { ring-fill: @{color.dangerLine}; ring-fill-end: @{color.dangerDeep}; }
c-hud-plate .item ui-ring.kind-sails, c-hud-plate .item ui-ring.kind-energy { ring-fill: @{color.skyDeep}; ring-fill-end: @{color.barBlueLow}; }
c-hud-plate .item ui-ring.kind-crew { ring-fill: @{color.barCreamTop}; ring-fill-end: @{color.barCreamLow}; }
c-hud-plate .item.pressed { transform: scale(0.94); }

/* land states: one row of 26 dp icons right under the bars */
c-hud-plate .states { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; margin-top: 2dp; justify-content: flex-start; }
c-hud-plate.align-right .states { justify-content: flex-end; }
c-hud-plate.align-center .states { justify-content: center; }

/* boarding (the deck fight): our men and theirs as two bare bars facing each other across crossed
   sabres, each full at the fight's start and emptying towards its own end; the numbers only when given */
c-hud-plate .duel { display: flex; flex-direction: row; align-items: center; gap: 6dp; width: 100%; }
c-hud-plate .duel .side { display: flex; flex-direction: row; align-items: center; gap: 4dp; flex: 1 1 0; }
c-hud-plate .duel .track { position: relative; flex: 1 1 auto; height: 8dp; border-radius: 4dp; background-color: @{color.black/.55}; border: 1dp @{color.text/.3}; }
c-hud-plate .duel .fill { position: absolute; top: 0; bottom: 0; border-radius: 4dp; }
c-hud-plate .duel .ours .fill { left: 0; decorator: linear-gradient(@{color.skyDeep}, @{color.barBlueLow}); }
c-hud-plate .duel .theirs .fill { right: 0; decorator: linear-gradient(@{color.dangerLine}, @{color.dangerDeep}); }
c-hud-plate .duel .count { font-size: @{type.caption}dp; min-width: 24dp; }
c-hud-plate .duel .ours .count { text-align: right; }
