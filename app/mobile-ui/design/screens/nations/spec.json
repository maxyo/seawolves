{
  "tag": "s-nations",
  "doc": "Hero section «Нации» (interface nationrelation), filled by the script interface/touch/screens/hero/nations.c through the shapes of its json props: relations matrix with its legend, the hero's reputation, the flag the ship raises. A nation's picture is our flag `icon`, else the game's `image`.",
  "props": {
    "title": {"type": "text", "default": ""},
    "headerSection": {"type": "text", "default": ""},
    "columns": {"type": "json", "default": [], "shape": [{"label": "text", "icon": "text", "image": "picture"}]},
    "rows": {"type": "json", "default": [],
             "shape": [{"label": "text", "icon": "text", "image": "picture",
                        "cells": [{"self": "bool", "label": "text", "icon": "text", "image": "picture"}]}]},
    "legend": {"type": "json", "default": [], "shape": [{"icon": "text", "label": "text"}]},
    "reputationTitle": {"type": "text", "default": ""},
    "reputation": {"type": "json", "default": [],
                   "shape": [{"label": "text", "value": "text", "icon": "text", "image": "picture", "bar": "int",
                              "tone": "text"}]},
    "helpReputation": {"type": "bool", "default": false, "class": false},
    "helpFlag": {"type": "bool", "default": false, "class": false},
    "flagTitle": {"type": "text", "default": ""},
    "flag": {"type": "json", "default": null, "shape": {"$null": {"label": "text"}}},
    "flags": {"type": "json", "default": [],
              "shape": [{"id": "text", "icon": "text", "label": "text", "selected": "bool", "disabled": "bool"}]},
    "flagsDisabled": {"type": "bool", "default": false, "class": false},
    "apply": {"type": "json", "default": null,
              "shape": {"$null": {"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text"}}},
    "extras": {"type": "json", "default": {}}
  }
}
