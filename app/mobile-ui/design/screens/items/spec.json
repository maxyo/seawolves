{
  "tag": "s-items",
  "doc": "Hero section «Предметы» (interface items), filled by the script interface/touch/screens/hero/items.c through the shapes of its json props: all equipment slots at once (what is worn in each; a tap lists what fits), the items in compact columns under the game's tabs, the selected item on parchment with its figures against what is worn, the game's map window.",
  "props": {
    "title": {"type": "text", "default": ""},
    "headerSection": {"type": "text", "default": ""},
    "subject": {"type": "json", "default": null, "shape": {"$of": "c-screen.subject"}},
    "stats": {"type": "json", "default": [], "shape": {"$of": "c-screen.stats"}},
    "slots": {"type": "json", "default": [], "shape": [{"id": "text", "label": "text", "icon": "text", "image": {"$of": "c-tile.image"}, "sub": "text", "empty": "bool", "selected": "bool"}]},
    "tabs": {"type": "json", "default": [], "shape": {"$of": "c-tabs.items"}},
    "rows": {"type": "json", "default": [], "shape": {"$of": "s-item-grid.rows"}},
    "empty": {"type": "text", "default": ""},
    "detail": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "sub": "text", "image": {"$of": "c-object-header.image"}, "text": "text", "facts": {"$of": "c-kv.items"}, "action": {"$null": {"id": "text", "label": "text", "variant": "text", "hold": "bool", "disabled": "bool", "reason": "text", "busy": "bool"}}}}},
    "map": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "text": "text", "image": {"$of": "c-row-image.image"}}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  },
  "constants": {
    "narrowBelow": 720
  }
}
