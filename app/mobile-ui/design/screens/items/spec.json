{
  "tag": "s-items",
  "doc": "Hero section «Предметы» (interface items), filled by the script interface/touch/screens/hero/items.c through the shapes of its json props: all equipment slots at once (what is worn in each; a tap lists what fits), the items in compact columns under the game's tabs, the selected item on parchment with its figures against what is worn, the game's map window.",
  "props": {
    "title": {"type": "text", "default": ""},
    "headerSection": {"type": "text", "default": ""},
    "subject": {"type": "json", "default": null,
                "shape": {"$null": {"label": "text", "sub": "text", "prev": "bool", "next": "bool", "list": "bool",
                                    "open": "bool", "title": "text",
                                    "rows": [{"label": "text", "meta": "text", "image": "picture", "icon": "text",
                                              "selected": "bool"}]}}},
    "stats": {"type": "json", "default": [], "shape": [{"icon": "text", "value": "text"}]},
    "slots": {"type": "json", "default": [],
              "shape": [{"id": "text", "label": "text", "icon": "text", "image": "picture", "sub": "text", "empty": "bool",
                         "selected": "bool"}]},
    "tabs": {"type": "json", "default": [], "shape": [{"id": "text", "label": "text", "selected": "bool"}]},
    "rows": {"type": "json", "default": [],
             "shape": [{"id": "text", "selected": "bool",
                        "cells": [{"$either": ["text", {"text": "text", "image": "picture", "badge": "text"}]}]}]},
    "empty": {"type": "text", "default": ""},
    "detail": {"type": "json", "default": null,
               "shape": {"$null": {"title": "text", "sub": "text", "image": "picture", "text": "text",
                                   "facts": [{"k": "text", "v": "text", "d": "text", "dTone": "text"}],
                                   "action": {"$null": {"id": "text", "label": "text", "variant": "text", "hold": "bool",
                                                        "disabled": "bool", "reason": "text", "busy": "bool"}}}}},
    "map": {"type": "json", "default": null,
            "shape": {"$null": {"title": "text", "text": "text", "image": "picture"}}},
    "extras": {"type": "json", "default": {}}
  },
  "constants": {
    "narrowBelow": 720
  }
}
