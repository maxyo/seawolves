            {
              "date": "text",
              "text": "text"
            }
          ]
        }
      }
    },
    "tables": {"type": "json", "default": [], "shape": [{"id": "text", "interactive": "bool", "height": "int", "columns": {"$of": "c-table.columns"}, "rows": {"$of": "c-table.rows"}}]},
    "noTables": {
      "type": "text",
      "default": ""
    },
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
