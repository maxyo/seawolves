      "type": "text",
      "default": ""
    },
    "headerSection": {
      "type": "text",
      "default": ""
    },
    "date": {
      "type": "text",
      "default": ""
    },
    "section": {
      "type": "text",
      "default": "quests"
    },
    "sections": {
      "type": "json",
      "default": [],
      "shape": [
        {
          "id": "text",
          "label": "text",
          "selected": "bool",
          "count": "text"
        }
      ]
    },
    "subtabs": {"type": "json", "default": [], "shape": {"$of": "c-tabs.items"}},
    "list": {"type": "json", "default": [], "shape": {"$of": "c-table.rows"}},
