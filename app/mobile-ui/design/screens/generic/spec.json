{
  "tag": "s-generic",
  "doc": "The generic layout of a game window no other screen draws (interface/touch/universal/generic.c), filled through the shapes of its json props.",
  "props": {
    "title": {"type": "text", "default": ""},
    "layout": {"type": "enum", "options": ["reading", "split", "settings", "settings-wide", "list", "fallback"], "default": "fallback", "class": false},
    "left": {"type": "json", "default": [], "shape": [{"$of": "s-block.block"}]},
    "right": {"type": "json", "default": [], "shape": [{"$of": "s-block.block"}]},
    "actions": {"type": "json", "default": [], "shape": {"$of": "s-actions.actions"}},
    "danger": {"type": "json", "default": null, "shape": {"$of": "s-actions.danger"}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
