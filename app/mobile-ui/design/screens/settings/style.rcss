/* s-settings: the rail of pages on the left, the page in two columns that scrolls, «Готово» fixed at the bottom. */
s-settings { display: block; width: 100%; height: 100%; }
s-settings .se-rail { flex: 0 0 168dp; height: 100%; }
s-settings .se-rail-in { display: flex; flex-direction: column; padding: 6dp @{space.xs}dp; }
s-settings .se-main { flex: 1 1 0; min-width: 0; height: 100%; }
s-settings .se-page { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: @{space.sm}dp 18dp @{space.lg}dp 18dp; }
/* rows continue below the fold on compact phones: the runtime's scroll fade (base.rcss) is taller here, so the last
   row in view is always partly under it and reads as cut, a cue that more follows */
s-settings .se-page > .scroll-fade { height: 48dp; }
s-settings .se-section { display: block; margin-bottom: @{space.sm}dp; }
/* two columns where each keeps @{spec.colMin} dp (its segments' names on one line), else one under the other */
s-settings .se-cols { display: flex; flex-direction: row; flex-wrap: wrap; column-gap: 20dp; }
s-settings .se-col { flex: 1 1 @{spec.colMin}dp; min-width: 0; display: flex; flex-direction: column; }
/* a group heading inside a column: as far from the row above as a column's title is from the top of the page */
s-settings .se-group { display: block; padding-top: @{space.sm}dp; }
/* the bar sits on the settings' darker panel */
s-settings .screen-bar { border-top-color: @{color.black/.35}; }
