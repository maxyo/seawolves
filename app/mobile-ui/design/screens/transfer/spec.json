{
  "tag": "s-transfer",
  "doc": "Loot and exchange with another ship (interface `transfer_main`): cargo, crew and ships tabs (the two ships' figures side by side), the other ship's card in the dock, the game's windows as a modal or a side sheet. Filled by the script interface/touch/screens/transfer/transfer.c through the shapes of its json props.",
  "props": {
    "title": {"type": "text", "default": ""},
    "subject": {"type": "json", "default": null, "shape": {"$of": "c-screen.subject"}},
    "tabs": {"type": "json", "default": [], "shape": {"$of": "c-screen.tabs"}},
    "stats": {"type": "json", "default": [], "shape": {"$of": "c-screen.stats"}},
    "list": {"type": "json", "default": {}, "shape": {"label": "text", "quick": "text", "cols": {"$of": "c-trade-list.cols"}, "rows": {"$of": "c-trade-list.rows"}}},
    "crew": {"type": "json", "default": null, "shape": {"$null": {"label": "text", "cols": {"$of": "c-trade-list.cols"}, "rows": [{"id": "text", "name": "text", "image": {"kind": "text", "icon": "text"}, "cells": [{"text": "text", "sub": "text"}], "selected": "bool", "q": {"value": "int", "min": "int", "max": "int", "zones": "bool", "origin": "int", "lessLabel": "text", "moreLabel": "text", "label": "text", "unit": "text", "summary": "text", "steps": ["int"], "marks": [{"at": "int", "label": "text"}], "disabled": "bool"}}], "sides": [{"name": "text", "morale": "text", "facts": {"$of": "c-kv.items"}}]}}},
    "ships": {"type": "json", "default": null,
             "shape": {"$null": {"ours": {"title": "text", "sub": "text"}, "theirs": {"title": "text", "sub": "text"}, "rows": [{"k": "text", "a": "text", "b": "text", "icon": "text", "tone": "text"}]}}},
    "prize": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "sub": "text", "image": {"$of": "c-object-header.image"}, "facts": {"$of": "c-kv.items"}}}},
    "deal": {"type": "json", "default": null, "shape": {"$of": "c-trade-list.deal"}},
    "dealing": {"type": "bool", "default": false, "class": false},
    "primary": {"type": "json", "default": null,
               "shape": {"$null": {"label": "text", "sub": "text", "disabled": "bool", "reason": "text", "busy": "bool"}}},
    "actions": {"type": "json", "default": [],
               "shape": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]},
    "modal": {"type": "json", "default": null, "shape": {"$null": {"step": "text", "title": "text", "text": "text", "image": "picture", "actions": {"$of": "c-dialog.actions"}, "q": {"value": "int", "min": "int", "max": "int", "unit": "text", "steps": {"$of": "c-quantity.steps"}, "all": "bool", "disabled": "bool"}}}},
    "sheet": {"type": "json", "default": null, "shape": {"$null": {"kind": "text", "title": "text", "closable": "bool", "width": "int", "candidates": {"$of": "c-captain-picker.candidates"}, "empty": "text", "name": "text", "facts": {"$of": "c-captain-picker.facts"}, "skills": {"$of": "c-captain-picker.skills"}, "actions": {"$of": "c-captain-picker.actions"}}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
