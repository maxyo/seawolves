<t-for each="flags" as="f"><div class="sf-hit{{ f.selected ? ' on' : '' }}" data-action="pick" data-value="{{f.id}}" data-disabled?="{{ disabled || f.disabled }}"><c-token icon="{{f.icon}}" enamel="parchment" size="{{spec.token}}" round="1" selected="{{ f.selected ? 1 : 0 }}" disabled="{{ (disabled || f.disabled) && !f.selected ? 1 : 0 }}"/></div></t-for>
