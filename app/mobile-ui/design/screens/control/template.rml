<t-if test="row.kind == 'action'"><c-list-row id="{{row.id}}" icon="" title="{{row.title}}" dense="1" wrap="1" selected="{{ row.selected ? 1 : 0 }}" disabled="{{ row.disabled ? 1 : 0 }}" reason="{{opt(row.reason)}}" busy="{{ row.busy ? 1 : 0 }}" meta-tone="{{ opt(row.muted) ? 'dim' : '' }}" surface="{{surface}}" style="width: 100%"/></t-if>
<t-if test="in(row.kind, 'toggle', 'radio')"><c-setting id="{{row.id}}" control="{{row.kind}}" label="{{row.label}}" on="{{ row.on ? 1 : 0 }}" disabled="{{ row.disabled ? 1 : 0 }}" reason="{{opt(row.reason)}}"/></t-if>
<t-if test="row.kind == 'segment'"><c-setting id="{{row.id}}" control="segment" label="{{row.label}}" options="{{ json(row.options) }}" selected="{{row.selected}}" stack="{{ row.label && len(row.options) > 2 ? 1 : 0 }}" stretch="{{ row.label ? 0 : 1 }}" disabled="{{ row.disabled ? 1 : 0 }}" reason="{{opt(row.reason)}}"/></t-if>
<t-if test="row.kind == 'slider'"><c-setting id="{{row.id}}" control="slider" label="{{row.label}}" value="{{row.value}}" disabled="{{ row.disabled ? 1 : 0 }}" reason="{{opt(row.reason)}}"/></t-if>
<t-if test="row.kind == 'stepper'"><c-setting control="none" label="{{row.label}}"><div class="sc-step"><c-icon-button id="{{row.id}}-left" icon="chevron-left" label="{{ tr('common.previous') }}" disabled="{{ row.left ? 0 : 1 }}"/><div class="sc-value">{{row.text}}</div><c-icon-button id="{{row.id}}-right" icon="chevron-right" label="{{ tr('common.next') }}" disabled="{{ row.right ? 0 : 1 }}"/></div></c-setting></t-if>
<t-if test="row.kind == 'field'"><c-field id="{{row.id}}" label="{{row.label}}" value="{{row.value}}" surface="{{surface}}"/></t-if>
