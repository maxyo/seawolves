/* s-sail-emblem: the emblem ribbon between bare arrows fills the panel; the bar holds the one primary. */
s-sail-emblem { display: block; width: 100%; height: 100%; }
s-sail-emblem .ss-main { flex: 1 1 0; min-width: 0; height: 100%; }
s-sail-emblem .ss-strip { flex: 1 1 0; min-height: 0; display: flex; flex-direction: row; align-items: center; gap: 6dp; padding: 0 6dp; }
s-sail-emblem .ss-ribbon { flex: 1 1 0; min-width: 0; }
s-sail-emblem .ss-note { flex: 0 0 auto; padding: 6dp @{space.lg}dp 0 @{space.lg}dp; }
