/* s-tradebook: the towns take 37 %, the price list the rest. */
s-tradebook { display: block; width: 100%; height: 100%; }
s-tradebook .tk-towns { flex: 0 0 37%; height: 100%; }
s-tradebook .tk-prices { flex: 1 1 0; min-width: 0; height: 100%; }
s-tradebook .tk-note { flex: 0 0 auto; padding: 6dp @{space.lg}dp; }
