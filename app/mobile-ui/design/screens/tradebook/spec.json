      "default": ""
    },
    "towns": {"type": "json", "default": [], "shape": {"$of": "c-table.rows"}},
    "townColumns": {"type": "json", "default": [], "shape": {"$of": "c-table.columns"}},
    "columns": {"type": "json", "default": [], "shape": {"$of": "c-table.columns"}},
    "prices": {"type": "json", "default": [], "shape": {"$of": "c-table.rows"}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
