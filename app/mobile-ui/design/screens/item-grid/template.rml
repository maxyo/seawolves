<t-if test="len(rows) == 0"><div class="ig-empty">{{empty}}</div></t-if>
<t-for each="rows" as="r"><div{{{ r.selected ? ' data-reveal="' + r.id + '"' : '' }}} class="ig-row{{ r.selected ? ' sel' : '' }}" data-action="row" data-value="{{r_i}}" data-item-id="{{r.id}}">
<div class="ig-pic"><c-row-image image="{{ json(r.cells[0].image) }}" icon="{{ r.cells[0].image ? '' : 'chest' }}" size="{{spec.picture}}" icon-size="22" tone="brass" label="{{r.cells[0].text}}"/></div>
<ui-clamp class="ig-name" lines="2" min-size="@{type.min}" text="{{r.cells[0].text}}"/>
<t-if test="opt(r.cells[0].badge)"><c-icon icon="{{ opt(r.cells[0].badge) == 'check' ? 'check' : 'quest' }}" size="14" tone="{{ opt(r.cells[0].badge) == 'check' ? 'green' : 'gold' }}"/></t-if>
<t-if test="r.cells[1]"><div class="ig-count">{{r.cells[1]}}</div></t-if>
</div></t-for>
