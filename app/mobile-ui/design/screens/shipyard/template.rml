<c-screen id="header" key="header" title="{{title}}" subject="{{ json(subject) }}" stats="{{ json(stats) }}" actions="{{ json(extras.actions) }}">
<div class="sy-left"><c-panel pad="0" gap="0" style="width: 100%; height: 100%"><div class="sy-list">
<c-label class="sy-sec" text="{{ tr('yard.ours') }}"/>
<t-for each="fleet" as="f"><c-list-row id="{{f.id}}" image="{{ json(f.image) }}" icon="{{f.icon}}" title="{{f.title}}" meta="{{f.meta}}" value="{{f.value}}" value-tone="dim" selected="{{ f.selected ? 1 : 0 }}" disabled="{{ f.disabled ? 1 : 0 }}" style="width: 100%"/></t-for>
<c-label class="sy-sec" text="{{ tr('yard.offers') }}"/>
<t-for each="offers" as="o"><c-list-row id="{{o.id}}" image="{{ json(o.image) }}" icon="ship" title="{{o.title}}" meta="{{o.meta}}" value="{{o.value}}" selected="{{ o.selected ? 1 : 0 }}" disabled="{{ o.disabled ? 1 : 0 }}" reason="{{o.reason}}" style="width: 100%"/></t-for>
<t-if test="noOffers"><div class="sy-empty-text sy-none">{{noOffers}}</div></t-if>
<t-if test="extras.note"><div class="sy-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if>
</div></c-panel></div>
<div class="sy-right"><c-panel gap="6" style="width: 100%; height: 100%">
<t-if test="detail"><c-object-header image="{{ json(detail.image) }}" icon="ship" size="48" title="{{detail.title}}" sub="{{ detail.against ? detail.sub + ' · ' + tr('yard.against') + ' «' + detail.against + '»' : detail.sub }}" style="width: 100%"/>
<div class="sy-scroll"><div class="sy-stats"><t-for each="detail.facts" as="f"><div class="sy-stat"><c-icon icon="{{f.icon}}" size="20" tone="brass"/><div class="sy-stat-text"><div class="sy-stat-k">{{f.k}}</div><div class="sy-stat-v"><span class="{{ opt(f.tone) ? 'tone-' + opt(f.tone) : '' }}">{{f.v}}</span><t-if test="opt(f.own)"><span class="sy-stat-own">{{opt(f.own)}}</span></t-if></div></div></div></t-for></div>
<t-if test="detail.text"><div class="sy-text">{{detail.text}}</div></t-if></div>
<t-if test="len(detail.actions) > 0"><div class="sy-bar"><t-for each="detail.actions" as="a"><c-button id="{{a.id}}" variant="{{a.variant}}" label="{{a.label}}" sub="{{a.sub}}" hold="{{ a.hold ? 1 : 0 }}" disabled="{{ a.disabled ? 1 : 0 }}" reason="{{a.reason}}" busy="{{ a.busy ? 1 : 0 }}" style="flex: 1 1 0; min-width: 0"/></t-for></div></t-if>
<t-else/><div class="sy-empty"><c-icon icon="shipyard" size="40" tone="brass"/><div class="sy-empty-text">{{empty}}</div></div></t-if>
</c-panel></div>
<t-if test="sheet"><c-dialog id="sheet" key="sheet" variant="sheet" tone="{{ or(sheet.tone, 'wood') }}" title="{{sheet.title}}" subtitle="{{opt(sheet.subtitle)}}" text="{{opt(sheet.text)}}" closable="{{ opt(sheet.closable) ? 1 : 0 }}" width="{{ or(sheet.width, 420) }}" actions="{{ sheet.kind == 'captain' ? '[]' : json(sheet.actions) }}">
<t-if test="sheet.kind == 'repair'"><t-for each="sheet.parts" as="p"><c-quantity id="{{p.id}}" props="{{ json(p.q) }}" style="width: 100%"/></t-for></t-if>
<t-if test="sheet.kind == 'cannons'"><div class="sy-plan"><div class="sy-gun row"><div class="sy-gun-n">{{sheet.starboard.value}}</div><div class="sy-gun-k">{{sheet.starboard.label}}</div></div><div class="sy-plan-mid"><div class="sy-gun end"><div class="sy-gun-n">{{sheet.bow.value}}</div><div class="sy-gun-k">{{sheet.bow.label}}</div></div><div class="sy-deck"><t-if test="sheet.plan"><ui-game-image texture="{{sheet.plan.texture}}" uv="{{sheet.plan.uv}}" fit="contain"/></t-if></div><div class="sy-gun end"><div class="sy-gun-n">{{sheet.stern.value}}</div><div class="sy-gun-k">{{sheet.stern.label}}</div></div></div><div class="sy-gun row"><div class="sy-gun-n">{{sheet.port.value}}</div><div class="sy-gun-k">{{sheet.port.label}}</div></div></div></t-if>
<t-if test="sheet.kind == 'captain'"><c-captain-picker candidates="{{ json(sheet.candidates) }}" empty="{{sheet.empty}}" name="{{sheet.name}}" facts="{{ json(sheet.facts) }}" skills="{{ json(sheet.skills) }}" actions="{{ json(sheet.actions) }}"/></t-if>
</c-dialog></t-if>
<s-extras id="extras" extras="{{ json(extras) }}"/>
</c-screen>
