{
  "tag": "s-hero",
  "doc": "Hero section «Персонаж» (interface lscchar_all) and the card of another character (interface character), filled by the script interface/touch/screens/hero/character.c through the shapes of its json props.",
  "props": {
    "title": {
      "type": "text",
      "default": ""
    },
    "headerSection": {
      "type": "text",
      "default": ""
    },
    "tabs": {"type": "json", "default": [], "shape": {"$of": "c-screen.tabs"}},
    "tab": {
      "type": "text",
      "default": "skills"
    },
    "subject": {"type": "json", "default": null, "shape": {"$of": "c-screen.subject"}},
    "card": {"type": "json", "default": {}, "shape": {"title": "text", "sub": "text", "roles": "text", "portrait": "picture", "health": {"$of": "c-hero-card.health"}, "energy": {"$of": "c-hero-card.energy"}, "free": "text", "lines": {"$of": "c-hero-card.lines"}, "actions": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]}},
    "special": {"type": "json", "default": {}, "shape": {"columns": {"$of": "c-table.columns"}, "rows": {"$of": "c-table.rows"}}},
    "personal": {"type": "json", "default": {}, "shape": {"columns": {"$of": "c-table.columns"}, "rows": {"$of": "c-table.rows"}}},
    "ship": {"type": "json", "default": {}, "shape": {"columns": {"$of": "c-table.columns"}, "rows": {"$of": "c-table.rows"}}},
    "points": {
      "type": "bool",
      "default": false,
      "class": false
    },
    "perksEmpty": {
      "type": "text",
      "default": ""
    },
    "tree": {"type": "json", "default": null, "shape": {"$of": "s-perk-tree.tree"}},
    "perkInfo": {
      "type": "text",
      "default": ""
    },
    "perkInfoNudge": {
      "type": "bool",
      "default": false,
      "class": false
    },
    "detail": {"type": "json", "default": null, "shape": {"$of": "s-perk-detail.detail"}},
    "posts": {"type": "json", "default": [], "shape": [{"id": "text", "name": "text", "meta": "text", "image": {"$of": "c-list-row.image"}, "selected": "bool"}]},
    "postsCount": {
      "type": "text",
      "default": ""
    },
    "freePosts": {
      "type": "json",
      "default": [],
      "shape": [
        {
          "id": "text",
          "role": "text",
          "icon": "text",
          "selected": "bool"
        }
      ]
    },
    "passengers": {"type": "json", "default": [], "shape": [{"name": "text", "meta": "text", "image": {"$of": "c-list-row.image"}}]},
    "passengersCount": {
      "type": "text",
      "default": ""
    },
    "dialog": {"type": "json", "default": null, "shape": {"$null": {"kind": "text", "title": "text", "subtitle": "text", "text": "text", "facts": {"$of": "c-kv.items"}, "steps": {"$of": "c-kv.items"}, "actions": {"$of": "c-dialog.actions"}, "rows": [{"id": "text", "name": "text", "meta": "text", "value": "text", "image": {"$of": "c-list-row.image"}, "busy": "bool"}], "empty": "text"}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  },
  "constants": {
    "lineMin": 240,
    "specialMin": 176
  }
}
