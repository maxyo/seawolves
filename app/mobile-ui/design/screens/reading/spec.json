{
  "tag": "s-reading",
  "doc": "Reading cards over the game (interfaces `map`, `dirsailenc`, `leavebattle`, `salary`), news notices (`colonyinfo`, `nationlegend`), the interlude `boal_frame` and nothing at all for `fortcapture`, which the game closes at once, filled by the script interface/touch/screens/reading.c through the shapes of its json props.",
  "props": {
    "mode": {
      "type": "enum",
      "options": [
        "card",
        "notice",
        "frame",
        "none"
      ],
      "default": "card"
    },
    "title": {
      "type": "text",
      "default": ""
    },
    "icon": {
      "type": "text",
      "default": ""
    },
    "text": {
      "type": "text",
      "default": ""
    },
    "flags": {
      "type": "json",
      "default": [],
      "shape": [{"icon": "text", "word": "text", "tone": "text"}]
    },
    "actions": {
      "type": "json",
      "default": [],
      "shape": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool",
                 "sub": "text"}]
    },
    "extras": {
      "type": "json",
      "default": {}
    },
    "picture": {
      "type": "json",
      "default": null,
      "shape": "texture"
    }
  }
}
