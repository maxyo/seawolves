<t-if test="mode == 'frame'"><s-interlude id="frame" text="{{text}}" picture="{{ json(picture) }}"/></t-if>
<t-if test="mode == 'card'"><c-dialog id="card" key="card" tone="parchment" icon="{{icon}}" title="{{title}}" text="{{text}}" width="480" actions="{{ json(actions) }}"/></t-if>
<t-if test="mode == 'notice'"><c-dialog id="card" key="card" tone="parchment" title="{{title}}" closable="1" variant="{{ len(flags) > 1 ? 'top' : 'center' }}" width="{{ len(flags) > 1 ? 430 : 460 }}" actions="{{ json(actions) }}"><t-if test="len(flags) > 1"><div class="rd-news"><div class="rd-flags"><t-for each="flags" as="f"><div class="rd-flag{{ opt(f.word) ? ' word ' + f.tone : '' }}"><c-icon icon="{{f.icon}}" size="{{ opt(f.word) ? 26 : 32 }}" tone="{{ opt(f.word) ? 'ink' : 'color' }}"/><t-if test="opt(f.word)"><span>{{opt(f.word)}}</span></t-if></div></t-for></div><div class="rd-notice-text">{{text}}</div></div><t-else/><div class="rd-notice"><t-if test="len(flags) > 0"><c-icon icon="{{flags[0].icon}}" size="56" tone="color"/></t-if><div class="rd-notice-text">{{text}}</div></div></t-if></c-dialog></t-if>
<t-if test="mode == 'page'"><c-screen id="header" key="header" title="{{title}}" actions="{{ json(extras.actions) }}"><div class="rd-page"><c-panel tone="parchment" aged="1" pad="0" gap="0" style="width: 100%; height: 100%"><div class="rd-scroll"><div class="rd-page-text">{{text}}</div></div>
<div class="screen-bar"><t-if test="check"><div class="rd-check"><c-setting id="check" control="check" label="{{check.label}}" on="{{ check.on ? 1 : 0 }}" line="0" disabled="{{ check.disabled ? 1 : 0 }}" reason="{{check.reason}}"/></div></t-if><div class="grow"></div><t-for each="actions" as="a"><c-button id="{{a.id}}" variant="{{a.variant}}" label="{{a.label}}" disabled="{{ a.disabled ? 1 : 0 }}" reason="{{a.reason}}" busy="{{ a.busy ? 1 : 0 }}" style="width: 150dp"/></t-for></div>
<t-if test="extras.note"><s-note id="extras-note" text="{{extras.note}}"/></t-if></c-panel></div><s-extras id="extras" extras="{{ json(extras) }}"/></c-screen><t-else/>
<t-if test="extras.note"><div class="rd-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if>
<t-if test="len(extras.actions) > 0"><div class="rd-more"><c-icon-button id="extras-more" icon="more" label="{{ tr('common.other') }}"/></div></t-if>
<s-extras id="extras" extras="{{ json(extras) }}"/></t-if>
