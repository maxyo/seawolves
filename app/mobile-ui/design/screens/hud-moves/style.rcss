/* s-hud-moves: the sword-move wheel, centred on the strike button by the HUD layout. */
s-hud-moves { display: block; position: relative; pointer-events: none; }
s-hud-moves .hm-wheel { display: block; position: absolute; left: 0; top: 0; width: @{spec.size}dp; height: @{spec.size}dp;
    wheel-fill: @{color.hudGhost/.9}; wheel-selected: @{color.brassDeep/.97}; wheel-line: @{color.brassLine/.45};
    wheel-edge: @{color.brassEdge}; wheel-centre: @{color.hudCombatLow/.95}; }
s-hud-moves .hm-move { display: block; }
s-hud-moves .hm-caption { position: absolute; left: 0; right: 0; top: -34dp; height: @{spec.captionHeight}dp; text-align: center; white-space: nowrap;
    font-size: @{type.name}dp; font-weight: bold; color: @{color.textSelected};
    font-effect: shadow(0dp 1dp @{color.black}), glow(4dp @{color.black/.8}); }
