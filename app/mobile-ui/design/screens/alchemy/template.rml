<c-screen id="header" key="header" title="{{title}}" actions="{{ json(extras.actions) }}">
<div class="al-left"><c-panel pad="0" gap="0" style="width: 100%; height: 100%"><div class="al-list"><c-trade-list id="recipes" label-icon="scroll" label="{{recipes.label}}" cols="[]" rows="{{ json(recipes.rows) }}" style="flex: 1 1 0; height: auto"/></div></c-panel></div>
<div class="al-right"><c-panel pad="0" gap="0" style="width: 100%; height: 100%">
<t-if test="recipe"><div class="al-card"><c-object-header title="{{recipe.title}}" sub="{{recipe.sub}}" image="{{ json(recipe.image) }}" icon="potion" title-size="20" sub-size="15" style="flex: 1 1 0"/><t-if test="recipe.info"><c-icon-button id="info" icon="info" label="{{ tr('common.description') }}" look="bare"/></t-if></div></t-if>
<div class="al-parts"><c-trade-list id="parts" row-tap="0" label="{{parts.label}}" cols="{{ json(parts.cols) }}" rows="{{ json(parts.rows) }}" style="flex: 1 1 0; height: auto"/></div>
<t-if test="extras.note"><div class="al-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if>
<t-if test="q"><div class="al-q"><c-quantity id="batches" props="{{ json(q) }}" style="width: 100%"/></div></t-if>
<t-if test="primary"><div class="screen-bar"><div class="grow"></div><c-button id="primary" variant="primary" label="{{primary.label}}" sub="{{primary.sub}}" disabled="{{ primary.disabled ? 1 : 0 }}" reason="{{primary.reason}}" busy="{{ primary.busy ? 1 : 0 }}" style="width: 260dp"/></div></t-if>
</c-panel></div>
<s-extras id="extras" extras="{{ json(extras) }}"/>
</c-screen>
