<c-screen id="header" key="header" title="{{title}}" subject="{{ json(subject) }}" stats="{{ json(stats) }}" actions="{{ json(extras.actions) }}">
<div class="sw-main"><c-panel pad="0" gap="0" style="width: 100%; height: 100%">
<div class="sw-list"><c-trade-list id="crew" label-icon="crew" label="{{list.label}}" cols="{{ json(list.cols) }}" rows="{{ json(list.rows) }}" style="height: auto"/></div>
<div class="sw-detail"><div class="sw-cols"><div class="sw-col"><c-label text="{{shipLabel}}"/><t-for each="ship.groups" as="g"><c-stat-row label="{{g.label}}" value="{{g.value}}" word="{{g.word}}" kind="crew" height="24" style="width: 100%"/></t-for><c-stat-row label="{{ship.moraleLabel}}" value="{{ship.morale}}" word="{{ship.moraleWord}}" kind="brass" height="24" line="0" style="width: 100%"/></div><div class="sw-col"><c-label text="{{tavernLabel}}"/><t-for each="tavern.groups" as="g"><c-stat-row label="{{g.label}}" value="{{g.value}}" word="{{g.word}}" kind="crew" height="24" style="width: 100%"/></t-for><c-stat-row label="{{tavern.moraleLabel}}" value="{{tavern.morale}}" word="{{tavern.moraleWord}}" kind="brass" height="24" line="0" style="width: 100%"/></div></div><t-if test="notes"><div class="sw-notes">{{notes}}</div></t-if></div>
<t-if test="extras.note"><div class="sw-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if>
<t-if test="primary"><div class="screen-bar"><div class="grow"></div><c-button id="primary" variant="primary" label="{{primary.label}}" sub="{{primary.sub}}" disabled="{{ primary.disabled ? 1 : 0 }}" reason="{{primary.reason}}" busy="{{ primary.busy ? 1 : 0 }}" style="width: 240dp"/></div></t-if>
</c-panel></div>
<s-extras id="extras" extras="{{ json(extras) }}"/>
</c-screen>
