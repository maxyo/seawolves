{
  "tag": "s-crew",
  "doc": "Crew hire (interface `hirecrew`), filled by the script interface/touch/screens/crew.c through the shapes of its json props.",
  "props": {
    "title": {"type": "text", "default": ""},
    "subject": {"type": "json", "default": null, "shape": {"$of": "c-screen.subject"}},
    "stats": {"type": "json", "default": [], "shape": {"$of": "c-screen.stats"}},
    "list": {"type": "json", "default": {}, "shape": {"label": "text", "cols": {"$of": "c-trade-list.cols"}, "rows": [{"id": "text", "name": "text", "image": {"kind": "text", "icon": "text"}, "meta": "text", "cells": [{"$either": ["text", {"text": "text", "bold": "bool"}]}], "selected": "bool", "q": {"value": "int", "min": "int", "max": "int", "zones": "bool", "origin": "int", "lessLabel": "text", "moreLabel": "text", "label": "text", "allLabel": "text", "summary": "text", "steps": ["int"], "disabled": "bool"}}]}},
    "shipLabel": {"type": "text", "default": ""},
    "tavernLabel": {"type": "text", "default": ""},
    "ship": {"type": "json", "default": {"groups": []},
            "shape": {"groups": [{"label": "text", "value": "int", "word": "text"}], "moraleLabel": "text", "morale": "int", "moraleWord": "text"}},
    "tavern": {"type": "json", "default": {"groups": []},
              "shape": {"groups": [{"label": "text", "value": "int", "word": "text"}], "moraleLabel": "text", "morale": "int", "moraleWord": "text"}},
    "notes": {"type": "text", "default": ""},
    "primary": {"type": "json", "default": null,
               "shape": {"$null": {"label": "text", "sub": "text", "disabled": "bool", "reason": "text", "busy": "bool"}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
