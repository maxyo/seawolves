<div class="se-scroll"><div class="se-ribbon"><t-for each="items" as="e" key="or(e.id, e_i)"><div class="se-card{{ e.selected ? ' sel' : '' }}" data-action="emblem" data-value="{{ or(e.id, e_i) }}" data-disabled?="{{ e.disabled }}">
<c-game-image kind="emblem" texture="{{e.texture}}" size="{{size}}" label="{{e.label}}" selected="{{ e.selected ? 1 : 0 }}" disabled="{{ e.disabled ? 1 : 0 }}"/>
<div class="se-cap">{{ e.applied ? appliedLabel : '' }}</div>
</div></t-for></div></div><div class="se-fade"></div>
