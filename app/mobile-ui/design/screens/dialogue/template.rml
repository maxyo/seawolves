<div class="sd-sheet replies-{{ len(replies) > 4 ? 'many' : len(replies) > 2 ? 'some' : 'few' }}" data-grow="1"><c-dialogue-panel key="dialogue" mode="paged" page="{{page}}" seed="23" speaker="{{speaker}}" text="{{text}}" replies="{{ json(replies) }}"/></div>
<t-if test="edit"><t-if test="edit.kind == 'number'"><c-dialog id="edit" key="edit" variant="center" tone="wood" edge="1" width="600" title="{{edit.title}}" subtitle="{{ edit.money >= 0 ? tr('dialogue.money') + ' ' + num(edit.money) : '' }}" actions="{{ json(edit.actions) }}"><c-quantity id="edit-amount" value="{{edit.value}}" min="0" max="{{edit.max}}" all="1" all-label="{{ tr('dialogue.max') }}" surface="wood"/><t-if test="edit.error"><div class="sd-error">{{edit.error}}</div></t-if></c-dialog><t-else/><c-dialog id="edit" key="edit" variant="top" tone="parchment" aged="1" seed="31" width="600" title="{{edit.title}}" actions="{{ json(edit.actions) }}"><c-field id="edit-field" class="sd-field" surface="parchment" value="{{edit.value}}" placeholder="{{edit.title}}" error="{{edit.error}}" focused="1" disabled="{{ opt(edit.sent) ? 1 : 0 }}"/></c-dialog></t-if></t-if>
