<div class="tp-row{{ below ? ' below' : '' }}"><div class="tp-pieces" style="gap: {{ size * 0.23 }}dp;"><t-for each="pieces" as="p"><div class="tp-cell">
<div class="tp-piece tp-{{p.kind}}{{ opt(p.lift) ? ' lift' : '' }}{{ opt(p.disabled) ? ' dim' : '' }}" style="width: {{ p.kind == 'card' || p.kind == 'back' || p.kind == 'deck' ? size * 0.74 : p.kind == 'cup' ? size : size }}dp; height: {{ p.kind == 'cup' ? size * 1.15 : size }}dp;{{ p.kind == 'cup' ? '' : ' border-radius: ' + (p.kind == 'die' ? size * 0.18 : size * 0.07) + 'dp;' }} transform: {{ opt(p.lift) ? 'translateY(-' + size * 0.2 + 'dp) ' : '' }}rotate({{ or(p.rot, 0) }}deg);" data-action?="{{ opt(p.action) }}" data-value?="{{ opt(p.action) ? str(p.value) : '' }}" data-disabled?="{{ opt(p.action) && p.disabled }}" data-reason?="{{ opt(p.action) && p.disabled ? str(p.reason) : '' }}">
<t-if test="p.kind == 'die'"><t-for each="p.pips" as="d"><div class="tp-pip" style="left: {{d[0]}}%; top: {{d[1]}}%; width: {{ size * 0.17 }}dp; height: {{ size * 0.17 }}dp; margin-left: -{{ size * 0.085 }}dp; margin-top: -{{ size * 0.085 }}dp; border-radius: {{ size * 0.085 }}dp;"></div></t-for></t-if>
<t-if test="p.kind == 'card'"><div class="tp-corner {{ p.red ? 'red' : '' }}" style="font-size: {{ size * 0.26 }}dp;"><div class="tp-rank">{{p.rank}}</div><div class="tp-small"><c-icon icon="suit-{{p.suit}}" size="{{ size * 0.16 }}" tone="{{ p.red ? 'wax' : 'inkDeep' }}"/></div></div><div class="tp-big"><c-icon icon="suit-{{p.suit}}" size="{{ size * 0.36 }}" tone="{{ p.red ? 'wax' : 'inkDeep' }}"/></div></t-if>
<t-if test="p.kind == 'back' || p.kind == 'deck'"><div class="tp-face"><div class="tp-mark" style="width: {{ size * 0.2 }}dp; height: {{ size * 0.2 }}dp; margin-left: -{{ size * 0.1 }}dp; margin-top: -{{ size * 0.1 }}dp;"></div></div></t-if>
<t-if test="p.kind == 'cup'"><div class="tp-mouth"></div></t-if>
</div>
</div></t-for></div>
<t-if test="label"><div class="tp-label">{{label}}</div></t-if></div>
