/* s-pieces: dice, cards, the cup and the deck of the tavern mini-games, drawn with our own shapes. */
s-pieces { display: block; }
s-pieces .tp-row { display: flex; flex-direction: row; align-items: center; }
s-pieces .tp-row.below { flex-direction: column; gap: 8dp; }
s-pieces .tp-pieces { display: flex; flex-direction: row; align-items: flex-end; gap: 14dp; }
s-pieces .tp-cell { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 4dp; }
s-pieces .tp-piece { position: relative; box-sizing: border-box; flex: 0 0 auto; shadow: @{color.black/.55} 0 3dp 6dp 0; }
s-pieces .tp-die { border: 1dp @{color.brassLow}; decorator: linear-gradient(145deg, @{color.paperLight}, @{color.paperBottom}); }
s-pieces .tp-die.lift { border: 2dp @{color.brass}; shadow: @{color.brass} 0 0 0 2dp, @{color.brassGlow/.6} 0 0 14dp 0, @{color.black/.55} 0 10dp 14dp 0; }
s-pieces .tp-pip { position: absolute; background-color: @{color.inkAged}; }
s-pieces .tp-card { border: 1dp @{color.brassLow}; decorator: linear-gradient(160deg, @{color.paperLight}, @{color.paperTop}); }
s-pieces .tp-corner { position: absolute; left: 8%; top: 4%; font-weight: bold; line-height: 1.05; color: @{color.inkDeep}; display: flex; flex-direction: column; align-items: center; }
s-pieces .tp-corner.red { color: @{color.dangerDeep}; }
s-pieces .tp-big { position: absolute; right: 12%; bottom: 10%; }
s-pieces .tp-back, s-pieces .tp-deck { border: 2dp @{color.brassLine}; background-color: @{color.paperTop}; }
s-pieces .tp-face { position: absolute; left: 6%; top: 5%; right: 6%; bottom: 5%; border: 1dp @{color.brassLine/.6};
    decorator: repeating-linear-gradient(135deg, @{color.woodDeep} 0dp, @{color.woodDeep} 6dp, @{color.woodSelected} 6dp, @{color.woodSelected} 12dp); }
s-pieces .tp-deck { shadow: @{color.paperBottom} -3dp -3dp 0 0, @{color.brassLine} -4dp -4dp 0 0, @{color.paperBottom} -6dp -6dp 0 0, @{color.black/.55} 0 3dp 6dp 0; }
s-pieces .tp-mark { position: absolute; left: 50%; top: 50%; border: 2dp @{color.brass}; background-color: @{color.woodDeep}; transform: rotate(45deg); }
s-pieces .tp-cup { border: 2dp @{color.brassMid}; border-radius: 10dp 10dp 34dp 34dp; decorator: linear-gradient(90deg, @{color.inkAged}, @{color.paperShade} 45%, @{color.inkAged}); }
s-pieces .tp-mouth { position: absolute; left: 0; right: 0; top: 0; height: 8dp; border-radius: 8dp 8dp 0 0; background-color: @{color.inkDeep/.7}; }
s-pieces .tp-piece.dim { opacity: 0.85; }
s-pieces .tp-label { flex: 0 0 auto; margin-left: 30dp; font-size: @{type.body}dp; font-weight: bold; color: @{color.text}; font-effect: shadow(0dp 1dp @{color.black/.8}); white-space: nowrap; }
s-pieces .tp-row.below .tp-label { margin-left: 0; }
