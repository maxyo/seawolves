/* s-saves: the records take the width; the detail column keeps a fixed size and tablets widen the list. */
s-saves { display: block; width: 100%; height: 100%; }
s-saves .sv-list { flex: 1 1 0; min-width: 0; height: 100%; }
s-saves .sv-side { flex: 0 0 280dp; height: 100%; }
s-saves .sv-note { flex: 0 0 auto; padding: 6dp @{space.lg}dp 6dp @{space.lg}dp; }
s-saves .sv-grow { flex: 1 1 0; }
/* The thumbnail sits above the record's name in the space the column has left (48..128dp, the
   game's square picture kept whole), so the name and facts keep the whole column width; the hero
   keeps one line so a long name cannot squeeze the picture away. */
s-saves .sv-preview { position: relative; flex: 1000 1 0; min-height: 48dp; max-height: 128dp; }
s-saves .sv-side c-object-header .oh-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
s-saves .sv-actions { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; gap: @{space.lg}dp; }
