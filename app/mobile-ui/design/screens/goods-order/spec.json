{
  "tag": "s-goods-order",
  "doc": "The treasurer's purchase list (goodstransfer): what to buy per good for the selected ship. Filled by the script interface/touch/screens/goods_order.c through the shapes of its json props.",
  "props": {
    "title": {"type": "text", "default": ""},
    "subject": {"type": "json", "default": null,
               "shape": {"$null": {"label": "text", "sub": "text", "prev": "bool", "next": "bool", "list": "bool"}}},
    "list": {"type": "json", "default": {},
            "shape": {"label": "text", "cols": [{"label": "text", "icon": "text"}], "rows": [{"id": "text", "name": "text", "image": "picture", "cells": ["text"], "selected": "bool", "disabled": "bool", "reason": "text", "q": {"value": "int", "min": "int", "max": "int", "label": "text", "unit": "text", "summary": "text", "all": "bool", "disabled": "bool", "reason": "text"}}]}},
    "contraband": {"type": "json", "default": null,
                  "shape": {"$null": {"label": "text", "on": "bool", "disabled": "bool", "reason": "text"}}},
    "primary": {"type": "json", "default": null,
               "shape": {"$null": {"label": "text", "sub": "text", "disabled": "bool", "reason": "text", "busy": "bool"}}},
    "actions": {"type": "json", "default": [],
               "shape": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]},
    "extras": {"type": "json", "default": {}}
  }
}
