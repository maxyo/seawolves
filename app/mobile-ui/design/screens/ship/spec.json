{
  "tag": "s-ship",
  "doc": "Hero section «Корабль» (interface ship), filled by the script interface/touch/screens/hero/ship.c through the shapes of its json props: three tabs over the one game window. «Обзор»: the ship card and the game's figures, the guns row opening the guns' window as a sheet; «Команда»: the crew, its quality and morale, food and upkeep, the shares and the morale's raise; «Трюм»: the goods, the open one with the game's overboard window as its amount. The game's questions are dialogs.",
  "props": {
    "title": {"type": "text", "default": ""},
    "headerSection": {"type": "text", "default": ""},
    "tabs": {"type": "json", "default": [], "shape": [{"id": "text", "label": "text", "selected": "bool"}]},
    "tab": {"type": "text", "default": "overview"},
    "subject": {"type": "json", "default": null,
               "shape": {"$null": {"label": "text", "sub": "text", "prev": "bool", "next": "bool", "list": "bool", "open": "bool", "title": "text",
                                   "rows": [{"id": "text", "label": "text", "meta": "text", "image": "picture", "icon": "text", "selected": "bool"}]}}},
    "card": {"type": "json", "default": {},
            "shape": {"title": "text", "sub": "text", "captain": "text", "rename": "bool", "image": "picture",
                      "hull": {"value": "int", "text": "text"}, "sails": {"value": "int", "text": "text"},
                      "crew": {"value": "int", "text": "text", "mark": "int"},
                      "exchange": {"$null": {"id": "text", "label": "text", "busy": "bool"}}}},
    "left": {"type": "json", "default": [],
            "shape": [{"id": "text", "cells": [{"$either": ["text", {"text": "text", "icon": "text", "lines": "int", "sub": "text", "bold": "bool"}]}]}]},
    "right": {"type": "json", "default": [],
             "shape": [{"id": "text", "cells": [{"$either": ["text", {"text": "text", "icon": "text", "lines": "int", "sub": "text", "bold": "bool"}]}]}]},
    "empty": {"type": "text", "default": ""},
    "crew": {"type": "json", "default": null,
            "shape": {"$null": {"count": "text", "limits": "text", "value": "int", "mark": "int",
                                "groups": [{"label": "text", "value": "int", "word": "text"}],
                                "moraleLabel": "text", "morale": "int", "moraleWord": "text"}}},
    "facts": {"type": "json", "default": [], "shape": [{"icon": "text", "title": "text", "meta": "text"}]},
    "crewActions": {"type": "json", "default": [],
                   "shape": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]},
    "list": {"type": "json", "default": {},
            "shape": {"label": "text", "cols": [{"label": "text", "icon": "text", "w": "int"}],
                      "rows": [{"id": "text", "name": "text", "meta": "text", "image": "picture", "cells": ["text"], "disabled": "bool",
                                "reason": "text", "selected": "bool",
                                "q": {"value": "int", "min": "int", "max": "int", "label": "text", "summary": "text", "all": "bool", "disabled": "bool"}}]}},
    "load": {"type": "json", "default": {}, "shape": {"value": "int", "after": "int", "text": "text"}},
    "cargoActions": {"type": "json", "default": [],
                    "shape": [{"id": "text", "label": "text", "variant": "text", "hold": "bool", "disabled": "bool", "reason": "text", "busy": "bool"}]},
    "dialog": {"type": "json", "default": null,
              "shape": {"$null": {"kind": "text", "title": "text", "text": "text", "groups": [{"items": [{"k": "text", "v": "text"}]}],
                                  "actions": [{"id": "text", "label": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]}}},
    "sheet": {"type": "json", "default": null,
             "shape": {"$null": {"title": "text", "subtitle": "text",
                                 "calibres": {"label": "text", "count": "text", "empty": "text",
                                              "rows": [{"id": "text", "cells": [{"$either": ["text", {"text": "text", "sub": "text", "image": "picture"}]}], "selected": "bool"}]},
                                 "sides": [{"id": "text", "q": {"value": "int", "min": "int", "max": "int", "label": "text", "steps": ["int"], "all": "bool", "dense": "bool", "disabled": "bool"}}],
                                 "actions": [{"id": "text", "label": "text", "sub": "text", "variant": "text", "disabled": "bool", "reason": "text", "busy": "bool"}]}}},
    "extras": {"type": "json", "default": {}}
  }
}
