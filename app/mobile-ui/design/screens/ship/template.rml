<c-screen id="header" key="header" title="{{title}}" sections="{{headerSection}}" tabs="{{ json(tabs) }}" subject="{{ json(subject) }}" actions="{{ json(extras.actions) }}">
<div class="sh-cols"><t-if test="tab == 'overview'"><div class="sh-rail"><c-ship-card title="{{card.title}}" sub="{{card.sub}}" captain="{{card.captain}}" rename="{{ card.rename ? 1 : 0 }}" image="{{ json(card.image) }}" hull="{{ json(opt(card.hull)) }}" crew="{{ json(opt(card.crew)) }}" sails="{{ json(opt(card.sails)) }}" class="sh-card"><t-if test="card.exchange"><c-button id="{{card.exchange.id}}" label="{{card.exchange.label}}" icon="exchange" variant="secondary" busy="{{ card.exchange.busy ? 1 : 0 }}" style="width: 100%"/></t-if></c-ship-card></div>
<c-panel class="sh-main" tone="parchment" pad="0" gap="0"><t-if test="empty"><div class="sh-empty">{{empty}}</div><t-else/><div class="sh-stats">
<div class="sh-col"><c-table id="stats-left" surface="parchment" interactive="0" columns='[{"label": "", "w": "1fr"}, {"label": "", "w": "auto", "align": "right"}]' rows="{{ json(left) }}" row-height="48" fade="0"/></div>
<div class="sh-col"><c-table id="stats-right" surface="parchment" columns='[{"label": "", "w": "1fr"}, {"label": "", "w": "auto", "align": "right"}]' rows="{{ json(right) }}" row-height="48" fade="0"/></div>
</div></t-if><t-if test="extras.note"><div class="sh-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if></c-panel></t-if>
<t-if test="tab == 'crew'"><c-panel class="sh-main" pad="0" gap="0"><t-if test="crew">
<div class="sh-crewhead"><c-icon icon="crew" size="32"/><div class="sh-count">{{crew.count}}</div><div class="sh-limits">{{crew.limits}}</div><c-bar kind="crew" value="{{crew.value}}" mark="{{crew.mark}}" class="sh-crewbar"/></div>
<t-for each="crew.groups" as="g"><div class="sh-pad"><c-stat-row label="{{g.label}}" value="{{g.value}}" word="{{g.word}}" kind="crew" height="48" style="width: 100%"/></div></t-for>
<div class="sh-pad sh-morale"><c-stat-row label="{{crew.moraleLabel}}" value="{{crew.morale}}" word="{{crew.moraleWord}}" kind="brass" height="52" line="0" style="width: 100%"/></div>
<t-else/><div class="sh-empty">{{empty}}</div></t-if><t-if test="extras.note"><div class="sh-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if></c-panel>
<c-panel class="sh-side" pad="0" gap="0"><t-for each="facts" as="f"><c-list-row icon="{{f.icon}}" title="{{f.title}}" meta="{{f.meta}}" wrap="1" style="width: 100%; pointer-events: none;"/></t-for><div class="sh-grow"></div>
<div class="sh-acts"><t-for each="crewActions" as="a"><c-button id="{{a.id}}" label="{{a.label}}" variant="{{a.variant}}" disabled="{{ a.disabled ? 1 : 0 }}" reason="{{opt(a.reason)}}" busy="{{ a.busy ? 1 : 0 }}" style="width: 100%"/></t-for></div></c-panel></t-if>
<t-if test="tab == 'cargo'"><c-panel class="sh-full" pad="0" gap="0"><div class="sh-list"><t-if test="empty"><div class="sh-empty">{{empty}}</div><t-else/><c-trade-list id="goods" label="{{list.label}}" cols="{{ json(list.cols) }}" rows="{{ json(list.rows) }}" style="flex: 1 1 0; height: auto"/></t-if></div>
<t-if test="extras.note"><div class="sh-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if>
<t-if test="load.text || len(cargoActions) > 0"><div class="screen-bar"><div class="sh-load"><t-if test="load.text"><c-bar icon="capacity" value="{{load.value}}" after="{{opt(load.after)}}" text="{{load.text}}" kind="brass" style="width: 100%"/></t-if></div><div class="grow"></div>
<t-for each="cargoActions" as="a"><c-button id="{{a.id}}" label="{{a.label}}" variant="{{a.variant}}" hold="{{ a.hold ? 1 : 0 }}" disabled="{{ a.disabled ? 1 : 0 }}" reason="{{opt(a.reason)}}" busy="{{ a.busy ? 1 : 0 }}" class="{{ a.hold ? 'sh-drop' : '' }}"/></t-for></div></t-if></c-panel></t-if></div>
<t-if test="dialog && dialog.kind == 'question'"><c-dialog id="dialog" key="dialog" variant="center" width="440" title="{{dialog.title}}" text="{{dialog.text}}" actions="{{ json(dialog.actions) }}"/></t-if>
<t-if test="dialog && dialog.kind == 'shares'"><c-dialog id="dialog" key="dialog" variant="center" tone="parchment" width="400" title="{{dialog.title}}" closable="1" actions="{{ json(dialog.actions) }}"><t-for each="dialog.groups" as="g"><t-if test="g_i > 0"><div class="sh-rule"></div></t-if><c-kv items="{{ json(g.items) }}" surface="parchment" style="width: 100%"/></t-for></c-dialog></t-if>
<t-if test="sheet"><c-dialog id="sheet" key="sheet" variant="sheet" class="sh-gunsheet" title="{{sheet.title}}" subtitle="{{sheet.subtitle}}" closable="1" width="780" actions="{{ json(sheet.actions) }}"><div class="sh-guns">
<div class="sh-calibres"><c-table id="cannons-stock" head="{{ len(sheet.calibres.rows) > 0 ? 1 : 0 }}" columns="{{ [{label: str(sheet.calibres.label), w: '1fr'}, {label: str(sheet.calibres.count), w: 'auto', align: 'right'}] }}" rows="{{ json(sheet.calibres.rows) }}" empty="{{sheet.calibres.empty}}" empty-icon="cannon" row-height="56" fade="0" class="sh-stock"/></div>
<div class="sh-sides"><t-for each="sheet.sides" as="s"><c-quantity id="{{s.id}}" props="{{ json(s.q) }}" style="width: 100%"/></t-for></div></div></c-dialog></t-if>
<s-extras id="extras" extras="{{ json(extras) }}"/>
</c-screen>
