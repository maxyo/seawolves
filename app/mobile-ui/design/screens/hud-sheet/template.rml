<div class="hs-scrim" data-action="close" style="left: -{{safe.left}}dp; top: -{{safe.top}}dp; right: -{{safe.right}}dp; bottom: -{{safe.bottom}}dp;"></div>
<div class="hs-place"><c-panel class="hs-panel" tone="veil" pad="0" gap="0" edge="1" style="height: {{ spec.header + (layout == 'tiles' ? spec.tilesPad + spec.tile * int((len(rows) + 1) / 2) : layout == 'dense' ? spec.densePad + spec.dense * len(rows) + spec.heading * headings : spec.row * len(rows)) + 2 }}dp;">
<c-header class="hs-header" key="sheet" title="{{title}}" sections="" back="{{ back ? 1 : 0 }}" close="{{ back ? 0 : 1 }}"/>
<div class="hs-list hs-{{layout}}">
<t-for each="rows" as="r"><t-if test="opt(r.heading)"><div class="hs-heading"><c-label text="{{opt(r.heading)}}"/></div></t-if><t-if test="layout == 'tiles'"><div class="hs-tile{{ opt(r.here) ? ' hs-here' : '' }}"><c-button id="{{r.id}}" label="{{r.title}}" icon="{{r.icon}}" size="tile" pressed="{{ r.pressed ? 1 : 0 }}" disabled="{{ r.disabled ? 1 : 0 }}"><t-if test="opt(r.here)"><c-icon class="hs-here-mark" icon="hero" size="16" tone="brass"/></t-if></c-button></div><t-else/><c-list-row id="{{r.id}}" icon="{{r.icon}}" title="{{r.title}}" chevron="{{ r.chevron ? 1 : 0 }}" pressed="{{ r.pressed ? 1 : 0 }}" disabled="{{ r.disabled ? 1 : 0 }}" cooldown="{{ or(r.cooldown, 0) }}" dense="{{ layout == 'dense' ? 1 : 0 }}"/></t-if></t-for>
</div>
</c-panel></div>
