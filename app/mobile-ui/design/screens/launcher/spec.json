{
  "tag": "s-launcher",
  "doc": "Launcher of the application (setup, ready, importing, import error, the picker of found game copies), filled by the engine's launcher.cpp from the platform host's \"launcher\" channel.",
  "props": {
    "view": {"type": "text", "default": "setup"},
    "title": {"type": "text", "default": ""},
    "back": {"type": "bool", "default": false},
    "actions": {"type": "json", "default": [], "shape": {"$of": "c-screen.actions"}},
    "notices": {"type": "json", "default": [], "shape": [{"dismiss": "text", "tone": "text", "text": "text", "lead": "text"}]},
    "setup": {"type": "json", "default": null, "shape": {"$null": {"prompt": "text", "folder": "text", "archive": "text", "archiveMeta": "text", "help": "text", "library": "text"}}},
    "installed": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "meta": "text", "delete": "text", "untested": "text"}}},
    "play": {"type": "json", "default": null, "shape": {"$null": {"label": "text", "busy": "bool"}}},
    "files": {"type": "text", "default": ""},
    "busy": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "status": "text", "percent": "number"}}},
    "cancel": {"type": "json", "default": null, "shape": {"$null": {"label": "text", "disabled": "bool", "busy": "bool"}}},
    "choose": {"type": "json", "default": null, "shape": {"$null": {"untested": "text", "columns": {"$of": "c-table.columns"}, "rows": {"$of": "c-table.rows"}, "primary": {"$of": "c-table.primary"}}}},
    "password": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "subtitle": "text", "confirm": "text", "label": "text"}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
