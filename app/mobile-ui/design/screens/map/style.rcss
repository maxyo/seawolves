/* s-map: the atlas list takes 28 %, the colony sheet 33 %
   (two pages: what the colony trades, the town's facts); the map has the rest. */
s-map { display: block; width: 100%; height: 100%; }
s-map .mp-list { flex: 0 0 28%; height: 100%; }
s-map .mp-map { flex: 1 1 0; min-width: 0; height: 100%; display: flex; flex-direction: column; position: relative; }
s-map .mp-note { position: absolute; left: @{space.md}dp; bottom: @{space.md}dp; max-width: 60%; }
s-map .mp-info { flex: 0 0 33%; min-width: 264dp; height: 100%; }
s-map .mp-doc { flex: 1 1 0; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 4dp; }
s-map .mp-sec { display: flex; flex-direction: column; gap: 1dp; padding-top: 3dp; border-top: 1dp @{color.inkMuted/.28}; }
s-map .mp-cap { font-size: @{type.caption}dp; color: @{color.inkMuted}; }
/* a colony's own goods flow in a line (picture and name each); the trade assistant's are rows: the good, its profit at the right */
s-map .mp-goods { display: flex; flex-direction: row; flex-wrap: wrap; gap: 0 14dp; }
s-map .mp-goods.rows { flex-direction: column; flex-wrap: nowrap; gap: 0; }
s-map .mp-goods.rows .mp-gname { flex: 1 1 0; }
s-map .mp-good { display: flex; flex-direction: row; align-items: center; gap: @{space.sm}dp; min-height: 24dp; font-size: @{type.small}dp; color: @{color.ink}; }
s-map .mp-gimg { position: relative; width: 24dp; height: 24dp; }
s-map .mp-line { font-size: @{type.body}dp; color: @{color.ink}; }
s-map .mp-siege { font-weight: bold; color: @{color.wax}; }
s-map .mp-gname { flex: 0 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* the trade assistant's profit of the good, per unit of weight */
s-map .mp-gval { flex: 0 0 auto; font-weight: bold; color: @{color.leaf}; }
