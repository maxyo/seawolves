{
  "tag": "s-map",
  "doc": "The game's maps (interfaces `mapview`, `mapbest`, `papermap`): the map in c-map-view, the atlas's maps on the left, the tapped colony in a c-colony-sheet on the right. Filled by the script interface/touch/screens/map.c through the shapes of its json props.",
  "props": {
    "title": {
      "type": "text",
      "default": ""
    },
    "map": {
      "type": "json",
      "default": {},
      "shape": {
        "$texture": {
          "base": "numbers",
          "view": "numbers",
          "markers": [
            {
              "$texture": {
                "id": "text",
                "x": "number",
                "y": "number",
                "w": "number",
                "h": "number"
              }
            }
          ]
        }
      }
    },
    "maps": {"type": "json", "default": [], "shape": {"$of": "c-table.rows"}},
    "mapsTitle": {
      "type": "text",
      "default": ""
    },
    "mapColumns": {"type": "json", "default": [], "shape": {"$of": "c-table.columns"}},
    "info": {"type": "json", "default": null, "shape": {"$null": {"title": "text", "nation": "text", "sub": "text", "factsTitle": "text", "facts": {"$of": "c-kv.items"}, "notes": [{"text": "text"}], "sections": [{"title": "text", "page": "text", "goods": [{"$texture": {"label": "text", "value": "text"}}], "lines": [{"text": "text"}]}], "page": "text", "tabs": {"$of": "c-colony-sheet.tabs"}}}},
    "extras": {"type": "json", "default": {}, "shape": {"$of": "s-extras.extras"}}
  }
}
