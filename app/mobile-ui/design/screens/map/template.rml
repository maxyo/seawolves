<c-screen id="header" key="header" title="{{title}}" actions="{{ json(extras.actions) }}">
<t-if test="len(maps) > 0"><div class="mp-list"><c-panel pad="0" gap="0"><c-table id="maps" columns="{{ json(mapColumns) }}" rows="{{ json(maps) }}" row-height="56" style="flex: 1 1 0; height: auto"/></c-panel></div></t-if>
<div class="mp-map"><c-map-view id="map" texture="{{map.texture}}" uv="{{map.uv}}" base="{{ json(map.base) }}" view="{{ json(map.view) }}" markers="{{ json(map.markers) }}" room="{{ info ? 'info' : 'map' }}"/><t-if test="extras.note"><div class="mp-note"><s-note id="extras-note" text="{{extras.note}}"/></div></t-if></div>
<t-if test="info"><div class="mp-info"><c-colony-sheet key="info" title="{{info.title}}" nation="{{info.nation}}" sub="{{info.sub}}" tabs="{{ json(info.tabs) }}" custom="1"><div class="mp-doc">
<t-if test="info.page != 'city'"><t-for each="info.sections" as="s"><t-if test="s.page == info.page"><div class="mp-sec"><t-if test="s.title"><div class="mp-cap">{{s.title}}</div></t-if><div class="mp-goods{{ len(s.goods) > 0 && opt(s.goods[0].value) ? ' rows' : '' }}"><t-for each="s.goods" as="g"><div class="mp-good"><div class="mp-gimg"><ui-game-image texture="{{g.texture}}" uv="{{g.uv}}"/></div><div class="mp-gname">{{g.label}}</div><t-if test="opt(g.value)"><div class="mp-gval">{{opt(g.value)}}</div></t-if></div></t-for></div><t-for each="s.lines" as="l"><div class="mp-line">{{l.text}}</div></t-for></div></t-if></t-for></t-if>
<t-if test="info.page == 'city'"><t-for each="info.notes" as="l"><div class="mp-line mp-siege">{{l.text}}</div></t-for>
<t-if test="len(info.facts) > 0"><c-kv surface="parchment" items="{{ json(info.facts) }}" cols="1" size="15"/></t-if></t-if>
</div></c-colony-sheet></div></t-if>
<s-extras id="extras" extras="{{ json(extras) }}"/>
</c-screen>
