<div class="pd-scroll"><div class="pd-top" data-reveal="{{detail.id}}" data-reveal-snap="1"></div>
<div class="pd-head"><c-row-image class="pd-head-pic" image="{{ json(detail.image) }}" icon="rank" size="36" icon-size="22" round="1" tone="brass" label="{{detail.title}}"/><div class="pd-head-text"><ui-clamp class="pd-title" lines="2" min-size="@{type.min}" text="{{detail.title}}"/><t-if test="detail.group"><div class="pd-group"><c-icon icon="{{detail.groupIcon}}" size="12" tone="brass"/><div>{{detail.group}}</div></div></t-if></div></div>
<div class="pd-text"><t-if test="len(detail.requires) > 0"><span class="pd-word">{{ tr('hero.requires') }}</span> <t-for each="detail.requires" as="r"><div class="pd-dep st-{{r.state}}{{ r.met ? '' : ' unmet' }}{{ r.nudge ? ' nudge' : '' }}" data-action="go" data-value="{{r.perk}}" data-tip="{{r.name}}"><div class="pd-hit"></div><div class="pd-halo"></div><div class="pd-dep-pic"><c-row-image image="{{ json(r.image) }}" icon="rank" size="24" icon-size="16" round="1" surface="parchment" tone="{{ r.met ? 'brass' : 'dim' }}" label="{{r.name}}"/></div><t-if test="r.state == 'learned'"><div class="pd-mark"><c-icon icon="check" size="8" tone="green"/></div></t-if><t-if test="!r.met"><div class="pd-mark"><c-icon icon="lock" size="8" tone="paper"/></div></t-if><t-if test="r.groupIcon"><div class="pd-gmark"><c-icon icon="{{r.groupIcon}}" size="8" tone="paper"/></div></t-if></div></t-for><br/></t-if>{{detail.text}}<t-if test="len(detail.opens) > 0"><br/><span class="pd-word">{{ tr('hero.opens') }}</span> <t-for each="detail.opens" as="r"><div class="pd-dep st-{{r.state}}" data-action="go" data-value="{{r.perk}}" data-tip="{{r.name}}"><div class="pd-hit"></div><div class="pd-halo"></div><div class="pd-dep-pic"><c-row-image image="{{ json(r.image) }}" icon="rank" size="24" icon-size="16" round="1" surface="parchment" tone="{{ r.state == 'locked' ? 'dim' : 'brass' }}" label="{{r.name}}"/></div><t-if test="r.state == 'learned'"><div class="pd-mark"><c-icon icon="check" size="8" tone="green"/></div></t-if><t-if test="r.state == 'locked'"><div class="pd-mark"><c-icon icon="lock" size="8" tone="paper"/></div></t-if><t-if test="r.groupIcon"><div class="pd-gmark"><c-icon icon="{{r.groupIcon}}" size="8" tone="paper"/></div></t-if></div></t-for></t-if></div><t-if test="detail.note"><div class="pd-note">{{detail.note}}</div></t-if>
</div>
<t-if test="detail.learn"><c-button id="{{detail.learn.id}}" label="{{detail.learn.label}}" variant="primary" hold="1" disabled="{{ detail.learn.disabled ? 1 : 0 }}" busy="{{ detail.learn.busy ? 1 : 0 }}" style="width: 100%"/></t-if>
<t-if test="detail.go"><c-button id="{{detail.go.id}}" label="{{detail.go.label}}" variant="secondary" style="width: 100%"/></t-if>
