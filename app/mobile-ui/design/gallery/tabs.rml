<rml>
<head>
<title>Вкладки</title>
<link type="text/rcss" href="../kit.rcss"/>
</head>
<body class="gallery">
<div class="g-page">
<div class="g-title">C-Tabs</div>
<div class="g-note">bar: красная метка, недоступная вкладка (причина — тостом)</div>
<div class="g-row g-wood">
  <div style="width: 420dp"><c-tabs id="tabs-bar" items='[{"label":"Умения","selected":true},{"label":"Способности","badge":3,"selected":false},{"label":"Спутники","selected":false}]'/></div>
  <div style="width: 420dp"><c-tabs id="tabs-bar2" items='[{"label":"Личные","selected":true},{"label":"Корабельные","selected":false},{"label":"Архив","disabled":true,"reason":"Архив пуст","selected":false}]'/></div>
</div>
<div class="g-note">segment (обычный и stretch), одна вкладка — ничего не рисуется (справа пусто)</div>
<div class="g-row g-wood" style="align-items: center">
  <c-tabs id="tabs-seg" look="segment" items='[{"label":"Личные","selected":true},{"label":"Корабельные","selected":false}]'/>
  <div style="width: 320dp"><c-tabs id="tabs-seg2" look="segment" stretch="1" items='[{"label":"Все","selected":false},{"label":"Оружие","selected":true},{"label":"Зелья","badge":2,"selected":false}]'/></div>
  <c-tabs look="segment" items='[{"label":"Единственная","selected":true}]'/>
</div>
<div class="g-note">rail (обычный и compact)</div>
<div class="g-row g-wood">
  <div style="width: 220dp"><c-tabs id="tabs-rail" look="rail" items='[{"label":"Квесты","selected":true},{"label":"Склады","selected":false},{"label":"Касса","badge":1,"selected":false}]'/></div>
  <div style="width: 160dp"><c-tabs id="tabs-railc" look="rail" compact="1" items='[{"label":"Квесты","selected":true},{"label":"Склады","selected":false},{"label":"Касса","badge":1,"selected":false}]'/></div>
</div>
<div class="g-note">На пергаменте</div>
<div class="g-row g-paper">
  <div style="width: 400dp"><c-tabs id="ptabs-bar" surface="parchment" items='[{"label":"Журнал","selected":true},{"label":"Письма","badge":2,"selected":false},{"label":"Архив","selected":false}]'/></div>
  <div style="width: 400dp"><c-tabs id="ptabs-seg" surface="parchment" look="segment" stretch="1" items='[{"label":"Личные","selected":true},{"label":"Корабельные","selected":false}]'/></div>
</div>
<div class="g-row g-paper">
  <div style="width: 220dp"><c-tabs id="ptabs-rail" surface="parchment" look="rail" items='[{"label":"Задания","selected":true},{"label":"Документы","selected":false},{"label":"Имущество","disabled":true,"selected":false}]'/></div>
  <c-tabs id="ptabs-seg2" surface="parchment" look="segment" items='[{"label":"Купить","selected":false},{"label":"Продать","selected":true}]'/>
</div>
</div>
</body>
</rml>
