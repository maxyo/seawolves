<rml>
<head>
<title>Шапка объекта</title>
<link type="text/rcss" href="../kit.rcss"/>
</head>
<body class="gallery">
<div class="g-page">
<div class="g-title">C-ObjectHeader</div>
<div class="g-note">image: игровая картинка предмета, жетон, портрет, голый значок; без картинки</div>
<div class="g-row">
  <div class="g-wood" style="width: 300dp"><c-object-header image='{"kind":"item","texture":"INTERFACES/items6","cell":8,"icon":"pistol"}' title="Строевой пистоль" sub="огнестрел · надет"/></div>
  <div class="g-wood" style="width: 300dp"><c-object-header image='{"kind":"token","icon":"ship-lugger","enamel":"teal"}' title="Ласточка" sub="Люггер · 7 класс"/></div>
  <div class="g-wood" style="width: 240dp"><c-object-header image='{"kind":"portrait","texture":"INTERFACES/PORTRAITS/128/face_205"}' title="Тичингиту" sub="абордажник" size="40" title-size="17"/></div>
</div>
<div class="g-row">
  <div class="g-wood" style="width: 300dp"><c-object-header icon="perk-carpenter" title="Плотник" sub="умение корабля"/></div>
  <div class="g-wood" style="width: 300dp"><c-object-header title="Без картинки" sub="только текст"/></div>
</div>
<div class="g-note">place: end (действие справа), name (перо сразу после имени), below (факты под строкой); на пергаменте; align start</div>
<div class="g-row">
  <div class="g-wood" style="width: 300dp"><c-object-header image='{"kind":"item","texture":"INTERFACES/items15","cell":6,"icon":"sabre"}' title="Карцолета" sub="клинок · надета"><c-icon-button id="oh-info" icon="info" label="Справка" look="bare"/></c-object-header></div>
  <div class="g-wood" style="width: 300dp"><c-object-header image='{"kind":"token","icon":"ship-lugger","enamel":"teal"}' title="Ласточка" sub="Люггер · 7 класс" place="name"><c-icon-button id="oh-rename" icon="quill" label="Переименовать" look="bare"/></c-object-header></div>
</div>
<div class="g-row">
  <div class="g-paper" style="width: 300dp"><c-object-header surface="parchment" image='{"kind":"item","texture":"INTERFACES/items19","cell":1,"icon":"potion"}' title="Лечебное зелье" sub="снадобье · 3 шт." place="below" align="start"><c-kv surface="parchment" items='[{"k":"Вес","v":"0,5"},{"k":"Цена","v":"120"}]'/></c-object-header></div>
  <div class="g-paper" style="width: 300dp"><c-object-header surface="parchment" icon="quest" title="Письмо губернатору" sub="квест · Сен-Пьер"/></div>
</div>
</div>
</body>
</rml>
