  <div style="width: 300dp; height: 470dp"><c-colony-sheet id="cs-2" key="cs-2" title="Порт-Рояль" nation="nation-england" sub="Англия · 5 дней пути" siege="Осада: испанская эскадра" tabs='[{"label":"Колония","selected":true},{"label":"Помощник","selected":false}]' exports='[{"icon":"sack","label":"Сахар"},{"icon":"leaf","label":"Табак"},{"icon":"sack","label":"Кофе"}]' imports='[{"icon":"rum","label":"Ром"},{"icon":"sailcloth","label":"Ткани"},{"icon":"sabre","label":"Оружие"}]' facts='[{"k":"Население","v":"4 860"},{"k":"Форт","v":"есть"},{"k":"Казна","v":"86 300"},{"k":"Верфь","v":"есть"}]' expanded="1" date="Сведения от 12 окт. 1654"/></div>
