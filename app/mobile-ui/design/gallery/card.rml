<rml>
<head>
<title>Карточка</title>
<link type="text/rcss" href="../kit.rcss"/>
</head>
<body class="gallery">
<div class="g-page">
<div class="g-title">C-Card</div>
<div class="g-note">на дереве: raised · selected · disabled · dashed (пустой слот) · plain · danger · danger selected · parchment · parchment selected</div>
<div class="g-row g-wood">
  <c-card style="width: 150dp; height: 80dp"><div>Обычная</div><div style="font-size: 13dp">raised</div></c-card>
  <c-card style="width: 150dp; height: 80dp" selected="1"><div>Выбрана</div><div style="font-size: 13dp">selected</div></c-card>
  <c-card style="width: 150dp; height: 80dp" disabled="1"><div>Недоступна</div><div style="font-size: 13dp">disabled</div></c-card>
  <c-card style="width: 150dp; height: 80dp" dashed="1"><div>Пустой слот</div><div style="font-size: 13dp">dashed</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="plain"><div>Без заливки</div><div style="font-size: 13dp">plain</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="danger"><div>Опасно</div><div style="font-size: 13dp">danger</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="danger" selected="1"><div>Опасно</div><div style="font-size: 13dp">danger selected</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="parchment"><div>Записка</div><div style="font-size: 13dp">parchment</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="parchment" selected="1"><div>Записка</div><div style="font-size: 13dp">parchment selected</div></c-card>
  <c-card style="width: 150dp; height: 80dp" tone="parchment" disabled="1"><div>Записка</div><div style="font-size: 13dp">parchment disabled</div></c-card>
  <c-card style="width: 150dp; height: 80dp" pad="16" gap="12"><div>pad 16</div><div style="font-size: 13dp">gap 12</div></c-card>
</div>
<div class="g-note">на пергаменте (surface parchment): raised · selected · disabled · dashed · plain · danger</div>
<div class="g-row g-paper">
  <c-card style="width: 150dp; height: 80dp" surface="parchment"><div>Обычная</div><div style="font-size: 13dp">raised</div></c-card>
  <c-card style="width: 150dp; height: 80dp" surface="parchment" selected="1"><div>Выбрана</div><div style="font-size: 13dp">selected</div></c-card>
  <c-card style="width: 150dp; height: 80dp" surface="parchment" disabled="1"><div>Недоступна</div><div style="font-size: 13dp">disabled</div></c-card>
  <c-card style="width: 150dp; height: 80dp" surface="parchment" dashed="1"><div>Пустой слот</div><div style="font-size: 13dp">dashed</div></c-card>
  <c-card style="width: 150dp; height: 80dp" surface="parchment" tone="plain"><div>Без заливки</div><div style="font-size: 13dp">plain</div></c-card>
  <c-card style="width: 150dp; height: 80dp" surface="parchment" tone="danger"><div>Опасно</div><div style="font-size: 13dp">danger</div></c-card>
</div>
</div>
</body>
</rml>
