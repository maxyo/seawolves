{
  "nodeSets": {
    "goods-head": [
      ["TABLE_LIST", "choice|table", true], ["EXIT_BTN", "button"], ["STORECAPTION1", "text"],
      ["TITLE", "heading|text"], ["INFO_TEXT", "text"], ["CAPACITY", "text"]
    ],
    "goods-box": [
      ["TABBTN_*", "image|button"], ["TABSTR_*", "text"], ["GETALL_BUTTON", "button"], ["ANDROID_TAKE_ALL", "button"],
      ["DELBODY_BUTTON", "button"], ["SKULL_BUTTON", "button"], ["QTY_EDITBOX", "edit"]
    ],
    "hero-sections": [
      ["I_CHARACTER", "button"], ["I_SHIP", "button"], ["I_QUESTBOOK", "button"], ["I_TRADEBOOK", "button"],
      ["I_NATIONS", "button"], ["I_ITEMS", "button"], ["STR_BUTTONS", "text"]
    ],
    "qty-window": [
      ["QTY_EDIT", "edit"], ["QTY_OK_BUTTON", "button"], ["QTY_CANCEL_BUTTON", "button"],
      ["QTY_*", "text|heading|image"]
    ]
  },
  "segments": [
    {"file": "interface/touch/core/core.c", "core": true},
    {"file": "interface/touch/lib/text.c", "core": true},
    {"file": "interface/touch/lib/list.c", "core": true},
    {"file": "interface/touch/contracts/rest.c"},
    {"file": "interface/touch/contracts/trade.c"},
    {"file": "interface/touch/contracts/nations.c"},
    {"file": "interface/android_ui_bootstrap.c"},
    {"file": "interface/touch/lineages/legacy/lib.c"},
    {
      "file": "interface/touch/lineages/legacy/rest.c",
      "provides": ["adapter:rest"],
      "binds": [
        {
          "capability": "rest",
          "interface": "tavernwait",
          "nodes": [
            ["HOURS_SLIDE", "slider", true], ["OK_BTN", "button", true], ["CANCEL_BTN", "button"],
            ["EXIT_BTN", "button"], ["INFO_TEXT", "text"]
          ]
        }
      ]
    },
    {
      "file": "interface/touch/lineages/legacy/trade.c",
      "requires": ["fn:GetGoodWeightByType/2", "var:GameInterface"],
      "provides": ["adapter:trade"],
      "binds": [
        {
          "capability": "trade_chest",
          "interface": "itemsbox",
          "nodes": ["@goods-head", "@goods-box", ["CHARACTERS_SCROLL", "choice"], "@qty-window"],
          "data": {
            "own": 0,
            "other": 4,
            "name": 2,
            "buy": -1,
            "sell": -1,
            "pack": -1,
            "packWeight": -1,
            "ownTotal": 1,
            "otherTotal": 3,
            "goods": false,
            "pieces": false,
            "types": false,
            "owners": "CHARACTERS_SCROLL",
            "tabs": {"t1": "common.all", "t2": "trade.tab_mine", "t3": "trade.tab_here", "t4": "trade.tab_weapons"}
          }
        },
        {
          "capability": "trade_storage",
          "interface": "storage",
          "nodes": [
            "@goods-head", "@goods-box", ["SHIPS_SCROLL", "choice"], ["STORE_CAPACITY", "text"],
            ["STORAGE_INFO", "text"], "@qty-window"
          ],
          "data": {
            "own": 0, "other": 3, "name": 2, "buy": -1, "sell": -1, "pack": 4, "packWeight": -1, "ownTotal": -1,
            "otherTotal": -1, "goods": true, "pieces": false, "types": false, "owners": "SHIPS_SCROLL"
          }
        },
        {
          "capability": "trade_store",
          "interface": "store",
          "nodes": [
            "@goods-head", ["SHIPS_SCROLL", "choice"], ["LEFTSCROLLBUTTON", "button"], ["RIGHTSCROLLBUTTON", "button"],
            ["OUR_GOLD", "text"], ["STORE_CAPACITY", "text"], ["FOOD_SHIP", "text"], ["QTY_ADD_BUTTON", "button"],
            ["QTY_REMOVE_BUTTON", "button"], ["QTY_ADD_ALL_BUTTON", "button"], ["QTY_REMOVE_ALL_BUTTON", "button"],
            ["MAIN_CHARACTER_PICTURE", "image"], ["OTHER_PICTURE", "image"], "@qty-window"
          ],
          "data": {
            "own": 0, "other": 5, "name": 3, "buy": 2, "sell": 4, "pack": 6, "packWeight": 7, "ownTotal": -1,
            "otherTotal": -1, "goods": true, "pieces": false, "types": true, "owners": "SHIPS_SCROLL"
          }
        },
        {
          "capability": "trade_contraband",
          "interface": "contraband",
          "nodes": [
            "@goods-head", ["SHIPS_SCROLL", "choice"], ["OUR_GOLD", "text"], ["STORE_CAPACITY", "text"], "@qty-window"
          ],
          "data": {
            "own": 0, "other": 5, "name": 3, "buy": 2, "sell": 4, "pack": 6, "packWeight": 7, "ownTotal": -1,
            "otherTotal": -1, "goods": true, "pieces": false, "types": false, "owners": "SHIPS_SCROLL"
          }
        }
      ]
    },
    {
      "file": "interface/touch/lineages/legacy/nations.c",
      "requires": [
        "fn:GetMainCharacter/0", "fn:GetNationNameByType/1", "fn:NationShortName/1", "fn:GetNationRelation/2",
        "fn:GetRelationName/1", "fn:ChangeCharacterNationReputation/3", "fn:GetNationReputationName/2",
        "fn:GetRPGText/1", "var:GameInterface"
      ],
      "provides": ["adapter:nations"],
      "binds": [
        {
          "capability": "nations",
          "interface": "nationrelation",
          "nodes": [
            ["TITLE", "heading"], ["FlagPic", "image", true], ["LEFTCHANGE_NATION", "button"],
            ["RIGHTCHANGE_NATION", "button"], ["FLAGS", "button"], ["EXIT_BTN", "button"], "@hero-sections",
            ["ENG_TEXT", "text"], ["FRA_TEXT", "text"], ["SPA_TEXT", "text"], ["HOL_TEXT", "text"],
            ["INFO_CLICK", "text"], ["INFO_CLICK2", "text"], ["ICON_*", "image"]
          ],
          "data": {
            "flags": {
              "England": "nation-england", "France": "nation-france", "Spain": "nation-spain",
              "Holland": "nation-holland", "Pirate": "nation-pirates"
            },
            "help": {"standing": {"title": "Hunter_type", "text": "Hunter_hint"}, "flag": {"title": "Nation", "text": "Nation_hint"}}
          }
        }
      ]
    },
    {
      "file": "interface/touch/screens/rest.c",
      "uses": ["adapter:rest"],
      "screens": [{"capability": "rest", "component": "s-rest"}]
    },
    {
      "file": "interface/touch/screens/trade/trade.c",
      "uses": ["adapter:trade"],
      "screens": [
        {
          "capability": "trade_chest",
          "component": "s-trade",
          "look": {
            "title": "trade.chest", "small": true, "quick": true, "carryIcon": "weight", "baseIcon": "chest",
            "ownCaption": "", "ownIcon": "", "otherCaption": "", "otherIcon": ""
          }
        },
        {
          "capability": "trade_storage",
          "component": "s-trade",
          "look": {
            "title": "trade.storage", "small": false, "quick": true, "carryIcon": "capacity", "baseIcon": "chest",
            "ownCaption": "trade.in_hold", "ownIcon": "capacity", "otherCaption": "", "otherIcon": ""
          }
        },
        {
          "capability": "trade_store",
          "component": "s-trade",
          "look": {
            "title": "trade.store", "small": false, "quick": false, "carryIcon": "capacity", "baseIcon": "store",
            "ownCaption": "trade.in_hold", "ownIcon": "capacity", "otherCaption": "trade.in_store",
            "otherIcon": "store"
          }
        },
        {
          "capability": "trade_contraband",
          "component": "s-trade",
          "look": {
            "title": "trade.contraband", "small": false, "quick": false, "carryIcon": "capacity", "baseIcon": "store",
            "ownCaption": "trade.in_hold", "ownIcon": "capacity", "otherCaption": "", "otherIcon": ""
          }
        }
      ]
    },
    {
      "file": "interface/touch/screens/hero/nations.c",
      "uses": ["adapter:nations"],
      "screens": [{"capability": "nations", "component": "s-nations"}]
    }
  ]
}
