+// Whether the ship screen offers the exchange with chr's ship (ship.c ShipChange): a companion's ship, not one of
+// the ships at anchor the journal shows, while the hero has a ship of his own.
+bool IsShipChangeOffered(ref chr)
+{
+	return !CheckAttribute(pchar, "SystemInfo.ShowShip") && chr.id != pchar.id && sti(pchar.ship.type) != SHIP_NOTUSED;
+}
