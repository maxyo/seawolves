+// The weight of the items the character carries: what the loop over all TOTAL_ITEMS Items[]
+// summed (ugeen: the map atlas does not count), found from the character's own items instead.
+// Their Items[] indices are put in ascending order first, so the float sum is the one the loop
+// made in the same order; each index is one of Items[TOTAL_ITEMS] and comes once.
+float GetItemsWeightNow(ref _chref)
+{
+	float Amount = 0;
+	int j, k, idx, n;
+	string itemID;
+	ref itm;
+	if (!CheckAttribute(_chref, "items")) return Amount;
+	aref list;
+	makearef(list, _chref.items);
+	n = GetAttributesNum(list);
+	int order[TOTAL_ITEMS];
+	int m = 0;
+	for (j = 0; j < n; j++)
+	{
+		idx = FindItem(GetAttributeName(GetAttributeN(list, j)));
+		if (idx < 0) continue;
+		for (k = m; k > 0; k--)
+		{
+			if (order[k-1] < idx) break;
+			order[k] = order[k-1];
+		}
+		order[k] = idx;
+		m++;
+	}
+	for (k = 0; k < m; k++)
+	{
+		makeref(itm,Items[order[k]]);
+		itemID = itm.id;
+		if (itemID != "MapsAtlas")      // ugeen - атлас карт не учитываем !!
+		{
+			Amount += sti(_chref.items.(itemID))*stf(itm.Weight);
+		}
+	}
+	return Amount;
+}
