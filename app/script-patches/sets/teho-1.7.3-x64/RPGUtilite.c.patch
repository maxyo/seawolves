+// Seawolves: the character screen explains a skill or a characteristic (android_hero.c AndroidSkillSteps). While
+// chr.SkillTrace names a skill or characteristic (that script sets it around one call and removes it),
+// GetCharacterSkillSimple and GetCharacterSPECIALSimple of that name record their running value after each of their
+// steps: the explanation is this computation itself. Otherwise each step costs one bool test.
+void SkillTraceAt(ref chr, string step, int value)
+{
+	aref steps;
+	makearef(steps, chr.SkillTrace);
+	string key = "s" + GetAttributesNum(steps);
+	steps.(key) = step;
+	steps.(key).value = value;
+}
