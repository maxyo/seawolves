+// The game kept a set per profile (save\<profile>\options\options, written in a game) beside the title
+// screen's. Once, the set of the last new game's profile (StartGameParam.PlayerProfile, else the game's
+// default "Player") is laid over the title screen's and becomes the one set.
+void MigrateProfileOptions(ref gopt)
+{
+	string sProfile = "Player";
+	if( CheckAttribute(gopt,"StartGameParam.PlayerProfile") && gopt.StartGameParam.PlayerProfile!="" ) {
+		sProfile = gopt.StartGameParam.PlayerProfile;
+	}
+	SendMessage(&GameInterface, "lsa", MSG_INTERFACE_LOADOPTIONS, "save\"+sProfile+"\options\options", gopt);
+	trace("Options: one set from now on, profile " + sProfile + "'s options (if any) laid over the title screen's");
+	SaveSavedOptions(gopt);
+}
