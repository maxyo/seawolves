# Dependencies of the Linux host build of the engine (development, the boot stage and the scene sweep): the pinned
# sources (cmake/engine_dependencies.cmake), mimalloc, and the distribution's SDL2 and zlib.
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
add_compile_options(-fsigned-char)
include(engine_dependencies)
target_link_libraries(storm_open_audio PUBLIC pthread)
find_package(SDL2 REQUIRED)
add_library(sdl INTERFACE)
target_link_libraries(sdl INTERFACE SDL2::SDL2)
set(SDL2_LIBRARIES sdl)
storm_fetch_pin(storm_mimalloc mimalloc STORM_POPULATE_ONLY)
FetchContent_MakeAvailable(storm_mimalloc)
set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(MI_BUILD_STATIC OFF CACHE BOOL "" FORCE)
set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)
add_subdirectory("${storm_mimalloc_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/mimalloc" EXCLUDE_FROM_ALL)
add_library(zlib INTERFACE)
target_link_libraries(zlib INTERFACE z)
include(ffmpeg)
storm_ffmpeg(host)
set(STORM_BUILD_PLATFORM Linux_host) # the watermark's platform (cmake/build_stamp.cmake)
