# The names the engine shares with the Android application, as headers generated from tools/android/app_contract.json
# into STORM_APP_CONTRACT_INCLUDE: app_upcalls.hpp (jni.upcalls), storm_archive_status.h (archive_status, the archive
# reader's C enum), app_script_events.hpp (script_events), app_ui_names.hpp (hud_host_input, host_actions,
# state_channels, settings). The application's build generates its Java classes from the same file
# (app/tools/android). Outside a CMake project (the checks compiled for Android by a script):
#   cmake -D STORM_APP_CONTRACT_INCLUDE=<dir> -P cmake/StormAppContract.cmake
set(STORM_APP_CONTRACT "${CMAKE_CURRENT_LIST_DIR}/../tools/android/app_contract.json")
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(STORM_APP_CONTRACT_INCLUDE "${CMAKE_BINARY_DIR}/storm_app_contract")
endif()

function(storm_app_contract_headers)
    set(out "${STORM_APP_CONTRACT_INCLUDE}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${STORM_APP_CONTRACT}")
    endif()
    file(READ "${STORM_APP_CONTRACT}" contract)

    set(text "// Generated from tools/android/app_contract.json (jni.upcalls) by cmake/StormAppContract.cmake.\n")
    string(APPEND text "#pragma once\n\nnamespace storm::android\n{\n")
    string(APPEND text "struct JavaMethod\n{\n    const char *name;\n    const char *signature;\n};\n\n")
    string(APPEND text "// The methods of org.stormengine.port the engine calls, per class; every APK build finds each in the\n")
    string(APPEND text "// compiled classes (app/tools/android/build_apk.py).\nnamespace upcall\n{\n")
    string(JSON count LENGTH "${contract}" jni upcalls)
    math(EXPR last "${count} - 1")
    set(open "")
    foreach(i RANGE ${last})
        string(JSON class GET "${contract}" jni upcalls ${i} 0)
        string(JSON name GET "${contract}" jni upcalls ${i} 1)
        string(JSON signature GET "${contract}" jni upcalls ${i} 2)
        if(NOT class STREQUAL open)
            if(open)
                string(APPEND text "} // namespace ${namespace}\n")
            endif()
            set(open "${class}")
            string(REPLACE "." "_" namespace "${class}")
            string(REPLACE "." "$" binary "${class}")
            string(APPEND text "namespace ${namespace}\n{\n")
            string(APPEND text "inline constexpr char className[] = \"org.stormengine.port.${binary}\";\n")
        endif()
        string(APPEND text "inline constexpr JavaMethod ${name}{\"${name}\", \"${signature}\"};\n")
    endforeach()
    string(APPEND text "} // namespace ${namespace}\n} // namespace upcall\n} // namespace storm::android\n")
    file(CONFIGURE OUTPUT "${out}/app_upcalls.hpp" CONTENT "${text}" @ONLY)

    set(text "/* Generated from tools/android/app_contract.json (archive_status) by cmake/StormAppContract.cmake. */\n")
    string(APPEND text "#pragma once\n/* Status of every call of the archive reader; see android/archive/README.md. */\n")
    string(APPEND text "enum storm_archive_status\n{\n")
    string(JSON count LENGTH "${contract}" archive_status)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${contract}" archive_status ${i})
        string(JSON code GET "${contract}" archive_status ${name})
        string(APPEND text "    STORM_ARCHIVE_${name} = ${code},\n")
    endforeach()
    string(APPEND text "};\n")
    file(CONFIGURE OUTPUT "${out}/storm_archive_status.h" CONTENT "${text}" @ONLY)

    set(text "// Generated from tools/android/app_contract.json (script_events) by cmake/StormAppContract.cmake.\n")
    string(APPEND text "#pragma once\n\n// The events the engine raises for the application's interface scripts (mobile-ui/PROGRAM).\n")
    string(APPEND text "namespace storm::app::script_event\n{\n")
    string(JSON count LENGTH "${contract}" script_events)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${contract}" script_events ${i})
        string(APPEND text "inline constexpr char ${name}[] = \"${name}\";\n")
    endforeach()
    string(APPEND text "} // namespace storm::app::script_event\n")
    file(CONFIGURE OUTPUT "${out}/app_script_events.hpp" CONTENT "${text}" @ONLY)

    set(text "// Generated from tools/android/app_contract.json (hud_host_input, host_actions, state_channels,\n")
    string(APPEND text "// settings) by cmake/StormAppContract.cmake: what the UI and the activity name on both sides.\n#pragma once\n\n")
    string(APPEND text "#include <array>\n#include <cstddef>\n#include <span>\n\n")
    string(APPEND text "namespace storm::app\n{\n// The HUD input the engine hands to the activity, and the values of each.\nnamespace hud_input\n{\n")
    string(JSON verbs LENGTH "${contract}" hud_host_input)
    math(EXPR last_verb "${verbs} - 1")
    set(values_text "")
    foreach(v RANGE ${last_verb})
        string(JSON verb MEMBER "${contract}" hud_host_input ${v})
        string(APPEND text "inline constexpr char ${verb}[] = \"${verb}\";\n")
        string(APPEND values_text "namespace ${verb}\n{\n")
        string(JSON count LENGTH "${contract}" hud_host_input ${verb})
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON value GET "${contract}" hud_host_input ${verb} ${i})
            string(APPEND values_text "inline constexpr char ${value}[] = \"${value}\";\n")
        endforeach()
        string(APPEND values_text "} // namespace ${verb}\n")
    endforeach()
    string(APPEND text "} // namespace hud_input\n${values_text}")
    string(APPEND text "// The UI's actions the activity handles (onUiAction).\nnamespace host_action\n{\n")
    string(JSON count LENGTH "${contract}" host_actions)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON action GET "${contract}" host_actions ${i})
        string(REPLACE "-" "_" identifier "${action}")
        string(APPEND text "inline constexpr char ${identifier}[] = \"${action}\";\n")
    endforeach()
    string(APPEND text "} // namespace host_action\n// The UI state channels the hosts write.\nnamespace channel\n{\n")
    string(JSON hosts LENGTH "${contract}" state_channels)
    math(EXPR last_host "${hosts} - 1")
    foreach(h RANGE ${last_host})
        string(JSON host MEMBER "${contract}" state_channels ${h})
        string(JSON count LENGTH "${contract}" state_channels ${host})
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON channel GET "${contract}" state_channels ${host} ${i})
            string(APPEND text "inline constexpr char ${channel}[] = \"${channel}\";\n")
        endforeach()
    endforeach()
    string(APPEND text "} // namespace channel\n")
    string(APPEND text "// The settings the application stores and the engine reads (the settings screen's, then the About screen's).\n")
    string(APPEND text "namespace setting\n{\n")
    foreach(list keys about_keys)
        string(JSON count LENGTH "${contract}" settings ${list})
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON key GET "${contract}" settings ${list} ${i})
            string(APPEND text "inline constexpr char ${key}[] = \"${key}\";\n")
        endforeach()
    endforeach()
    string(APPEND text "} // namespace setting\n")
    string(APPEND text "// The display options' steps and the value before the player chose one.\nnamespace step\n{\n")
    string(APPEND text "template <std::size_t N> struct Steps\n{\n    std::array<int, N> values;\n    int initial;\n};\n")
    string(JSON count LENGTH "${contract}" settings steps)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${contract}" settings steps ${i})
        string(JSON length LENGTH "${contract}" settings steps ${key} values)
        math(EXPR last_value "${length} - 1")
        set(values "")
        foreach(v RANGE ${last_value})
            string(JSON value GET "${contract}" settings steps ${key} values ${v})
            list(APPEND values "${value}")
        endforeach()
        string(JSON initial GET "${contract}" settings steps ${key} default)
        list(FIND values "${initial}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "${STORM_APP_CONTRACT}: settings.steps.${key}: the default ${initial} is not a step")
        endif()
        list(JOIN values ", " values)
        string(APPEND text "inline constexpr Steps<${length}> ${key}{{${values}}, ${initial}};\n")
    endforeach()
    string(APPEND text "} // namespace step\n")
    string(APPEND text "// What the application reports beside the settings and does not take back.\nnamespace host_fact\n{\n")
    string(JSON count LENGTH "${contract}" settings host_facts)
    math(EXPR last "${count} - 1")
    set(all "")
    foreach(i RANGE ${last})
        string(JSON fact GET "${contract}" settings host_facts ${i})
        string(APPEND text "inline constexpr char ${fact}[] = \"${fact}\";\n")
        string(APPEND all "${fact}, ")
    endforeach()
    string(APPEND text "inline constexpr const char *all[] = {${all}};\n} // namespace host_fact\n")
    string(APPEND text "// The debug overrides of a debuggable build and the values the settings screen offers (-1: the preset's).\n")
    string(APPEND text "namespace debug\n{\ntemplate <std::size_t N> struct Override\n{\n    const char *key;\n")
    string(APPEND text "    std::array<int, N> values;\n};\n")
    string(JSON count LENGTH "${contract}" settings debug)
    math(EXPR last "${count} - 1")
    set(all "")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${contract}" settings debug ${i})
        string(JSON length LENGTH "${contract}" settings debug ${key})
        math(EXPR last_value "${length} - 1")
        set(values "")
        foreach(v RANGE ${last_value})
            string(JSON value GET "${contract}" settings debug ${key} ${v})
            list(APPEND values "${value}")
        endforeach()
        list(JOIN values ", " values)
        string(APPEND text "inline constexpr Override<${length}> ${key}{\"${key}\", {${values}}};\n")
        string(APPEND all "{${key}.key, ${key}.values}, ")
    endforeach()
    string(APPEND text "struct Entry\n{\n    const char *key;\n    std::span<const int> values;\n};\n")
    string(APPEND text "inline constexpr Entry all[] = {${all}};\n} // namespace debug\n} // namespace storm::app\n")
    file(CONFIGURE OUTPUT "${out}/app_ui_names.hpp" CONTENT "${text}" @ONLY)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    storm_app_contract_headers()
endif()
