# cmake -DREPOSITORY=<checkout> [-DPLATFORM=<name>] -DOUTPUT=<header> -P write_build_stamp.cmake (cmake/build_stamp.cmake)
execute_process(COMMAND git -C "${REPOSITORY}" rev-parse HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE failed ERROR_VARIABLE error)
if(failed OR NOT commit MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "build stamp: ${REPOSITORY} is not a git checkout: ${error}")
endif()
string(SUBSTRING "${commit}" 0 12 revision)
execute_process(COMMAND git -C "${REPOSITORY}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes
                RESULT_VARIABLE failed)
if(failed)
    message(FATAL_ERROR "build stamp: git status failed in ${REPOSITORY}")
endif()
if(NOT changes STREQUAL "")
    string(APPEND commit "+dirty")
endif()
set(text "#pragma once\n#define STORM_BUILD_COMMIT \"${commit}\"\n")
if(PLATFORM)
    string(APPEND text "#define STORM_BUILD_WATERMARK_STRING \"${PLATFORM}_${revision}\"\n")
endif()
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
