+	// Storm (bgfx-vulkan-traffic-counters.patch): what each render pass of a frame loads from memory, stores and
+	// resolves, why it ends, and with STORM_VK_PIPELINE_STATISTICS=1 the fragment shader invocations of its draws by
+	// class (include/bgfx/storm_vk_traffic.h). A frame is published once its queries have results. Render thread,
+	// except the published frame.
+	struct StormTraffic
+	{
+		static constexpr uint32_t kQueries = 4096; // statistics queries per frame in flight (one per run of a class)
+
+		struct Ops // a render pass as getRenderPass made it: its attachments, then its resolve attachments
+		{
+			uint8_t num;
+			uint8_t numResolve;
+			VkAttachmentDescription ad[BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS * 2];
+		};
+
+		struct Query
+		{
+			uint32_t frameNum;
+			uint16_t pass;
+			uint8_t  drawClass;
+		};
+
+		struct Frame
+		{
+			uint32_t frameNum;
+			uint32_t pending; // its queries without a result yet
+			bool     submitted;
+			std::vector<VkPassTraffic> passes;
+		};
+
+		std::unordered_map<::VkRenderPass, Ops> ops;
+		std::deque<Frame> frames; // not published yet, in submission order; the last one may be being recorded
+		bool statistics = false;
+		VkQueryPool pool[BGFX_CONFIG_MAX_FRAME_LATENCY] = {};
+		std::vector<Query> queries[BGFX_CONFIG_MAX_FRAME_LATENCY]; // what each query of a pool counts, in order
+		int32_t open = -1; // the class of the query open in the current pass
+		bool inPass = false;
+		std::mutex mutex;
+		std::vector<VkPassTraffic> published;
+		uint32_t publishedFrame = 0;
+	};
+
+	static StormTraffic s_stormTraffic;
+
+	// Bytes of one sample of an attachment in `_format`: the depth part, or with `_stencil` the stencil part, of a
+	// depth/stencil format; a colour format's own size.
+	static uint32_t stormSampleBytes(VkFormat _format, bool _stencil)
+	{
+		switch (_format)
+		{
+		case VK_FORMAT_D16_UNORM:           return _stencil ? 0 : 2;
+		case VK_FORMAT_X8_D24_UNORM_PACK32: return _stencil ? 0 : 4;
+		case VK_FORMAT_D32_SFLOAT:          return _stencil ? 0 : 4;
+		case VK_FORMAT_S8_UINT:             return _stencil ? 1 : 0;
+		case VK_FORMAT_D16_UNORM_S8_UINT:   return _stencil ? 1 : 2;
+		case VK_FORMAT_D24_UNORM_S8_UINT:   return _stencil ? 1 : 3;
+		case VK_FORMAT_D32_SFLOAT_S8_UINT:  return _stencil ? 1 : 4;
+		default: break;
+		}
+
+		if (_stencil)
+		{
+			return 0;
+		}
+
+		for (uint32_t ii = 0; ii < TextureFormat::Count; ++ii)
+		{
+			if (_format == s_textureFormat[ii].m_fmt
+			||  _format == s_textureFormat[ii].m_fmtSrgb)
+			{
+				return bimg::getBitsPerPixel(bimg::TextureFormat::Enum(ii) ) / 8;
+			}
+		}
+
+		BX_ASSERT(false, "Storm traffic: no size for VkFormat %d", _format);
+		return 0;
+	}
+
+	static bool stormIsDepth(VkFormat _format)
+	{
+		switch (_format)
+		{
+		case VK_FORMAT_D16_UNORM:
+		case VK_FORMAT_X8_D24_UNORM_PACK32:
+		case VK_FORMAT_D32_SFLOAT:
+		case VK_FORMAT_S8_UINT:
+		case VK_FORMAT_D16_UNORM_S8_UINT:
+		case VK_FORMAT_D24_UNORM_S8_UINT:
+		case VK_FORMAT_D32_SFLOAT_S8_UINT:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// STORM_VK_PIPELINE_STATISTICS=1 at init: the host measurements that count fragment shader invocations.
+	static bool stormStatisticsAsked()
+	{
+		const char* value = getenv("STORM_VK_PIPELINE_STATISTICS");
+		return NULL != value && 0 == bx::strCmp(value, "1");
+	}
+
+	static void stormPublishReady()
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		while (!st.frames.empty()
+		&&     st.frames.front().submitted
+		&&     0 == st.frames.front().pending)
+		{
+			std::lock_guard<std::mutex> lock(st.mutex);
+			st.published.swap(st.frames.front().passes);
+			st.publishedFrame = st.frames.front().frameNum;
+			st.frames.pop_front();
+		}
+	}
+
+	// A render pass begins: what its load ops read and what its store ops and resolve attachments will write.
+	static void stormPassBegin(VkPassKind::Enum _kind, const char* _name, uint32_t _frameBuffer, ::VkRenderPass _renderPass, uint32_t _width, uint32_t _height)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (st.frames.empty() )
+		{
+			return; // a pass outside a frame's submit (initialisation)
+		}
+
+		VkPassTraffic pass;
+		bx::memSet(&pass, 0, sizeof(pass) );
+		bx::strCopy(pass.name, sizeof(pass.name), _name);
+		pass.frameBuffer = _frameBuffer;
+		pass.width   = _width;
+		pass.height  = _height;
+		pass.kind    = uint8_t(_kind);
+		pass.end     = VkPassEnd::Own;
+		pass.views   = VkPassKind::Views == _kind ? 1 : 0;
+		pass.samples = 1;
+
+		for (uint32_t ii = 0; ii < VkDrawClass::Count; ++ii)
+		{
+			pass.invocations[ii] = st.statistics ? 0 : UINT64_MAX;
+		}
+
+		const auto it = st.ops.find(_renderPass);
+		BX_ASSERT(it != st.ops.end(), "Storm traffic: a render pass getRenderPass did not make");
+
+		if (it != st.ops.end() )
+		{
+			const StormTraffic::Ops& ops = it->second;
+			const uint64_t area = uint64_t(_width) * _height;
+
+			for (uint32_t ii = 0, num = ops.num + ops.numResolve; ii < num; ++ii)
+			{
+				const VkAttachmentDescription& ad = ops.ad[ii];
+				const uint64_t samples = uint64_t(ad.samples);
+				const bool depth = stormIsDepth(ad.format);
+				const uint64_t bytes   = area * samples * stormSampleBytes(ad.format, false);
+				const uint64_t stencil = area * samples * stormSampleBytes(ad.format, true);
+
+				if (ii >= ops.num)
+				{
+					pass.resolved[depth] += bytes + stencil; // a depth resolve writes depth and stencil (sample 0)
+					continue;
+				}
+
+				pass.samples = uint8_t(ad.samples);
+				pass.loaded[depth] += (VK_ATTACHMENT_LOAD_OP_LOAD   == ad.loadOp         ? bytes   : 0)
+				                    + (VK_ATTACHMENT_LOAD_OP_LOAD   == ad.stencilLoadOp  ? stencil : 0);
+				pass.stored[depth] += (VK_ATTACHMENT_STORE_OP_STORE == ad.storeOp        ? bytes   : 0)
+				                    + (VK_ATTACHMENT_STORE_OP_STORE == ad.stencilStoreOp ? stencil : 0);
+			}
+		}
+
+		st.frames.back().passes.push_back(pass);
+		st.inPass = true;
+		st.open   = -1;
+	}
+
+	// The open statistics query ends (before its render pass does).
+	static void stormEndQuery(VkCommandBuffer _commandBuffer, uint32_t _frameInFlight)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (0 <= st.open)
+		{
+			vkCmdEndQuery(_commandBuffer, st.pool[_frameInFlight], uint32_t(st.queries[_frameInFlight].size() - 1) );
+			st.open = -1;
+		}
+	}
+
+	static void stormPassEnd(VkCommandBuffer _commandBuffer, uint32_t _frameInFlight, VkPassEnd::Enum _end)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (!st.inPass)
+		{
+			return;
+		}
+
+		stormEndQuery(_commandBuffer, _frameInFlight);
+		st.frames.back().passes.back().end = uint8_t(_end);
+		st.inPass = false;
+	}
+
+	// A draw of the current pass, of `_state` with a fragment shader that can (`_discards`) discard.
+	static void stormDraw(VkCommandBuffer _commandBuffer, uint32_t _frameInFlight, uint64_t _state, bool _discards)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (!st.inPass)
+		{
+			return;
+		}
+
+		const VkDrawClass::Enum drawClass = 0 == (_state & (BGFX_STATE_WRITE_RGB | BGFX_STATE_WRITE_A) ) ? VkDrawClass::DepthOnly
+			: 0 != (_state & BGFX_STATE_BLEND_MASK)                                                     ? VkDrawClass::Blended
+			: _discards || 0 != (_state & BGFX_STATE_BLEND_ALPHA_TO_COVERAGE)                           ? VkDrawClass::Discards
+			:                                                                                             VkDrawClass::Opaque;
+		StormTraffic::Frame& frame = st.frames.back();
+		VkPassTraffic& pass = frame.passes.back();
+		++pass.draws[drawClass];
+
+		if (!st.statistics
+		||  st.open == int32_t(drawClass)
+		||  UINT64_MAX == pass.invocations[drawClass])
+		{
+			return;
+		}
+
+		stormEndQuery(_commandBuffer, _frameInFlight);
+		std::vector<StormTraffic::Query>& queries = st.queries[_frameInFlight];
+
+		if (queries.size() == StormTraffic::kQueries)
+		{
+			pass.invocations[drawClass] = UINT64_MAX; // more runs than queries: reported as not counted
+			return;
+		}
+
+		queries.push_back({ frame.frameNum, uint16_t(frame.passes.size() - 1), uint8_t(drawClass) });
+		++frame.pending;
+		vkCmdBeginQuery(_commandBuffer, st.pool[_frameInFlight], uint32_t(queries.size() - 1), 0);
+		st.open = int32_t(drawClass);
+	}
+
+	// A resolve pass reads what it resolves as a texture: added to the pass's loads.
+	static void stormSampledRead(uint64_t _bytes)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (st.inPass)
+		{
+			st.frames.back().passes.back().loaded[1] += _bytes;
+		}
+	}
+
+	// A vkCmdResolveImage reads every sample and writes the single-sample image.
+	static void stormResolveCopy(uint32_t _width, uint32_t _height, uint32_t _samples, uint32_t _bytes)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (st.frames.empty() )
+		{
+			return;
+		}
+
+		VkPassTraffic pass;
+		bx::memSet(&pass, 0, sizeof(pass) );
+		bx::strCopy(pass.name, sizeof(pass.name), "resolve copy");
+		pass.frameBuffer = UINT32_MAX;
+		pass.width       = _width;
+		pass.height      = _height;
+		pass.samples     = uint8_t(_samples);
+		pass.kind        = VkPassKind::ResolveCopy;
+		pass.end         = VkPassEnd::Own;
+		pass.loaded[0]   = uint64_t(_width) * _height * _samples * _bytes;
+		pass.resolved[0] = uint64_t(_width) * _height * _bytes;
+
+		for (uint32_t ii = 0; ii < VkDrawClass::Count; ++ii)
+		{
+			pass.invocations[ii] = st.statistics ? 0 : UINT64_MAX;
+		}
+
+		st.frames.back().passes.push_back(pass);
+	}
+
+	// A command buffer of `_frameInFlight` begins (its fence waited): the queries recorded in it last time have results.
+	static void stormCollect(VkDevice _device, VkCommandBuffer _commandBuffer, uint32_t _frameInFlight)
+	{
+		StormTraffic& st = s_stormTraffic;
+
+		if (!st.statistics)
+		{
+			return;
+		}
+
+		std::vector<StormTraffic::Query>& queries = st.queries[_frameInFlight];
+
+		if (!queries.empty() )
+		{
+			std::vector<uint64_t> results(queries.size(), 0);
+			const VkResult result = vkGetQueryPoolResults(_device, st.pool[_frameInFlight], 0, uint32_t(queries.size() )
+				, results.size() * sizeof(uint64_t), results.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+			BX_ASSERT(VK_SUCCESS == result, "Storm traffic: vkGetQueryPoolResults %d", result);
+
+			for (size_t ii = 0; ii < queries.size(); ++ii)
+			{
+				const StormTraffic::Query& query = queries[ii];
+
+				for (StormTraffic::Frame& frame : st.frames)
+				{
+					if (frame.frameNum == query.frameNum)
+					{
+						uint64_t& invocations = frame.passes[query.pass].invocations[query.drawClass];
+
+						if (UINT64_MAX != invocations)
+						{
+							invocations = VK_SUCCESS == result ? invocations + results[ii] : UINT64_MAX;
+						}
+
+						--frame.pending;
+						break;
+					}
+				}
+			}
+
+			queries.clear();
+		}
+
+		vkCmdResetQueryPool(_commandBuffer, st.pool[_frameInFlight], 0, StormTraffic::kQueries);
+		stormPublishReady();
+	}
+
