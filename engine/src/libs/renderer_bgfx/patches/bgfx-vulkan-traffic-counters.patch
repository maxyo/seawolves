Vulkan: what each render pass of a frame loads from memory, stores and resolves, why it ends, and the fragment shader
invocations of its draws, read through include/bgfx/storm_vk_traffic.h (bgfx::getVkPassTraffic).

On a tile GPU a render pass costs its attachments' traffic: a load op LOAD reads the attachment into tile memory, a store
op STORE writes it back, a resolve attachment writes the single-sample picture. bgfx decides these per pass from the
views' clear and discard flags and ends a pass at another frame buffer, another rect, a blit, a compute dispatch or the
per-view profiler; a multisampled depth that is sampled later is resolved by its render pass or, on a device without
VK_KHR_depth_stencil_resolve, by a pass of its own (bgfx's shader reads sample 0) whenever its frame buffer is left.
Nothing reported any of it, so a change that cut the scene's pass or stored its samples was invisible until a phone
ran slower.

- Each render pass gets a record: the name of the view that began it (Views), its render area and samples, the views it
  ran through, the bytes its load ops read, its store ops write and its resolve attachments write (colour and
  depth/stencil apart, from the ops getRenderPass gave the VkRenderPass and the formats' sample sizes), and why it
  ended. bgfx's depth resolve, the sRGB resolve pass and vkCmdResolveImage get records of their own (the sampled
  read counts as loaded).
- Draws count by class: depth only (no colour write), blended, alpha-tested (alpha to coverage, or a fragment shader
  with OpKill, OpTerminateInvocation or OpDemoteToHelperInvocation) and opaque. With STORM_VK_PIPELINE_STATISTICS=1 in the
  environment at init (host measurements: lavapipe or a desktop GPU; the device must have pipelineStatisticsQuery), a
  pipeline statistics query around each run of draws of one class counts their fragment shader invocations; the
  results are read when the frame's command buffer is reused, and the frame is published then. A pass with more runs
  than the queries of a frame reports that class as not counted (UINT64_MAX).
- getVkPassTraffic copies the last published frame under a mutex; everything else runs on the render thread.

The counters are read by the renderer's "render passes:" line (detailed diagnostics) and by
tests/renderer_bgfx/scene_passes_check.cpp.
diff --git a/include/bgfx/storm_vk_traffic.h b/include/bgfx/storm_vk_traffic.h
new file mode 100644
index 0000000..844073b
--- /dev/null
+++ b/include/bgfx/storm_vk_traffic.h
@@ -0,0 +1,78 @@
+/*
+ * Storm Engine patch (renderer_bgfx/patches/bgfx-vulkan-traffic-counters.patch): the render passes the Vulkan backend
+ * ran in a frame, what each loaded from memory, stored and resolved, why it ended, and with
+ * STORM_VK_PIPELINE_STATISTICS=1 in the environment at bgfx::init the fragment shader invocations of its draws.
+ */
+#ifndef BGFX_STORM_VK_TRAFFIC_H_HEADER_GUARD
+#define BGFX_STORM_VK_TRAFFIC_H_HEADER_GUARD
+
+#include <stdint.h>
+
+namespace bgfx
+{
+	struct VkPassKind
+	{
+		enum Enum : uint8_t
+		{
+			Views,        // views of the frame (name: the view that began it)
+			DepthResolve, // a multisampled depth resolved by bgfx's shader (sample 0) when its frame buffer is left
+			ResolveCopy,  // a multisampled colour resolved by vkCmdResolveImage after its pass
+			FormatResolve,// a multisampled colour resolved by a pass of its own into another format (sRGB)
+
+			Count
+		};
+	};
+
+	struct VkPassEnd
+	{
+		enum Enum : uint8_t
+		{
+			Target,   // the next view draws into another frame buffer
+			Rect,     // the next view has another rect
+			Blit,     // the next view starts with a blit
+			Compute,  // a compute dispatch
+			Profiler, // the per-view timer queries (BGFX_DEBUG_PROFILER) end the pass at every view
+			FrameEnd, // the last pass of the frame
+			Own,      // a resolve pass: ends where it begins
+
+			Count
+		};
+	};
+
+	struct VkDrawClass
+	{
+		enum Enum : uint8_t
+		{
+			Opaque,   // no blending, a fragment shader without discard, no alpha to coverage
+			Discards, // no blending, a fragment shader that can discard or alpha to coverage: alpha-tested
+			Blended,
+			DepthOnly, // no colour write (a depth pre-pass, a shadow map)
+			Count
+		};
+	};
+
+	struct VkPassTraffic
+	{
+		char     name[64];      // Views: the bgfx name of the view that began it
+		uint32_t frameBuffer;   // the frame buffer's handle index; UINT32_MAX: a swap chain's or a resolve's own
+		uint32_t width;         // render area
+		uint32_t height;
+		uint8_t  samples;
+		uint8_t  kind;          // VkPassKind
+		uint8_t  end;           // VkPassEnd
+		uint16_t views;         // views it ran through
+		uint64_t loaded[2];     // bytes read into the pass (load op LOAD; a resolve's sampled read): [0] colour, [1] depth/stencil
+		uint64_t stored[2];     // bytes written at its end (store op STORE)
+		uint64_t resolved[2];   // single-sample bytes written by a resolve (resolve attachments, resolve copies)
+		uint32_t draws[VkDrawClass::Count];
+		uint64_t invocations[VkDrawClass::Count]; // fragment shader invocations; UINT64_MAX: not counted
+	};
+
+	/// The render passes of the last frame whose results are complete, in submission order: at most `_max` are copied
+	/// to `_out`; returns how many there were. `_frame` receives the frame number bgfx::frame() returned for it
+	/// (0: none yet). Any thread.
+	uint32_t getVkPassTraffic(VkPassTraffic* _out, uint32_t _max, uint32_t* _frame);
+
+} // namespace bgfx
+
+#endif // BGFX_STORM_VK_TRAFFIC_H_HEADER_GUARD
