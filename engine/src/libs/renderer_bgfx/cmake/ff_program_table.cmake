# storm_ff_program_table(<variants var> <plain twins var> <header> <setups include>)
# Reads shaders/ff_programs.cmake. Sets <variants var> to the lit and baked programs and the specialised ones as
# VARIANTS entries of storm_bgfx_embed_shaders ("name|source|defines") and <plain twins var> to the plain entries that
# get an opaque twin, and writes <header>, the same programs and the setups as C++ (ff_programs.hpp.in), and
# <setups include>, the setups' constants for the shaders (ff_stages.sh FF_SETUP), with ff_specialised.txt beside it,
# a line per specialised program: its name and a general program of its entry (tests/renderer_bgfx/
# specialised_spirv_check.py).
function(storm_ff_program_table variants_var plain_twins_var header setups_include)
    set(table "${CMAKE_CURRENT_SOURCE_DIR}/shaders/ff_programs.cmake")
    include("${table}")
    set(shaders "${CMAKE_CURRENT_SOURCE_DIR}/shaders")

    set(FF_BLOCK_FIELDS "")
    foreach(block ${ff_blocks})
        string(TOLOWER "${block}" field)
        string(APPEND FF_BLOCK_FIELDS "    bool ${field} = false;\n")
    endforeach()

    foreach(axis specular relief shadow)
        string(TOUPPER "${axis}" upper)
        list(LENGTH ff_axis_${axis} FF_${upper}_COUNT)
    endforeach()

    set(FF_FAMILY_ENUM "")
    set(FF_FAMILY_ROWS "")
    set(FF_PROGRAM_ROWS "")
    set(variants)
    set(families)
    foreach(family ${ff_families})
        list(APPEND families "${family}|false")
    endforeach()
    foreach(family ${ff_room_families})
        list(APPEND families "${family}|true")
    endforeach()
    foreach(family ${families})
        string(REPLACE "|" ";" fields "${family}")
        list(GET fields 0 family_name)
        list(GET fields 1 entry)
        list(GET fields 2 family_blocks)
        list(GET fields 3 room)
        string(REPLACE "," ";" family_blocks "${family_blocks}")
        set(pbr false)
        if(entry STREQUAL "lit")
            set(lit true)
        elseif(entry STREQUAL "baked")
            set(lit false)
        elseif(entry STREQUAL "pbr")
            set(lit true)
            set(pbr true)
        else()
            message(FATAL_ERROR "${table}: family ${family_name} has entry '${entry}', not lit, baked or pbr")
        endif()
        # lit_lamps -> LitLamps
        string(REPLACE "_" ";" words "${family_name}")
        set(enumerator "")
        foreach(word ${words})
            string(SUBSTRING "${word}" 0 1 first)
            string(SUBSTRING "${word}" 1 -1 rest)
            string(TOUPPER "${first}" first)
            string(APPEND enumerator "${first}${rest}")
        endforeach()
        string(APPEND FF_FAMILY_ENUM "    ${enumerator},\n")
        set(defines)
        if(pbr)
            list(APPEND defines FX_FF_PBR)
        endif()
        set(initialisers)
        foreach(block ${ff_blocks})
            string(TOLOWER "${block}" field)
            if(block IN_LIST family_blocks)
                list(APPEND defines FX_FF_${block})
                list(APPEND initialisers ".${field} = true")
            else()
                list(APPEND initialisers ".${field} = false")
            endif()
            list(REMOVE_ITEM family_blocks ${block})
        endforeach()
        if(family_blocks)
            message(FATAL_ERROR "${table}: family ${family_name} names unknown blocks ${family_blocks}")
        endif()
        list(JOIN initialisers ", " initialisers)
        string(APPEND FF_FAMILY_ROWS "    {${lit}, ${pbr}, ${room}, {${initialisers}}}, // ${family_name}\n")
        set(family_${family_name}_entry "${entry}")
        set(family_${family_name}_defines ${defines})
        set(family_${family_name}_enumerator "${enumerator}")
        if(room)
            continue()
        endif()

        foreach(axis specular relief shadow)
            if(DEFINED ff_axis_${axis}_${entry})
                set(values_${axis} ${ff_axis_${axis}_${entry}})
                foreach(value ${values_${axis}})
                    if(NOT value IN_LIST ff_axis_${axis})
                        message(FATAL_ERROR "${table}: ff_axis_${axis}_${entry} has '${value}', not a value of the axis")
                    endif()
                endforeach()
            else()
                set(values_${axis} ${ff_axis_${axis}})
            endif()
        endforeach()
        # The indices are the axes' own: an entry's program is where the C++ table looks for that value.
        set(specular_index 0)
        foreach(specular ${ff_axis_specular})
            set(relief_index 0)
            foreach(relief ${ff_axis_relief})
                set(shadow_index 0)
                foreach(shadow ${ff_axis_shadow})
                    if(NOT specular IN_LIST values_specular OR NOT relief IN_LIST values_relief OR
                       NOT shadow IN_LIST values_shadow)
                        math(EXPR shadow_index "${shadow_index} + 1")
                        continue()
                    endif()
                    set(program_defines ${defines})
                    set(suffix "")
                    foreach(value "${specular}" "${relief}" "${shadow}")
                        string(REPLACE "|" ";" value_fields "${value}|")
                        list(GET value_fields 0 letters)
                        list(GET value_fields 1 value_defines)
                        string(APPEND suffix "${letters}")
                        if(NOT value_defines STREQUAL "")
                            string(REPLACE "," ";" value_defines "${value_defines}")
                            list(APPEND program_defines ${value_defines})
                        endif()
                    endforeach()
                    set(name "fs_ff_${family_name}")
                    if(NOT suffix STREQUAL "")
                        string(APPEND name "_${suffix}")
                    endif()
                    list(JOIN program_defines "," program_defines)
                    list(APPEND variants "${name}|${shaders}/fs_ff_${entry}.sc|${program_defines}")
                    string(APPEND FF_PROGRAM_ROWS "    {{FfFamily::${enumerator}, ${specular_index}, ${relief_index}, "
                        "${shadow_index}}, \"${name}\"},\n")
                    math(EXPR shadow_index "${shadow_index} + 1")
                endforeach()
                math(EXPR relief_index "${relief_index} + 1")
            endforeach()
            math(EXPR specular_index "${specular_index} + 1")
        endforeach()
    endforeach()
    list(LENGTH families FF_FAMILY_COUNT)
    list(LENGTH variants FF_PROGRAM_COUNT)

    # The setups: C++ rows and the shaders' constants, the arguments also decoded (ffArgSel).
    set(FF_SETUP_ROWS "")
    set(setups_sh "// Generated by renderer_bgfx/cmake/ff_program_table.cmake from shaders/ff_programs.cmake.\n")
    set(setup_ids)
    set(setup_codes)
    set(stage_fields colour_op colour_arg1 colour_arg2 colour_arg0 alpha_op alpha_arg1 alpha_arg2 alpha_arg0 temp
        projected bound)
    foreach(setup ${ff_setups})
        string(REPLACE "|" ";" stages "${setup}")
        list(POP_FRONT stages id)
        if(NOT id MATCHES "^[1-9][0-9]*$" OR id IN_LIST setup_ids)
            message(FATAL_ERROR "${table}: setup id '${id}' is not a new positive number")
        endif()
        list(APPEND setup_ids ${id})
        # FindSetup takes the first setup whose codes a draw's are: a second one with the same codes is never taken.
        string(REPLACE ";" "|" codes_key "${stages}")
        if(codes_key IN_LIST setup_codes)
            message(FATAL_ERROR "${table}: setup ${id} has the codes of an earlier setup")
        endif()
        list(APPEND setup_codes "${codes_key}")
        # More stages than the shim has (shim::kFfStages) fail to compile in the C++ row.
        list(LENGTH stages count)
        if(count LESS 1)
            message(FATAL_ERROR "${table}: setup ${id} has no stage")
        endif()
        string(APPEND setups_sh "#if FF_SETUP == ${id}\n#define FF_SETUP_STAGES ${count}\n")
        set(cxx_stages "")
        # The town ratio's lightmap can be at one of the setup's stages (ff_stages.sh FF_RATIO_COORDS).
        set(ratio_coords "")
        set(ratio_map "")
        math(EXPR last "${count} - 1")
        foreach(stage RANGE ${last})
            if(stage LESS last)
                string(APPEND ratio_coords "k < ${stage}.5 ? v_texcoord${stage} : ")
                string(APPEND ratio_map "k < ${stage}.5 ? FF_STAGE_MAP(${stage}) : ")
            else()
                string(APPEND ratio_coords "v_texcoord${stage}")
                string(APPEND ratio_map "FF_STAGE_MAP(${stage})")
            endif()
        endforeach()
        string(APPEND setups_sh "#define FF_RATIO_COORDS(k, ttc, tms) vec4 ttc = ${ratio_coords}; vec4 tms = ${ratio_map};\n")
        foreach(stage RANGE ${last})
            list(GET stages ${stage} codes)
            string(REPLACE "," ";" codes "${codes}")
            list(LENGTH codes code_count)
            if(NOT code_count EQUAL 11)
                message(FATAL_ERROR "${table}: setup ${id} stage ${stage} has ${code_count} codes, not 11")
            endif()
            list(GET codes 0 colour_op)
            list(GET codes 4 alpha_op)
            list(GET codes 8 temp)
            list(GET codes 9 projected)
            list(GET codes 10 bound)
            if(colour_op LESS 2 OR alpha_op LESS 1)
                message(FATAL_ERROR "${table}: setup ${id} stage ${stage} is disabled")
            endif()
            set(i 0)
            set(cxx_codes "")
            foreach(code ${codes})
                list(GET stage_fields ${i} field)
                if(NOT code MATCHES "^[0-9]+$" OR (i GREATER_EQUAL 8 AND code GREATER 1) OR code GREATER 63 OR
                   ((i EQUAL 0 OR i EQUAL 4) AND code GREATER 26))
                    message(FATAL_ERROR "${table}: setup ${id} stage ${stage}: ${field} ${code} is out of range")
                endif()
                if(i GREATER_EQUAL 8)
                    if(code)
                        string(APPEND cxx_codes ".${field} = true, ")
                    else()
                        string(APPEND cxx_codes ".${field} = false, ")
                    endif()
                else()
                    string(APPEND cxx_codes ".${field} = ${code}, ")
                endif()
                math(EXPR i "${i} + 1")
            endforeach()
            string(REGEX REPLACE ", $" "" cxx_codes "${cxx_codes}")
            string(APPEND cxx_stages "{${cxx_codes}}, ")
            list(SUBLIST codes 0 4 colour)
            list(SUBLIST codes 4 4 alpha)
            list(JOIN colour ".0, " colour)
            list(JOIN alpha ".0, " alpha)
            string(APPEND setups_sh "#define FF_S${stage}_COLOUR vec4(${colour}.0)\n#define FF_S${stage}_ALPHA vec4(${alpha}.0)\n")
            # The arguments by their place in the stage's codes.
            foreach(arg C1:1 C2:2 C0:3 A1:5 A2:6 A0:7)
                string(REPLACE ":" ";" arg "${arg}")
                list(GET arg 1 at)
                list(GET arg 0 arg)
                list(GET codes ${at} code)
                math(EXPR selector "${code} % 16")
                math(EXPR complement "(${code} / 16) % 2")
                math(EXPR replicate "${code} / 32")
                string(APPEND setups_sh "#define FF_S${stage}_${arg} ${selector}.0, ${complement}.0, ${replicate}.0\n")
            endforeach()
            if(bound)
                set(bound true)
            else()
                set(bound false)
            endif()
            string(APPEND setups_sh "#define FF_S${stage}_TEMP ${temp}.0\n#define FF_S${stage}_PROJECTED ${projected}.0\n"
                "#define FF_S${stage}_BOUND ${bound}\n")
        endforeach()
        string(APPEND setups_sh "#endif\n")
        string(REGEX REPLACE ", $" "" cxx_stages "${cxx_stages}")
        string(APPEND FF_SETUP_ROWS "    {${id}, ${count}, {{${cxx_stages}}}},\n")
    endforeach()
    string(APPEND setups_sh "#ifndef FF_SETUP_STAGES\n#error FF_SETUP names no setup of shaders/ff_programs.cmake\n#endif\n")
    file(CONFIGURE OUTPUT "${setups_include}" CONTENT "${setups_sh}" @ONLY)
    list(LENGTH ff_setups FF_SETUP_COUNT)

    # The specialised programs: the general program's entry and defines with FF_SETUP.
    set(FF_SPECIALISED_ROWS "")
    set(specialised_names "")
    set(specialised_seen)
    foreach(row ${ff_specialised})
        # FindSpecialised takes the first equal row: a repeated one would compile a program no draw takes.
        if(row IN_LIST specialised_seen)
            message(FATAL_ERROR "${table}: specialised program ${row} is listed twice")
        endif()
        list(APPEND specialised_seen "${row}")
        string(REPLACE "|" ";" fields "${row}|")
        list(GET fields 0 target)
        list(GET fields 1 letters)
        list(GET fields 2 id)
        if(NOT id IN_LIST setup_ids)
            message(FATAL_ERROR "${table}: specialised program ${target}|${letters}|${id} names no setup ${id}")
        endif()
        set(axes "")
        set(axis_defines)
        set(specular_index 0)
        foreach(specular ${ff_axis_specular})
            set(relief_index 0)
            foreach(relief ${ff_axis_relief})
                set(shadow_index 0)
                foreach(shadow ${ff_axis_shadow})
                    set(suffix "")
                    set(value_defines_all)
                    foreach(value "${specular}" "${relief}" "${shadow}")
                        string(REPLACE "|" ";" value_fields "${value}|")
                        list(GET value_fields 0 value_letters)
                        list(GET value_fields 1 value_defines)
                        string(APPEND suffix "${value_letters}")
                        if(NOT value_defines STREQUAL "")
                            string(REPLACE "," ";" value_defines "${value_defines}")
                            list(APPEND value_defines_all ${value_defines})
                        endif()
                    endforeach()
                    if(suffix STREQUAL letters)
                        set(axes "${specular_index}, ${relief_index}, ${shadow_index}")
                        set(axis_defines ${value_defines_all})
                    endif()
                    math(EXPR shadow_index "${shadow_index} + 1")
                endforeach()
                math(EXPR relief_index "${relief_index} + 1")
            endforeach()
            math(EXPR specular_index "${specular_index} + 1")
        endforeach()
        if(axes STREQUAL "")
            message(FATAL_ERROR "${table}: specialised program ${target}|${letters}|${id}: no axes are '${letters}'")
        endif()
        if(target STREQUAL "plain" OR target STREQUAL "ground")
            if(NOT letters STREQUAL "")
                message(FATAL_ERROR "${table}: the ${target} specialised program ${letters}|${id} has axis letters")
            endif()
            if(target STREQUAL "plain")
                set(name "fs_ff")
                set(entry Plain)
            else()
                set(name "fs_ff_dyn")
                set(entry Ground)
            endif()
            set(source "${shaders}/${name}.sc")
            set(program_defines)
            string(APPEND FF_SPECIALISED_ROWS "    {{FfEntry::${entry}, FfFamily{}, ${axes}, ${id}}, ")
        elseif(DEFINED family_${target}_entry)
            set(name "fs_ff_${target}")
            if(NOT letters STREQUAL "")
                string(APPEND name "_${letters}")
            endif()
            set(source "${shaders}/fs_ff_${family_${target}_entry}.sc")
            set(program_defines ${family_${target}_defines} ${axis_defines})
            string(APPEND FF_SPECIALISED_ROWS
                "    {{FfEntry::Family, FfFamily::${family_${target}_enumerator}, ${axes}, ${id}}, ")
        else()
            message(FATAL_ERROR "${table}: specialised program ${target}|${letters}|${id}: '${target}' is neither plain, "
                "ground nor a family")
        endif()
        string(APPEND name "_u${id}")
        # A general program of the same entry: the one whose vertex shaders this one pairs with (its inputs).
        set(general "")
        foreach(variant fs_ff|${shaders}/fs_ff.sc| fs_ff_dyn|${shaders}/fs_ff_dyn.sc| ${variants})
            string(REPLACE "|" ";" variant_fields "${variant}")
            list(GET variant_fields 1 variant_source)
            if(general STREQUAL "" AND variant_source STREQUAL source)
                list(GET variant_fields 0 general)
            endif()
        endforeach()
        list(APPEND program_defines "FF_SETUP=${id}")
        list(JOIN program_defines "," program_defines)
        list(APPEND variants "${name}|${source}|${program_defines}")
        string(APPEND FF_SPECIALISED_ROWS "\"${name}\"},\n")
        string(APPEND specialised_names "${name} ${general}\n")
    endforeach()
    get_filename_component(setups_dir "${setups_include}" DIRECTORY)
    file(CONFIGURE OUTPUT "${setups_dir}/ff_specialised.txt" CONTENT "${specialised_names}" @ONLY)
    list(LENGTH ff_specialised FF_SPECIALISED_COUNT)

    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ff_programs.hpp.in" "${header}" @ONLY)
    set(${variants_var} ${variants} PARENT_SCOPE)
    set(${plain_twins_var} ${ff_plain_twins} PARENT_SCOPE)
endfunction()
