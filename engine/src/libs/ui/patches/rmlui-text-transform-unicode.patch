+// Unicode simple case mapping of ASCII, the Latin-1 Supplement, Latin Extended-A and the Cyrillic letters
+// U+0400-U+045F (the letters of the interface's languages); other characters are kept. Upstream maps ASCII only, so
+// `text-transform` left Cyrillic and accented text as written.
+static Character LowerCharacter(Character character)
+{
+	const char32_t c = char32_t(character);
+	if (c >= 'A' && c <= 'Z')
+		return Character(c + 0x20);
+	if (c >= 0xC0 && c <= 0xDE && c != 0xD7) // without the multiplication sign
+		return Character(c + 0x20);
+	if (c == 0x130) // dotted capital I
+		return Character('i');
+	if (c == 0x178) // capital Y with diaeresis
+		return Character(0xFF);
+	if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177)) // pairs with the capital even
+		return Character(c | 1);
+	if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) // pairs with the capital odd
+		return Character(c + (c & 1));
+	if (c >= 0x400 && c <= 0x40F)
+		return Character(c + 0x50);
+	if (c >= 0x410 && c <= 0x42F)
+		return Character(c + 0x20);
+	return character;
+}
+
+static Character UpperCharacter(Character character)
+{
+	const char32_t c = char32_t(character);
+	if (c >= 'a' && c <= 'z')
+		return Character(c - 0x20);
+	if (c >= 0xE0 && c <= 0xFE && c != 0xF7) // without the division sign
+		return Character(c - 0x20);
+	if (c == 0xFF)
+		return Character(0x178);
+	if (c == 0x131) // dotless i
+		return Character('I');
+	if (c == 0x17F) // long s
+		return Character('S');
+	if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177))
+		return Character(c & ~char32_t(1));
+	if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E))
+		return Character(c - ((c & 1) ^ 1));
+	if (c >= 0x430 && c <= 0x44F)
+		return Character(c - 0x20);
+	if (c >= 0x450 && c <= 0x45F)
+		return Character(c - 0x50);
+	return character;
+}
+
+// Every mapped character is below U+0800 (one or two bytes); longer sequences and malformed bytes are kept as they are.
+static String MapCase(const String& string, Character (*map)(Character))
+{
+	String out;
+	out.reserve(string.size());
+	size_t i = 0;
+	while (i < string.size())
+	{
+		const unsigned char lead = (unsigned char)string[i];
+		if (lead < 0x80)
+		{
+			out += char(map(Character(lead)));
+			++i;
+			continue;
+		}
+		if ((lead & 0xE0) == 0xC0 && i + 1 < string.size() && ((unsigned char)string[i + 1] & 0xC0) == 0x80)
+		{
+			const char32_t code = char32_t(map(Character(((lead & 0x1Fu) << 6) | ((unsigned char)string[i + 1] & 0x3Fu))));
+			if (code < 0x80)
+				out += char(code);
+			else
+			{
+				out += char(0xC0 | (code >> 6));
+				out += char(0x80 | (code & 0x3F));
+			}
+			i += 2;
+			continue;
+		}
+		out += string[i];
+		++i;
+	}
+	return out;
+}
