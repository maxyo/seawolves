body { display: block; width: 100%; height: 100%; }
div { display: block; }
s-hud, c-box, c-panels, c-button, c-stick, c-fleet, c-minimap, c-lever, c-helm, s-hud-orders, t-sheet { display: block; }
s-hud-orders { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
/* boxes only show: a touch on one belongs to what lies under it */
c-box { pointer-events: none; }

/* The runtime's scroll-edge fade, as the real pack styles it (base.rcss). */
.scroll-fade { position: absolute; left: 0; right: 0; height: 26dp; pointer-events: none; z-index: 3; background-color: #00000080; display: none; }
.scroll-below > .scroll-fade { display: block; }

/* Panels with a shadow each (panels.rml). */
.panel { position: absolute; top: 40dp; background-color: #4a3020; border-radius: 6dp; shadow: #000000c0 0dp 4dp 12dp 0dp; }
/* A filtered element's outer shadow is not cut to its box (filtered.rml): grey on grey, the filter changes nothing. */
.grey-panel { position: absolute; top: 20dp; width: 60dp; height: 40dp; background-color: #606060; shadow: #000000ff 0dp 12dp 8dp 0dp; }
