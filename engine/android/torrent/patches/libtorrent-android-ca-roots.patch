diff --git a/src/session_impl.cpp b/src/session_impl.cpp
--- a/src/session_impl.cpp
+++ b/src/session_impl.cpp
@@ -1,3 +1,6 @@
+#ifdef __ANDROID__
+#include <dirent.h>
+#endif
 /*
 
 Copyright (c) 2003, Magnus Jonsson
@@ -607,6 +610,22 @@ bool ssl_server_name_callback(ssl::stream_handle_type stream_handle, std::string
 #if TORRENT_USE_SSL
 		error_code ec;
 		m_ssl_ctx.set_default_verify_paths(ec);
+#ifdef __ANDROID__
+        // Storm Android platform trust roots
+        for (auto root : {"/apex/com.android.conscrypt/cacerts", "/system/etc/security/cacerts"}) {
+            DIR* directory = opendir(root);
+            if (!directory) continue;
+            bool loaded = false;
+            while (auto* file = readdir(directory)) {
+                if (file->d_name[0] == '.') continue;
+                m_ssl_ctx.load_verify_file(std::string(root) + "/" + file->d_name, ec);
+                if (!ec) loaded = true;
+            }
+            closedir(directory);
+            // An updated Conscrypt root set replaces the legacy system set.
+            if (loaded) break;
+        }
+#endif
 #ifndef TORRENT_DISABLE_LOGGING
 		if (ec) session_log("SSL set_default verify_paths failed: %s", ec.message().c_str());
 		ec.clear();
