#!/usr/bin/env bash
# Compiler launcher of the native builds: CMAKE_<LANG>_COMPILER_LAUNCHER, or the prefix of
# CC/CXX for make-based builds (CC="<repo>/tools/ccache/launcher clang"). Runs the compiler
# through ccache with the project's settings (README.md here), each one only unless already
# set. Setting CCACHE_DIR also makes ccache read $CCACHE_DIR/ccache.conf, so the project's
# cache and settings stay apart from the user's default ccache configuration.
# Without ccache installed the compiler runs directly: the build is the same, only rebuilds
# are slower. Configuring a CMake project says so once (cmake/StormBuildCache.cmake).
if ! command -v ccache >/dev/null 2>&1; then
  exec "$@"
fi
here=${BASH_SOURCE[0]%/*}
[[ $here == /* ]] || here=$PWD/$here
engine=${here%/tools/ccache}
# The engine is <repository>/engine (next to app/); paths are hashed relative to the directory
# holding the repository, so other checkouts next to it share the cache.
repository=${engine%/*}
workspace=${repository%/*}
export CCACHE_DIR=${CCACHE_DIR:-$HOME/.cache/ccache-storm}
export CCACHE_BASEDIR=${CCACHE_BASEDIR:-$workspace}
export CCACHE_NOHASHDIR=${CCACHE_NOHASHDIR:-1}
export CCACHE_COMPILERCHECK=${CCACHE_COMPILERCHECK:-content}
export CCACHE_SLOPPINESS=${CCACHE_SLOPPINESS:-include_file_ctime,include_file_mtime,time_macros,locale}
# A size set in the cache's own ccache.conf (ccache --max-size) is the machine's choice and stays.
if [[ -z ${CCACHE_MAXSIZE-} ]] && ! grep -qs '^max_size' "$CCACHE_DIR/ccache.conf"; then
  export CCACHE_MAXSIZE=30G
fi
export CCACHE_COMPRESS=${CCACHE_COMPRESS:-1}
exec ccache "$@"
